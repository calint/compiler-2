# truncate a qword to byte word and dword

func assert(x : bool) if not x exit(1)

func take_byte(value : i8) : i8 result {
    result = value
}

func take_word(value : i16) : i16 result {
    result = value
}

func take_dword(value : i32) : i32 result {
    result = value
}

func main() {
    var qword : i64 = 0x12345678
    qword = qword << 32
    var lower : i64 = 0x9abc
    lower = lower << 16
    lower = lower | 0xdef0
    qword = qword | lower
    var byte : i8 = take_byte(qword)
    var word : i16 = take_word(qword)
    var dword : i32 = take_dword(qword)

    assert(byte == 0xf0)
    assert(word == 0xdef0)
    assert(dword == 0x9abcdef0)
}
