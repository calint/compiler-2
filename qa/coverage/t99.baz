func assert(expr : bool) {
    if not expr exit(1)
}

func print(len, ptr) {
    write(1, ptr, len)
}

func input(len, ptr) : nbytes {
    nbytes = read(0, ptr, len)
}

dat ok : i8[] = "ok\n"

func main() {
    var word1 : i8[64]
    var word2 : i8[64]

    print(array_size_of(ok), address_of(ok))

    # expect same word input for both
    var len1 = input(array_size_of(word1), address_of(word1))
    print(len1, address_of(word1))

    print(array_size_of(ok), address_of(ok))

    var len2 = input(array_size_of(word2), address_of(word2))
    print(len2, address_of(word2))
  
    assert(arrays_equal(word1, word2, len1))

    print(array_size_of(ok), address_of(ok))

    # expect not same word input for both
    len1 = input(array_size_of(word1), address_of(word1))
    print(len1, address_of(word1))

    print(array_size_of(ok), address_of(ok))
 
    len2 = input(array_size_of(word2), address_of(word2))
    print(len2, address_of(word2))
 
    assert(not arrays_equal(word1, word2, len1))

    print(array_size_of(ok), address_of(ok))
}
