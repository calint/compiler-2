# canonical boolean results assigned to a memory variable
# inspect from the project root: ./baz qa/coverage/t495.baz --target=x86_64 > gen.s
# use --target=rv32i for the other backend; omit checks to isolate result emission
# inspect the initialization and reassignment of b, separately from assert(b)
# x86: sete byte [b] for equality, setne byte [b] for negated equality
# rv32i: produce the final 0/1 value and sb it directly
# neither assignment needs a second normalization or an xor for negation

func assert(ok : bool) if not ok exit(1)

func main() {
    var left : i8[2] = {1, 2}
    var right : i8[2] = {1, 2}
    var b : bool = arrays_equal(left, right, 2)
    assert(b)
    right[1] = 3
    b = not arrays_equal(left, right, 2)
    assert(b)
}