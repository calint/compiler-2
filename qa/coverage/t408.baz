# global variable shadowing in a nested block

func exit(v : reg_rdi) {
    mov(rax, 60)
    mov(rdi, v)
    syscall()
}

func assert(x : bool) if not x exit(1)

var value = 1

func main() {
    assert(value == 1)
    value = 3
    assert(value == 3)
    {
        var value = 2
        assert(value == 2)
    }
    assert(value == 3)
}
