# foo loop variable passed to a mutating function

dat values[] = {1, 2, 3}

func increment(value) {
    value = value + 10
}

func assert(x bool) { if not x exit(1) }

func main() {
    foo values {
        increment(e)
    }
    assert(values[0] == 11)
    assert(values[1] == 12)
    assert(values[2] == 13)
}
