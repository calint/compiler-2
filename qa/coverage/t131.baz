# indexed values participate in multiplication

func assert(expr : bool) { if not expr exit(1) }

func fiz(x : i32, mul : i32) : res i32 {
    res = x * x * mul
}

func main() {
    var arr : i32[4]
    var ix = 1
    arr[ix] = 2
    arr[3] = 3
    var c : i32 = fiz(arr[ix], arr[3])
    assert(c == 12)
}
