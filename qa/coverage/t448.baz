# lea regression: user-type indexed args (non-encodable element size path)

func assert(err, expr : bool) { if not expr exit(err) }

type pair {
    x,
    y
}

func bump(dst : pair, src : pair, i) {
    i = i + 1
    dst = {src.x + i, src.y + i}
    src = {src.x + 100, src.y + 200}
}

func main() {
    var srcs : pair[2]
    var dsts : pair[2]

    srcs[0] = {1, 2}
    srcs[1] = {10, 20}

    var dst_index = 0
    var src_index = 1

    bump(dsts[dst_index], srcs[src_index], dst_index)

    assert(1, dst_index == 1)
    assert(2, dsts[0].x == 11)
    assert(3, dsts[0].y == 21)
    assert(4, srcs[1].x == 110)
    assert(5, srcs[1].y == 220)
}
