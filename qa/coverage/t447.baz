# lea regression: built-in indexed src/dst aliases and index mutation

func assert(err, expr : bool) if not expr exit(err)

func mix(dst, src, ix) {
    ix = ix + 1
    dst = src + ix
    src = src + 10
}

func main() {
    var srcs : [4] = {5, 6, 7, 8}
    var dsts : [4] = {0, 0, 0, 0}

    var dst_index = 1
    var src_index = 2

    mix(dsts[dst_index], srcs[src_index], dst_index)

    assert(1, dst_index == 2)
    assert(2, dsts[1] == 9)
    assert(3, srcs[2] == 17)
    assert(4, dsts[0] == 0)
    assert(5, dsts[2] == 0)
}
