func exit(v : reg_rdi) {
    mov(rax, 60)  # exit system call
    mov(rdi, v)   # return code
    syscall()
}

func assert(expr : bool) if not expr exit(1)

type point {x, y}

func point_init() : point res {
    res.x = -1
    res.y = -2
}

func main() {
    var pt : point
    pt = point_init()
    assert(pt.x == -1)
    assert(pt.y == -2)

    var pt1 : point = point_init()
    assert(pt1.x == -1)
    assert(pt1.y == -2)
}
