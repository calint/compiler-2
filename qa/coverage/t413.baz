# foo over a holder with an array of user types

type point { x, y }
type holder { points : point[2] }

dat holders : holder[2] = 
    { 
        { 
            { {1, 2}, {3, 4} }
        }, 
        { 
            { {5, 6}, {7, 8} } 
        } 
    }

func assert(x : bool) if not x exit(1)

func main() {
    foo holders {
        e.points[1].y = e.points[1].y + 10
    }
    assert(holders[0].points[1].x == 3)
    assert(holders[0].points[1].y == 14)
    assert(holders[1].points[1].x == 7)
    assert(holders[1].points[1].y == 18)
}
