func exit(v : reg_rdi) {
    mov(rax, 60)  # exit system call
    mov(rdi, v)   # return code
    syscall()
}

func assert(expr : bool) if not expr exit(1)

type string { len : i8, data : i8[127] }

type room { name : string, description : string, note : string }

type world { rooms : room[128] }

func bar(i : i8) {
    i = 1
}

func foo(str : i8[]) {
    bar(str[5])
}

func fuz(rm : room) {
    rm.name.len = 2
    foo(rm.name.data)
}

func main() {
    var wld : world
    fuz(wld.rooms[2])

    assert(wld.rooms[2].name.len == 2)
    assert(wld.rooms[2].name.data[5] == 1)
}
