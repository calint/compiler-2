# non-inline recursion: factorial results and caller-local preservation

func assert(err, expr : bool) if not expr exit(err)

func noinline factorial(value) : result {
    result = 1
    if value <= 1 return

    var saved = value
    var next = value - 1
    var partial = 0
    partial = factorial(next)
    if saved != value or next != value - 1 {
        result = -1
        return
    }
    result = saved * partial
}

func main() {
    var value = 5
    var result = 0
    result = factorial(value)
    assert(3, result == 120)
    assert(4, value == 5)

    value = 1
    result = factorial(value)
    assert(5, result == 1)
}