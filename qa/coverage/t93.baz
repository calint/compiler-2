func assert(expr : bool) {
    if not expr exit(1)
}

func print(len, ptr) {
    write(1, ptr, len)
}

func input(len, ptr) : i64 nbytes {
    nbytes = read(0, ptr, len)
}

type str_s {
    size : i8,
    data : i8[31]
}

type str_m {
    size : i8,
    data : i8[63]
}

type str_l {
    size : i8,
    data : i8[127]
}

type link {
    name : str_s,
    to : i32
}

type location {
    name : str_s,
    links : link[8]
}

func main() {
    var locations : location[8]
    var i = 0
    loop {
        var len = 
            input(
                array_size_of(locations[i].name.data),
                address_of(locations[i].name.data)
            )
        locations[i].name.size = len
        i = i + 1
        if len <= 1 or i == array_size_of(locations) break
    }
   
    var j = 0
    loop {
        if j == i break
        print(locations[j].name.size, address_of(locations[j].name.data))
        j = j + 1
    }
}
