# state mutation across nested function calls

func assert(expr : bool) { if not expr exit(1) }

func f1(state) : res { state = state + 1 res = state }
func f2(x) : res { res = x * 2 }
func f3(x) : res { res = x + 10 }

dat state = 0

func main() {
    var r = f3(f2(f1(state)))
    # f1() returns 1, state = 1
    # f2(1) returns 2
    # f3(2) returns 12
    assert(r == 12 and state == 1)
}
