func exit(v : reg_rdi) {
    mov(rax, 60)  # exit system call
    mov(rdi, v)   # return code
    syscall()
}

func assert(expr : bool) if not expr exit(1)

type point { x, y }

type msgpoint {  msg : i8[128], pt : point }

type message { subject : i8[64], is_read : bool, checks : bool[4] }

func main() {
    var x = -1
    var y = -2

    var mp : msgpoint[3] = { 
        { {}, { x, y } } 
    }
    assert(mp[0].pt.x == -1)
    assert(mp[0].pt.y == -2)

    mp[1] = { {}, {x} }
    assert(mp[1].pt.x == -1)
    assert(mp[1].pt.y == 0)

    mp[2] = { }

    mp[2] = { { 1, 8 }, { x } }
    assert(mp[2].msg[0] == 1)
    assert(mp[2].msg[1] == 8)

    mp[1] = { { 13, -x * 2 } }
    assert(mp[1].msg[0] == 13)
    assert(mp[1].msg[1] == 2)

    var s : i8[128] = {11, 22}
    mp[1] = { s }
    assert(mp[1].msg[0] == 11)
    assert(mp[1].msg[1] == 22)

    mp[1] = { mp[2].msg }
    assert(mp[1].msg[0] == 1)
    assert(mp[1].msg[1] == 8)

    var s1: i8[]  = { 12, 13, mp[1].msg[0] }
    var s2 : i8[3]
    s2 = s1
    assert(s2[0] == 12)
    assert(s2[1] == 13)
    assert(s2[2] == 1)

    var msg : message = { { }, true, { false, true, true } }
    assert(msg.is_read == true)
    assert(msg.checks[0] == false)
    assert(msg.checks[1] == true)
    assert(msg.checks[2] == true)

    var msg1 : message[2] = { { }, { { }, true, { false, true, true } } }
    assert(msg1[1].is_read == true)
    assert(msg1[1].checks[0] == false)
    assert(msg1[1].checks[1] == true)
    assert(msg1[1].checks[2] == true)
}
