func exit(v : reg_rdi) {
    mov(rax, 60)  # exit system call
    mov(rdi, v)   # return code
    syscall()
}

func assert(expr : bool) if not expr exit(1)

type string { len : i8, data : i8[127] }

type link { id : i16, from : i16, to : i16 }

type room { name : string, description : string, note : string, links : link[6] }

type world { rooms : room[128] }

func action_look(rm : room) {
}

func fab(from : i16) {
}

func fuz(link : link) {
    fab(link.from)
}

func main() {
    var wld : world
    fuz(wld.rooms[1].links[2])
}
