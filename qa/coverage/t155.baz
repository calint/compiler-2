func exit(v : reg_rdi) {
    mov(rax, 60)  # exit system call
    mov(rdi, v)   # return code
    syscall()
}

func assert(expr : bool) if not expr exit(1)

type point { x, y }

type msgpoint {  msg : i8[128], pt : point }

func main() {
    var x = -1
    var y = -2

    var mp : msgpoint[3] = { 
        { {}, { x, y } } 
    }
    assert(mp[0].pt.x == -1)
    assert(mp[0].pt.y == -2)

    mp[1] = { {}, {x} }
    assert(mp[1].pt.x == -1)
    assert(mp[1].pt.y == 0)

    mp[2] = { }

    mp[2] = { { 1, 8 }, { x } }
    assert(mp[2].msg[0]==1)
    assert(mp[2].msg[1]==8)
}
