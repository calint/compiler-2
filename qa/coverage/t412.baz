# foo over a user type with an array field

type holder { values : i64[2] }

dat holders : holder[2] = { {{1, 2}}, {{3, 4}} }

func exit(v : reg_rdi) {
    mov(rax, 60)
    mov(rdi, v)
    syscall()
}

func assert(x : bool) if not x exit(1)

func main() {
    foo(holders) {
        e.values[0] = e.values[0] + 10
    }
    assert(holders[0].values[0] == 11)
    assert(holders[0].values[1] == 2)
    assert(holders[1].values[0] == 13)
    assert(holders[1].values[1] == 4)
}
