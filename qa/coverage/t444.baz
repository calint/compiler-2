# regression: stmt_call alias must pin indexed operand (is_indexed on)

func assert(err, expr : bool) if not expr exit(err)

func ret_after_inc(i : i64) : i64 out {
    i = i + 1
    out = 77
}

func store_after_inc(v : i64, slot : i64, i : i64) {
    i = i + 1
    slot = v
}

func main() {
    var arr : i64[3] = {10, 20, 30}

    var ix = 0
    arr[ix] = ret_after_inc(ix)

    assert(1, ix == 1)
    assert(2, arr[0] == 77)
    assert(3, arr[1] == 20)

    var ix2 = 1
    store_after_inc(44, arr[ix2], ix2)

    assert(4, ix2 == 2)
    assert(5, arr[1] == 44)
    assert(6, arr[2] == 30)
}
