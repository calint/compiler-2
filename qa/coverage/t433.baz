# aggregate assignment with an array field

type point { x, y }
type tagged_points { tag, points[2] point }

func assert(x bool) { if not x exit(1) }

func main() {
    var arr[2] point = { {1, 2}, {3, 4} }
    var type_inst tagged_points
    type_inst = { 7, arr }

    assert(type_inst.tag == 7)
    assert(type_inst.points[0].x == 1)
    assert(type_inst.points[0].y == 2)
    assert(type_inst.points[1].x == 3)
    assert(type_inst.points[1].y == 4)
}
