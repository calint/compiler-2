# function parameters mutate caller variables

func exit(v:reg_rdi){
    mov(rax,60) # exit system call
    mov(rdi,v)  # return code
    syscall()
}

func foozi(x){
   x=x+1
}

func bar(x){
   x=x+1
   if not x==2 exit(2)
}

func main(){
    var a=0
    foozi(a)
    if not a==1 exit(1)

    bar(a)
    if not a==2 exit(3)

    exit(0)
}
