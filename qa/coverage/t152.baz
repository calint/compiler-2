func exit(v : reg_rdi) {
    mov(rax, 60)  # exit system call
    mov(rdi, v)   # return code
    syscall()
}

func assert(expr : bool) if not expr exit(1)

type point { x, y }

type line { from : point, to : point }

type message { len : i8, subject : i8[128] }

func main() {
    var x = -1
    var y = -2

    var pt : point = { x, y }
    assert(pt.x == -1)
    assert(pt.y == -2)

    var ln1 : line = {  {   -1,    -2     }      ,
                        {        3         ,          4           }           }            
    assert(ln1.from.x == -1)
    assert(ln1.from.y == -2)

    var ln2 : line = { { -1 } }
    assert(ln2.from.x == -1)
    assert(ln2.from.y == 0)
    assert(ln2.to.x == 0)
    assert(ln2.to.y == 0)

    var ln3 : line = {}

    var msg : message = { 8 }
}
