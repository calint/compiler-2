# complement and negation composition

dat len=-2

func exit(v:reg_rdi){
    mov(rax,60) # exit system call
    mov(rdi,v)  # return code
    syscall()
}

func foozi(x):i64 res{
    res=-x
}

func main(){
    var a=-1
    var b=~-foozi(-a)
    var c=~-(len)
    if ~-0b1 != 0 exit(2)
    if a==-1 and b==~1 and c==~2
        exit(0)
    exit(1)
}

dat dat_padding : i8[8]
