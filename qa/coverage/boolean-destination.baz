func assert(ok : bool) if not ok exit(1)

func main() {
    var left : i8[2] = {1, 2}
    var right : i8[2] = {1, 2}
    assert(arrays_equal(left, right, 2))
    var b : bool = arrays_equal(left, right, 2)
    assert(b)
    right[1] = 3
    assert(not arrays_equal(left, right, 2))
    b = not arrays_equal(left, right, 2)
    assert(b)
}