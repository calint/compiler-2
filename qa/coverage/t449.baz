# lea regression: nested field writes through user-type alias with lea path

func assert(err, expr : bool) if not expr exit(err)

type pair {
    x,
    y
}

type box {
    p : pair,
    tag
}

func set_fields(dst : box, v, i) {
    i = i + 1
    dst.p.x = v + i
    dst.p.y = dst.p.x + 1
    dst.tag = dst.p.x + dst.p.y
}

func main() {
    var boxes : box[2]

    var ix = 0
    set_fields(boxes[ix], 40, ix)

    assert(1, ix == 1)
    assert(2, boxes[0].p.x == 41)
    assert(3, boxes[0].p.y == 42)
    assert(4, boxes[0].tag == 83)
    assert(5, boxes[1].tag == 0)
}
