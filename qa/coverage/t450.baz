# lea regression: user-type return assigned to indexed dst from indexed src

func assert(err, expr : bool) { if not expr exit(err) }

type pair {
    x,
    y
}

func mk_from(src : pair, delta) : out pair {
    out = {src.x + delta, src.y + delta}
}

func put(dst : pair, src : pair, j) {
    j = j + 1
    dst = mk_from(src, j)
}

func main() {
    var srcs : pair[3]
    var dsts : pair[3]

    srcs[0] = {1, 2}
    srcs[1] = {30, 40}
    srcs[2] = {5, 6}

    var j = 1
    put(dsts[j], srcs[j], j)

    assert(1, j == 2)
    assert(2, dsts[1].x == 32)
    assert(3, dsts[1].y == 42)
    assert(4, srcs[1].x == 30)
    assert(5, srcs[1].y == 40)
}
