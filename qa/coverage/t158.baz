func exit(v : reg_rdi) {
    mov(rax, 60)  # exit system call
    mov(rdi, v)   # return code
    syscall()
}

func assert(expr : bool) if not expr exit(1)

type point {x, y}

func point_init() : point res {
    res.x = -1
    res.y = -2
}

func point_foo(pt : point) : point res{
    res.x = pt.x * 2
    res.y = pt.y * 2
}

func main() {
    var pt : point
    pt = point_init()
    # this is ub because it is not guranteed that all of 'p' is initialized
    assert(pt.x == -1)
    assert(pt.y == -2)

    var pt1 : point = point_init()
    assert(pt1.x == -1)
    assert(pt1.y == -2)

    var pt2 : point = point_foo(pt2)
    # this is ub because argument and result is same
}
