# foo over an indexed array of user types

type point { x, y }
type holder { points[2] point }

dat holders[2] holder =
    {
        { { {1, 2}, {3, 4} } },
        { { {5, 6}, {7, 8} } }
    }

func assert(x bool) { if not x exit(1) }

func main() {
    foo holders[1].points {
        e.y = e.y + 10
    }
    assert(holders[0].points[0].x == 1)
    assert(holders[0].points[0].y == 2)
    assert(holders[0].points[1].x == 3)
    assert(holders[0].points[1].y == 4)
    assert(holders[1].points[0].x == 5)
    assert(holders[1].points[0].y == 16)
    assert(holders[1].points[1].x == 7)
    assert(holders[1].points[1].y == 18)
}
