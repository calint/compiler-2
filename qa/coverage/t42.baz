# complement with arithmetic precedence

dat len=-2

func foozi(x:reg_rdx):i64 res{
    res=-x
}

func bar(x):i64 res{
    res=-x
}

func main(){
    var a=-1
    var b=~-foozi(-a)
    var c=~-(len)
    var d=~bar(len)
    if d==~-len and not a==b and a==-1 and b==~1 and c==~2
        exit(0)
    exit(1)
}
