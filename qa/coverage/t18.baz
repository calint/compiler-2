func exit(v:reg_rdi){
    mov(rax,60) # exit system call
    mov(rdi,v)  # return code
    syscall()
}

func print(len:reg_rdx,ptr:reg_rsi){
    mov(rax,1)   # write system call
    mov(rdi,1)   # file descriptor for standard out
    mov(rsi,ptr) # buffer address 
    mov(rdx,len) # buffer size
    syscall()
}

func foo(world:i8[]){
    var len=array_size_of(world)
    print(len-1,address_of(world))
}

func bar(n,x,hello:i8[]){
    var i=x
    loop{
        var b=2
        print(array_size_of(hello)-n,address_of(hello))
        if n==0 break
        n=n-1
        i=i-1
        b=b-1
    }
}

func f(x):i64 res{
    res=x
}

func main(){
    dat hello:i8[]="hello\n"
    dat world:i8[]="world\n"

    print(array_size_of(hello),address_of(hello))
    var a=2
    foo(world)
    var b=3
    bar(a+f(a),b,hello)
}
