# regression: stmt_call alias plain variables (is_indexed off)

func exit(v : reg_rdi) { mov(rax, 60) mov(rdi, v) syscall() }
func assert(err, expr : bool) if not expr exit(err)

func ret_after_inc(i : i64) : i64 out {
    i = i + 1
    out = 77
}

func store_after_inc(v : i64, slot : i64, i : i64) {
    i = i + 1
    slot = v
}

func main() {
    var plain : i64 = 0
    var j = 4

    plain = ret_after_inc(j)

    assert(1, j == 5)
    assert(2, plain == 77)

    var plain2 : i64 = 9
    var k = 2

    store_after_inc(55, plain2, k)

    assert(3, k == 3)
    assert(4, plain2 == 55)
}
