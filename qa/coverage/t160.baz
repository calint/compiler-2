# nested user-type array fields passed through functions

func assert(expr bool) { if not expr exit(1) }

type string { len i8, data[127] i8 }

type link { name_id i16, to i16, pad i16 }

type room { name string, description string, note string, links[6] link }

type world { rooms[128] room }

func f3(to i16) {
    to = 2
}

func f2(link link) {
    f3(link.to)
}

func f1(room room) {
    f2(room.links[2])
}

func main() {
    var wld world
    f1(wld.rooms[1])

    assert(wld.rooms[1].links[2].to == 2)
}
