# a string longer than the immediate threshold is stored as immediates on
# x86_64 while 'array_copy' holds the 'rep movsb' registers
func f() res {
    var s = i8[24]
    s = "strings longer than 16!\n"
    res = 3
}

func main() {
    var a = i8[8]{1, 2, 3, 4}
    var b = i8[8]
    array_copy(a, b, f())
    if b[2] != 3 exit(1)
    if b[3] != 0 exit(2)
}
