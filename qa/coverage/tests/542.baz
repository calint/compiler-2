# rv32i jumps across more than 1 MiB of inlined code need the 2 GiB form

func assert(err, ok bool) { if not ok exit(err) }

# the constant exceeds 'addi' so rv32i needs 5 instructions per step
func step(x) {
    x = x + 5000
}

func step16(x) {
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
    step(x)
}

func step256(x) {
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
    step16(x)
}

func step4096(x) {
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
    step256(x)
}

# about 1.3 MiB of code on rv32i
func step65536(x) {
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
    step4096(x)
}

func main() {
    var x = 0
    var i = 0
    loop {
        i = i + 1
        # 'break' jumps forward past both expansions
        if i == 3 break
        # the condition skips one expansion and 'continue' jumps back past it
        if i == 1 {
            step65536(x)
            continue
        }
        # the loop end jumps back past the expansion
        step65536(x)
    }
    assert(1, i == 3)
    assert(2, x == 655360000)
}
