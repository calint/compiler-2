# the arrays of 'arrays_equal' are computed before the count: the call in an
# array argument reads 'n' before the call in the count writes it
var n = 0

func h() res {
    res = n
}

func f() res {
    n = n + 1
    res = 1
}

func main() {
    var a = i8[4]
    a[0] = 7
    var b = i8[4]
    b[0] = 7
    b[1] = 8
    if arrays_equal(a, b[h()], f()) {
        exit(1)
    }
    exit(0)
}
