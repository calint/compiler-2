# a 'continue' does not reach the end of a 'loop': with a constant argument
# the 'break' folds away and the recursion after the loop is not expanded
func spin(k) res {
    res = k
    loop {
        if k > 100 break
        res = res + 1
        if res > 5 return
        continue
    }
    res = spin(k + 1)
}

func main() {
    exit(spin(1))
}
