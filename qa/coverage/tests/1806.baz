# --checks=upper: the end of a range below the minimum of the default type
# does not fit it and fails, on every target alike

func main() {
    var a = i8[10]
    var b = i8[10]
    var m = 1
    loop {
        if m < 0 break
        m = m << 1
    }
    var n = -1
    array_copy(a[m], b[0], n)
    exit(7)
}
