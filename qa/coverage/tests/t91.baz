func assert(expr bool) {
    if not expr exit(1)
}

func print(len, ptr) {
    write(1, ptr, len)
}

func input(len, ptr) nbytes {
    nbytes = read(0, ptr, len)
}

func print_num(num) {
    var buf[20] i8
    var n = num
    var is_negative bool = false
    
    if n < 0 {
        is_negative = true
    }
    if n > 0 n = -n
    
    var i = 20
    loop {
        i = i - 1
        var ascii = 48 - (n % 10)
        # note: not buf[i] = 48 + ... because expression will be executed as byte sized and n overflows
        buf[i] = ascii 
        n = n / 10
        if n == 0 break
    }
    
    if is_negative {
        i = i - 1
        buf[i] = 45
    }
    
    var write_pos = 0
    loop {
        buf[write_pos] = buf[i]
        write_pos = write_pos + 1
        i = i + 1
        if i == 20 break
    }
    
    print(write_pos, address_of(buf))
}

func main() {
  var nl[1] i8
  nl[0] = 10

  var i1 = 123
  var i2 i32 = 321
  var i3 i16 = 420
  var i4 = 840
  var i5 = -1
  var i6 = 2147483647  
  var i7 = -2147483648
  var i2_wide = i2
  var i3_wide = i3

  print_num(i1)
  print(1, address_of(nl))
  print_num(i2_wide)
  print(1, address_of(nl))
  print_num(i3_wide)
  print(1, address_of(nl))
  print_num(i4)
  print(1, address_of(nl))
  print_num(i5)
  print(1, address_of(nl))
  print_num(i6)
  print(1, address_of(nl))
  print_num(i7)
  print(1, address_of(nl))
}
