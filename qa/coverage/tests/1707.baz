# the arrays of 'array_copy' are computed before the count: the call in an
# array argument reads 'n' before the call in the count writes it
var n = 0

func h() res {
    res = n
}

func f() res {
    n = n + 1
    res = 1
}

func main() {
    var a = i8[4]
    a[0] = 5
    a[1] = 6
    var b = i8[4]
    array_copy(a[h()], b, f())
    exit(b[0])
}
