# canonical boolean results passed directly to a register argument
# inspect from the project root: ./baz qa/coverage/tests/0430.baz --target=x86_64 > gen.s
# use --target=rv32i for the other backend; omit checks to isolate result emission
# x86: both arrays_equal end with sete in the argument register; the negation
# then tests the register and sets it again with sete, no other register
# rv32i: equality writes 1/0 directly; the negation inverts it with sltiu
# rv32i: assert's own truth test ('bne t0, zero') is separate; x86 branches on
# the flags of the compare

func assert(ok bool) { if not ok exit(1) }

func main() {
    var left = i8[2]{1, 2}
    var right = i8[2]{1, 2}
    assert(arrays_equal(left, right, 2))
    right[1] = 3
    assert(not arrays_equal(left, right, 2))
}