# bytes read from input into a data array and printed minus the newline

dat name="............................................................"

func print(str i8[], len) {
    write(1, str, len)
}

func input(str mut i8[], len) nbytes_read {
    nbytes_read = read(0, str, len)
}

func main(){
    var len=input(name,array_length(name))-1 # remove the \n
    print(name,len)
    exit(0)
}
