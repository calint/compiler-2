# a constant count with a constant start is checked at compile time, its
# range is not checked again at run time; a run-time start is, once
func main() {
    var a = i8[]{1, 2, 3, 4}
    var b = i8[4]
    var s = 0
    foo a, 2 {
        s = s + e
    }
    array_copy(a[1], b, 2)
    array_copy(a, b, 4)
    if arrays_equal(a[1], b, 2) {
        s = s + 1
    }
    write(1, b, 2, 1)
    write(1, a, 2)
    var i = 1
    array_copy(a[i], b, 2)
    exit(s)
}
