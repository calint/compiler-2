func assert(expr bool) {
    if not expr exit(1)
}

func print(str[] i8, len) {
    write(1, str, len)
}

func input(str[] i8, len) nbytes {
    nbytes = read(0, str, len)
}

func main() {
    var input_buffer[80] i8
    var len = input(input_buffer, array_size_of(input_buffer))
    print(input_buffer, len)
}
