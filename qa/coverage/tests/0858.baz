# the address of one slot of a non-inline call is passed in a register: the
# receiver of a method with and without a result, a result, a parameter,
# recursion and a call that holds a value of its caller
type counter { n }

func noinline mut counter.add(d) { self.n = self.n + d }

func noinline counter.get(d) res { res = self.n + d }

func noinline fact(n) res {
    res = 1
    if n > 1 {
        var m = n - 1
        res = n * fact(m)
    }
}

func noinline twice(x) res {
    res = x
    var c = counter
    c.add(x)
    c.add(x)
    res = c.n
}

func main() {
    var c = counter
    var held = 3
    c.add(held)
    var f = fact(4)
    var t = twice(held)
    var g = c.get(1)
    exit(held + c.n + f + t + g)
}
