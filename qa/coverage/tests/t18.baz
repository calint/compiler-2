dat hello[] i8="hello\n"
dat world[] i8="world\n"

func print(str[] i8, len) {
    write(1, str, len)
}

func foozi(world[] i8){
    var len=array_size_of(world)
    print(world,len-1)
}

func bar(n,x,hello[] i8){
    var i=x
    loop{
        var b=2
        print(hello,array_size_of(hello)-n)
        if n==0 break
        n=n-1
        i=i-1
        b=b-1
    }
}

func f(x) res{
    res=x
}

func main(){
    print(hello,array_size_of(hello))
    var a=2
    foozi(world)
    var b=3
    bar(a+f(a),b,hello)
}
