# pairs of the same unary op cancel, also a pair that a cancelled pair
# separates; without the overflow check '--' of the minimum gives the minimum

func assert(err, ok bool) { if not ok exit(err) }

func main() {
    var a = 5
    assert(1, --a == 5)
    assert(2, ~~a == 5)
    assert(3, -~~-a == 5)
    assert(4, ~-~a == -7)
    assert(5, ---a == -5)
    assert(6, ~~~a == -6)
    var m = i8(-128)
    var n = i8(--m)
    assert(7, n == -128)
    var k = i8(0)
    k = -~~-m
    assert(8, k == -128)
    exit(0)
}
