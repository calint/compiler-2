# constant elements of an arithmetic list fold at compile at the width of the
# destination and give the same values as the run-time computation
#
# test-constant-folding.sh checks the instructions of lines marked '# folds'

const c = 4

func assert(err, expr bool) { if not expr exit(err) }

func add_three(n) res {
    res = n + 1 + 2 # folds
}

func main() {
    var one = 1
    var b = 3 + 0 + 2 # folds
    assert(1, b == 5)

    # constants merged at the end of the list
    var d = b + 3 + c * 2 # folds
    assert(2, d == 16)
    d = 3 + b - 2 # folds
    assert(3, d == 6)
    d = b - 3 # folds
    assert(4, d == 2)

    # a subtracted first run-time element takes the constant first
    d = 1 - b + 2 # folds
    assert(5, d == -2)
    d = 2 - b - 2 # folds
    assert(6, d == -5)

    # the destination read by a later element
    d = 3 + d # folds
    assert(7, d == -2)

    # products and bitwise lists
    d = 2 * b * 3 # folds
    assert(8, d == 30)
    d = b & 7 & 13 # folds
    assert(9, d == 5)
    d = b | 8 | 16 # folds
    assert(10, d == 29)
    d = b ^ 1 ^ 1 # folds
    assert(11, d == 5)
    d = b * 4 / 2 # folds
    assert(12, d == 10)

    # constant sub-expressions as operands
    d = b / (1 + 1) # folds
    assert(13, d == 2)
    d = b << (1 + 1) # folds
    assert(14, d == 20)
    d = b >> (3 - 1) # folds
    assert(15, d == 1)
    d = b % (2 * 2) # folds
    assert(16, d == 1)

    # unary ops on constant lists
    d = -(2 + 3) # folds
    assert(17, d == -5)
    d = ~(1 + 1) # folds
    assert(18, d == -3)
    d = 1 << 3 # folds
    assert(19, d == 8)
    d = -16 >> 2 # folds
    assert(29, d == -4)

    # narrow destinations wrap after each operation
    var h i8 = 100
    var e i8 = (100 + 100) / 2 # folds
    var e_run i8 = (h + 100) / 2
    assert(20, e == e_run)
    assert(21, e == -28)
    var w i8 = 100 + 100 # folds
    assert(22, w == -56)
    var m i16 = 300 * 300 # folds
    var m_factor i16 = 300
    var m_run i16 = m_factor * 300
    assert(23, m == m_run)
    var s8 i8 = 1 << 7 # folds
    assert(24, s8 == -128)
    var r8 i8 = (1 << 7) >> 7 # folds
    assert(30, r8 == -1)

    # inline arguments that are constants fold in the body
    assert(25, add_three(4) == 7)
    assert(26, add_three(one) == 4)

    # comparisons with constant lists
    if 1 + 1 > b { # folds
        exit(27)
    }
    assert(28, 2 * 3 == b + one)

    # comparisons of constant lists evaluate at compile
    if b < 2 + 2 { # folds
        exit(31)
    }
    if h < 50 + 50 { # folds
        exit(32)
    }
    if 1 + 1 != 2 { # folds
        exit(33)
    }
    if not (2 * 3 == 6 and 1 << 2 == 4) { # folds
        exit(34)
    }
    var f bool = 1 + 2 == 3
    assert(35, f)

    exit(0)
}
