# nested link mutation through a struct parameter

func assert(expr bool) {
    if not expr exit(1)
}

type link {
    name[64] i8,
    name_len i8
}

type location {
    name[64] i8,
    name_len i8,
    links[4] link
}

type world {
    time,
    loc location
}

func faaz(sz i8) {
    sz = 1
}

func fooz(lnk link) {
    lnk.name[0] = 0x61 # 'a'
    faaz(lnk.name_len)
    # lnk.name_len = 1
}

func main() {
    var wld[1] world
    fooz(wld.loc.links)
    assert(wld.loc.links.name_len == 1)
    assert(wld.loc.links.name[0] == 0x61 )
}
