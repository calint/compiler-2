# nested link mutation through a struct parameter

func assert(expr bool) {
    if not expr exit(1)
}

type link {
    name i8[64],
    name_len i8
}

type location {
    name i8[64],
    name_len i8,
    links link[4]
}

type world {
    time,
    loc location
}

func faaz(sz mut i8) {
    sz = 1
}

func fooz(lnk mut link) {
    lnk.name[0] = 0x61 # 'a'
    faaz(lnk.name_len)
    # lnk.name_len = 1
}

func main() {
    var wld = world[1]{}
    fooz(wld[0].loc.links[0])
    assert(wld[0].loc.links[0].name_len == 1)
    assert(wld[0].loc.links[0].name[0] == 0x61 )
}
