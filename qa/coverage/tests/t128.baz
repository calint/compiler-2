# all functions are inlined

# single statement blocks can ommit braces

func assert(expr bool) { if not expr exit(1) }

# built-in 'read' and 'write' interface with the OS

func print(len, ptr) {
    write(1, ptr, len)
}

func input(len, ptr) nbytes {
    nbytes = read(0, ptr, len)
}

type str {
    len i8,
    data[127] i8
}

func str_in(s str) {
    var nbytes = read(0, address_of(s.data), array_size_of(s.data))
    s.len = i8(nbytes - 1)
} 

func str_out(s str) {
    write(1, address_of(s.data), s.len)
} 

type list {
    len i8,
    data[127] i8
}

type exit {
    name str,
    to i8
}

type object {
    name str
}

type entity {
    name str,
    location i8,
    inventory list
}

type location {
    name str,
    note str,
    entities list,
    objects list,
    exits list
}

func foozi(src location, dst location) {
    dst.name = {src.name.len, src.name.data}
    dst.note = src.note
}

func main() {
    var locations[128] location
    var entities[128] entity
    var exits[1024] exit

    locations[0].name.data[1] = 0x61

    foozi(locations[0], locations[1])
    assert(locations[1].name.data[1] == 0x61)

}
