func assert(expr bool) { if not expr exit(1) }

func print(str[] i8, len) {
    write(1, str, len)
}

func input(str[] i8, len) nbytes {
    nbytes = read(0, str, len)
}

func pn(num) {
    var buf[20] i8
    var n = num
    var is_negative bool = false

    if n < 0 {
        is_negative = true
        n = -n
    }

    var i = 20
    loop {
        i = i - 1
        buf[i] = 48 + (n % 10)
        n = n / 10
        if n == 0 break
    }

    if is_negative {
        i = i - 1
        buf[i] = 45  # '-'
    }

    write(1, buf, 20 - i, i)
}

type str {
    size i8,
    chars[127] i8
}

type world {
    name str,
    note str
}

func foozi(w1 world, w2 world){
    assert(w1.note.size + w2.note.size == 3)
}

func bar(w1 world, w2 world){
    foozi(w1, w2)
}

func main() {
    var wlds[2] world
    wlds[0].note.size = 1
    wlds[1].note.size = 2
    
    bar(wlds[0], wlds[1])
}
