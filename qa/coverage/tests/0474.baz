# the destination is read by a later element of its own expression
func assert(ok bool) { if not ok exit(1) }
func id(a) res {
    res = a
}
func main() {
    var b = 5
    b = 2 + b
    assert(b == 7)
    var c = 5
    c = 1 + c + c
    assert(c == 11)
    var d = 5
    d = 2 + id(d)
    assert(d == 7)
    var e = 5
    e = 3 * id(e) - id(e)
    assert(e == 10)
    var v = 5
    v = 2 * (1 + v)
    assert(v == 12)
}
