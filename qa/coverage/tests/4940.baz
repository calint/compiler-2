# a variable shift with all fourteen x86 registers live needs 'rcx', which
# holds its count: rejected on x86_64, not computed into another register;
# rv32i has the registers and exits 15

func main() {
    var v0 = i32(1)
    var v1 = i32(2)
    var v2 = i32(3)
    var v3 = i32(4)
    var v4 = i32(5)
    var v5 = i32(6)
    var v6 = i32(7)
    var v7 = i32(8)
    var v8 = i32(9)
    var v9 = i32(10)
    var v10 = i32(11)
    var v11 = i32(12)
    var v12 = i32(13)
    var v13 = i32(14)
    var v14 = i32(15)
    var v15 = i32(16)
    var r = v0 + (v1 + (v2 + (v3 + (v4 + (v5 + (v6 + (v7 + (v8 + (v9 + (v10 + (v11 + (v12 + (v13 + (v14 << v15))))))))))))))
    exit(r >> 16 & 255)
}
