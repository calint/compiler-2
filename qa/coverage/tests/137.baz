func assert(expr bool) { if not expr exit(1) }

func faz(x, y) res {
    res = x / y 
}

func fez(val[]) res {
    res = val[2] / val[1] 
}

func foz(x, y) res {
    res = ~x / ~y 
}

func fuz(x, y) res {
    res = ~x % ~y 
}

func main() {
    var values = [4]{}
    values[1] = 4
    values[2] = 8

    values[3] = faz(values[2], values[1])
    assert(values[3] == 2)

    # note: temporary because the result may share storage with the argument
    var tmp1 = fez(values)
    values[0] = tmp1
    assert(values[0] == 2)

    var a = faz(9, 3)
    assert(a == 3)

    values[3] = foz(values[2], values[1])
    assert(values[3] == 1)

    values[3] = fuz(values[2], values[1])
    assert(values[3] == -4)
}
