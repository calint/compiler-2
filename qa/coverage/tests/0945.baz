# aliasing: the element 'e' of a 'foo' is passed to a function that reads
# the array, which can be the element itself
# the value is computed before the destination is written
# the call is rejected: the function uses the global the call passes it

dat g = i32[4]{ 1, 2, 3, 4 }

func put(x mut i32, k i32) {
    x = k + (100 - g[3])
}

func main() {
    foo g {
        put(e, 10)
    }
    exit(g[3] - 106)
}
