# a type name alone is its zero value in a record literal and in an index

func assert(err, ok bool) { if not ok exit(err) }
type p {x, y}
type line {a p, b p}
func sum(q p) res { res = q.x + q.y }
func noinline nsum(q p) res { res = q.x + q.y }
func main() {
    var l = line{p, p}
    assert(1, l.a.x == 0)
    var a = i8[4]
    a[1] = 3
    var i = a[i8]
    assert(3, i == 0)
    assert(4, a[1] == 3)
}
