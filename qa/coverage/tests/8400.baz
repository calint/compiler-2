# a tokenizer and two expression evaluators over a script, one recursive, one
# by reverse polish notation; variables and wrapping 32 bit arithmetic

dat obuf = i8[512]
dat olen = 0

func out_flush() {
    if olen == 0 return
    write(1, obuf, olen)
    olen = 0
}

func out_ch(c i8) {
    if olen == array_length(obuf) out_flush()
    obuf[olen] = c
    olen = olen + 1
}

func out_nl() { out_ch('\n') }
func out_sp() { out_ch(' ') }

func out_str(s i8[]) {
    foo s {
        out_ch(e)
    }
}

# decimal, the digits are made from the negative value so the minimum prints
func noinline out_i32(v i32) {
    var digits = i8[12]
    var count = 0
    var x = v
    if v > 0 x = -v
    loop {
        let d = x % 10
        digits[count] = i8('0' - d)
        count = count + 1
        x = x / 10
        if x == 0 break
    }
    if v < 0 out_ch('-')
    loop {
        count = count - 1
        out_ch(digits[count])
        if count == 0 break
    }
}

let tk_end = 0
let tk_number = 1
let tk_name = 2
let tk_op = 3
let tk_bad = 4

let ok = 0
let err_syntax = 1
let err_division = 2
let err_domain = 3

type lexer {
    src i8[64],
    len,
    pos,
    kind,
    value i32,
    op i8,
}

func mut lexer.load(text i8[], start, count) {
    array_copy(text[start], self.src, count)
    self.len = count
    self.pos = 0
    self.kind = tk_end
}

func mut lexer.next() {
    loop {
        if self.pos == self.len break
        if self.src[self.pos] != ' ' break
        self.pos = self.pos + 1
    }
    if self.pos == self.len {
        self.kind = tk_end
        return
    }
    let c = self.src[self.pos]
    if c >= '0' and c <= '9' {
        self.kind = tk_number
        self.value = 0
        loop {
            if self.pos == self.len break
            let d = self.src[self.pos]
            if d < '0' or d > '9' break
            self.value = i32(self.value * 10 + (d - '0'))
            self.pos = self.pos + 1
        }
        return
    }
    self.pos = self.pos + 1
    self.op = c
    if c >= 'a' and c <= 'z' {
        self.kind = tk_name
    } else if c == '+' or c == '-' or c == '*' or c == '/' or c == '%' or c == '^' or c == '(' or c == ')' or c == '=' {
        self.kind = tk_op
    } else {
        self.kind = tk_bad
    }
}

dat lx = lexer
dat variables = i32[26]
dat failure = 0

func fail(code) {
    # a syntax error wins, else the first error stays
    if code == err_syntax or failure == ok failure = code
}

# 0 for what is no binary operator
func precedence(op i8) res {
    res = 0
    if op == '+' or op == '-' {
        res = 1
    } else if op == '*' or op == '/' or op == '%' {
        res = 2
    } else if op == '~' {
        res = 3
    } else if op == '^' {
        res = 4
    }
}

func noinline apply(op i8, a i32, b i32) res i32 {
    res = 0
    if op == '+' {
        res = i32(a + b)
    } else if op == '-' {
        res = i32(a - b)
    } else if op == '*' {
        res = i32(a * b)
    } else if op == '/' or op == '%' {
        if b == 0 {
            fail(err_division)
            return
        }
        # note: the minimum divided by -1 wraps to itself, its remainder is 0
        if b == -1 {
            if op == '/' res = i32(0 - a)
            return
        }
        if op == '/' {
            res = a / b
        } else {
            res = a % b
        }
    } else if op == '^' {
        if b < 0 {
            fail(err_domain)
            return
        }
        res = 1
        var count = b
        loop {
            if count == 0 break
            res = i32(res * a)
            count = count - 1
        }
    }
}

# the value of the operators of at least 'floor' from the current token
func noinline parse(floor) res i32 {
    res = 0
    if lx.kind == tk_number {
        res = lx.value
        lx.next()
    } else if lx.kind == tk_name {
        res = variables[lx.op - 'a']
        lx.next()
    } else if lx.kind == tk_op and lx.op == '-' {
        lx.next()
        let operand = parse(3)
        res = i32(0 - operand)
    } else if lx.kind == tk_op and lx.op == '(' {
        lx.next()
        res = parse(1)
        if lx.kind != tk_op or lx.op != ')' {
            fail(err_syntax)
            return
        }
        lx.next()
    } else {
        fail(err_syntax)
        return
    }
    loop {
        if lx.kind != tk_op break
        let op = lx.op
        let level = precedence(op)
        if level == 0 or level < floor break
        lx.next()
        var next_floor = level + 1
        if op == '^' next_floor = level
        let right = parse(next_floor)
        let left = res
        res = apply(op, left, right)
    }
}

type cell {
    value i32,
    kind i8,
    op i8,
}

type program {
    cells cell[48],
    count,
}

func mut program.add(c cell) {
    self.cells[self.count] = c
    self.count = self.count + 1
}

# the tokens from the current one in reverse polish notation, the syntax was
# checked by 'parse'
func to_polish(out mut program) {
    var ops = i8[32]
    var depth = 0
    var operand_next = true
    out.count = 0
    loop {
        if lx.kind == tk_end break
        if lx.kind == tk_number {
            out.add({lx.value, tk_number, 0})
            operand_next = false
        } else if lx.kind == tk_name {
            out.add({0, tk_name, lx.op})
            operand_next = false
        } else if lx.op == '(' {
            ops[depth] = '('
            depth = depth + 1
        } else if lx.op == ')' {
            loop {
                depth = depth - 1
                if ops[depth] == '(' break
                out.add({0, tk_op, ops[depth]})
            }
        } else if operand_next {
            ops[depth] = '~'
            depth = depth + 1
        } else {
            let level = precedence(lx.op)
            loop {
                if depth == 0 break
                let top = ops[depth - 1]
                if top == '(' break
                let top_level = precedence(top)
                if top_level < level break
                if top_level == level and lx.op == '^' break
                out.add({0, tk_op, top})
                depth = depth - 1
            }
            ops[depth] = lx.op
            depth = depth + 1
            operand_next = true
        }
        lx.next()
    }
    loop {
        if depth == 0 break
        depth = depth - 1
        out.add({0, tk_op, ops[depth]})
    }
}

func program.print() {
    foo self.cells, self.count {
        if e.kind == tk_number {
            out_i32(e.value)
        } else {
            out_ch(e.op)
        }
        out_sp()
    }
}

func program.run() res i32 {
    var stack = i32[24]
    var depth = 0
    foo self.cells, self.count {
        if e.kind == tk_number {
            stack[depth] = e.value
            depth = depth + 1
        } else if e.kind == tk_name {
            stack[depth] = variables[e.op - 'a']
            depth = depth + 1
        } else if e.op == '~' {
            stack[depth - 1] = i32(0 - stack[depth - 1])
        } else {
            depth = depth - 1
            let left = stack[depth - 1]
            let right = stack[depth]
            stack[depth - 1] = apply(e.op, left, right)
        }
    }
    res = stack[0]
}

dat script = "\
1 + 2 * 3\n\
(1 + 2) * 3\n\
100 / 7 % 5 - 2 * -3\n\
a = 6 * 7\n\
b = a * a - 1\n\
-a ^ 2 + b\n\
2 ^ 3 ^ 2\n\
(2 ^ 3) ^ 2\n\
c = 2 ^ 31\n\
c - 1\n\
c / -1\n\
c % -1 + -c\n\
-7 / 2 * 2 + -7 % 2\n\
7 / (a - 42)\n\
7 % (b - b) + 1 / 0\n\
2 ^ (0 - 1)\n\
2 ^ -1 + 1 / 0\n\
(1 + 2\n\
1 + * 2\n\
3 $ 4\n\
1 2\n\
\n\
d = 99999 * 99999\n\
d * d - (d - 1) * (d + 1)\n\
z = ((((((((1 + 2) * 3) - 4) * 5) + 6) * 7) - 8) * 9)\n\
z % 1000 - -(-(-(z / 1000)))\n\
a - b - c - d - z\n\
a - (b - (c - (d - z)))\n\
3 ^ 20 - 3 ^ 19 * 3\n\
x = y = 5\n\
1 +\n\
- - - 4\n\
2 * (3 + 4) * (5 - (6 / (7 - 5)))\n"

dat text_syntax = "syntax\n"
dat text_division = "division\n"
dat text_domain = "domain\n"

func run_line(start, count) {
    lx.load(script, start, count)
    lx.next()
    failure = ok

    # 'name =' starts an assignment
    var target = -1
    var expression_at = 0
    if lx.kind == tk_name {
        let name = lx.op
        lx.next()
        if lx.kind == tk_op and lx.op == '=' {
            target = name - 'a'
            expression_at = lx.pos
        }
    }
    lx.pos = expression_at
    lx.next()

    let value = parse(1)
    if lx.kind != tk_end fail(err_syntax)
    if failure == err_syntax {
        out_str(text_syntax)
        return
    }
    let recursive_failure = failure

    # again from the first token of the expression
    lx.pos = expression_at
    lx.next()
    var polish = program
    to_polish(polish)
    polish.print()
    out_ch('=')
    out_sp()
    failure = ok
    let iterative = polish.run()
    if failure != recursive_failure exit(3)
    if failure == err_division {
        out_str(text_division)
        return
    }
    if failure == err_domain {
        out_str(text_domain)
        return
    }
    if iterative != value exit(4)
    if target >= 0 {
        variables[target] = value
        out_ch(i8('a' + target))
        out_sp()
    }
    out_i32(value)
    out_nl()
}

func main() {
    var start = 0
    foo script {
        if e == '\n' {
            run_line(start, i - start)
            start = i + 1
        }
    }
    out_flush()
}
