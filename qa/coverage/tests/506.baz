# inline call labels are unique for any function name

func assert(err, expr bool) { if not expr exit(err) }

func cmp() res { res = 1 }

func f() res { res = 2 }

func f_10_11() res {
    res = f() + 1
}

func main() {
    if cmp() == 1 {
        var r = f_10_11()
        assert(2, r == 3)
        exit(0)
    }
    exit(1)
}
