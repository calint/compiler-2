# a 'let' of the 'n' of a 'foo' over an unsized array parameter is a constant
# at a noinline call that gives the length, as 'n' is: 's[m]' past the end is
# rejected like 's[n]'

func noinline last(s i8[]) res i8 {
    res = 0
    foo s {
        let m = n
        res = s[m]
    }
}

func main() {
    var a = i8[4]
    exit(last(a))
}
