# a part of a value read under another name of the destination is overwritten
# like one read under its own name: the dry run of the noinline call binds 'p'
# to 'g'
# with '--checks=-alias', which otherwise rejects the call first: the
# function uses the global the call passes it

type point {x, y}

var g = point{3, 5}

func noinline f(p point) {
    g = {1, p.x}
}

func main() {
    f(g)
    exit(g.y)
}
