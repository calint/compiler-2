# a conversion of a list of constants is a constant, computed like a list at
# the wider of the types, where it wraps, then narrowed: 200 * 200 / 2 at
# 'i16' is -12768, 32 in its low byte
func main() {
    let n = int(1 + 2)
    var a = i8[n]
    let k = i16(200)
    let m = i8(k * k / 2)
    exit(int(m) + array_length(a))
}
