# 'array_copy' down an array, the ranges overlap: every element arrives for
# counts around the block sizes of the targets, of 'i8', 'i16' and 'i32'
func fill_i8(a mut i8[]) {
    foo a { e = i8(i * 7 + 3) }
}
# the first 'count' elements are those 'off' further up, the others are kept
func moved_i8(a i8[], off, count) res bool {
    res = true
    foo a {
        var was = i
        if i < count was = i + off
        if e != i8(was * 7 + 3) res = false
    }
}
func fill_i16(a mut i16[]) {
    foo a { e = i16(i * 7 + 3) }
}
# the first 'count' elements are those 'off' further up, the others are kept
func moved_i16(a i16[], off, count) res bool {
    res = true
    foo a {
        var was = i
        if i < count was = i + off
        if e != i16(was * 7 + 3) res = false
    }
}
func fill_i32(a mut i32[]) {
    foo a { e = i32(i * 7 + 3) }
}
# the first 'count' elements are those 'off' further up, the others are kept
func moved_i32(a i32[], off, count) res bool {
    res = true
    foo a {
        var was = i
        if i < count was = i + off
        if e != i32(was * 7 + 3) res = false
    }
}
