# an integer library with every function inlined and noinline: both agree on
# every pair of a table of edge values, the inlined one also with constants

dat obuf = i8[512]
dat olen = 0

func out_flush() {
    if olen == 0 return
    write(1, obuf, olen)
    olen = 0
}

func out_ch(c i8) {
    if olen == array_length(obuf) out_flush()
    obuf[olen] = c
    olen = olen + 1
}

func out_nl() { out_ch('\n') }
func out_sp() { out_ch(' ') }

# decimal, the digits are made from the negative value so the minimum prints
func noinline out_i32(v i32) {
    var digits = i8[12]
    var count = 0
    var x = v
    if v > 0 x = -v
    loop {
        let d = x % 10
        digits[count] = i8('0' - d)
        count = count + 1
        x = x / 10
        if x == 0 break
    }
    if v < 0 out_ch('-')
    loop {
        count = count - 1
        out_ch(digits[count])
        if count == 0 break
    }
}

dat hex_digits = "0123456789abcdef"

# 8 hex digits of the 32 bits
func noinline out_hex32(v i32) {
    var shift = 28
    loop {
        out_ch(hex_digits[v >> shift & 15])
        if shift == 0 break
        shift = shift - 4
    }
}

func item(v i32) {
    out_i32(v)
    out_sp()
}

func absolute(a i32, b i32) res i32 {
    res = a
    # note: the minimum wraps to itself
    if a < 0 res = i32(0 - a)
}

func minimum(a i32, b i32) res i32 {
    res = a
    if b < a res = b
}

func maximum(a i32, b i32) res i32 {
    res = b
    if a > b res = a
}

func sign_product(a i32, b i32) res i32 {
    res = 0
    if a == 0 or b == 0 return
    res = 1
    let a_negative = a < 0
    let b_negative = b < 0
    if a_negative != b_negative res = -1
}

func average(a i32, b i32) res i32 {
    res = (a & b) + ((a ^ b) >> 1)
}

func saturating_add(a i32, b i32) res i32 {
    res = i32(a + b)
    if a >= 0 and b >= 0 and res < 0 {
        res = 2147483647
    } else if a < 0 and b < 0 and res >= 0 {
        res = -2147483647 - 1
    }
}

func saturating_sub(a i32, b i32) res i32 {
    res = i32(a - b)
    if a >= 0 and b < 0 and res < 0 {
        res = 2147483647
    } else if a < 0 and b >= 0 and res >= 0 {
        res = -2147483647 - 1
    }
}

func divide_floor(a i32, b i32) res i32 {
    res = 0
    if b == 0 return
    if b == -1 {
        res = i32(0 - a)
        return
    }
    res = a / b
    let a_negative = a < 0
    let b_negative = b < 0
    if a % b != 0 and a_negative != b_negative res = res - 1
}

func divide_ceiling(a i32, b i32) res i32 {
    res = 0
    if b == 0 return
    if b == -1 {
        res = i32(0 - a)
        return
    }
    res = a / b
    let a_negative = a < 0
    let b_negative = b < 0
    if a % b != 0 and a_negative == b_negative res = res + 1
}

func modulo_euclid(a i32, b i32) res i32 {
    res = 0
    if b == 0 or b == -1 return
    res = a % b
    if res < 0 {
        if b < 0 {
            res = i32(res - b)
        } else {
            res = res + b
        }
    }
}

func remainder_parts(a i32, b i32) res i32 {
    res = -1
    if b == 0 or b == -1 return
    # the identity of truncated division, 1 when it holds
    res = 0
    if a / b * b + a % b == a res = 1
}

func clamp_between(a i32, b i32) res i32 {
    res = a
    if res < -1000 res = -1000
    if res > b and b >= -1000 res = b
}

func shift_mix(a i32, b i32) res i32 {
    let count = b & 31
    res = a << count ^ (a >> count) ^ (b >> (31 - count))
}

func compare_chain(a i32, b i32) res i32 {
    res = 0
    if a < b res = res | 1
    if a <= b res = res | 2
    if a == b res = res | 4
    if a != b res = res | 8
    if a >= b res = res | 16
    if a > b res = res | 32
    if not (a < b or a == b) res = res | 64
    if a < 0 and (b < 0 or a + 1 < 0) res = res | 128
    if (a > 100 or b > 100) and not (a > 100 and b > 100) res = res | 256
}

func narrow_mix(a i32, b i32) res i32 {
    let small = i8(a)
    let medium = i16(b)
    let sum = i16(small) + medium / 2
    let product = i32(small) * medium
    let folded = i8(product >> 8 ^ product)
    res = product - sum + folded
}

func saturating_narrow(a i32, b i32) res i32 {
    let x = i8(a)
    let y = i8(b >> 3)
    var wide = i16(x) + y
    if wide > 127 wide = 127
    if wide < -128 wide = -128
    let narrow = i8(wide)
    var product = i16(x) * y
    if product > 127 product = 127
    if product < -128 product = -128
    res = i32(narrow) * 1000 + product
}

func digits_and_power(a i32, b i32) res i32 {
    var digits = i32(1)
    var rest = a / 10
    loop {
        if rest == 0 break
        digits = digits + 1
        rest = rest / 10
    }
    var power = i32(1)
    var count = b & 7
    loop {
        if count == 0 break
        power = i32(power * a)
        count = count - 1
    }
    res = i32(power * 16 + digits)
}

func power_of_two(a i32, b i32) res i32 {
    res = 0
    if a > 0 and a & i32(a - 1) == 0 res = 1
    if b > 0 and b & i32(b - 1) == 0 res = res + 2
    if a ^ b < 0 res = res + 4
}


func noinline absolute_n(a i32, b i32) res i32 {
    res = a
    # note: the minimum wraps to itself
    if a < 0 res = i32(0 - a)
}

func noinline minimum_n(a i32, b i32) res i32 {
    res = a
    if b < a res = b
}

func noinline maximum_n(a i32, b i32) res i32 {
    res = b
    if a > b res = a
}

func noinline sign_product_n(a i32, b i32) res i32 {
    res = 0
    if a == 0 or b == 0 return
    res = 1
    let a_negative = a < 0
    let b_negative = b < 0
    if a_negative != b_negative res = -1
}

func noinline average_n(a i32, b i32) res i32 {
    res = (a & b) + ((a ^ b) >> 1)
}

func noinline saturating_add_n(a i32, b i32) res i32 {
    res = i32(a + b)
    if a >= 0 and b >= 0 and res < 0 {
        res = 2147483647
    } else if a < 0 and b < 0 and res >= 0 {
        res = -2147483647 - 1
    }
}

func noinline saturating_sub_n(a i32, b i32) res i32 {
    res = i32(a - b)
    if a >= 0 and b < 0 and res < 0 {
        res = 2147483647
    } else if a < 0 and b >= 0 and res >= 0 {
        res = -2147483647 - 1
    }
}

func noinline divide_floor_n(a i32, b i32) res i32 {
    res = 0
    if b == 0 return
    if b == -1 {
        res = i32(0 - a)
        return
    }
    res = a / b
    let a_negative = a < 0
    let b_negative = b < 0
    if a % b != 0 and a_negative != b_negative res = res - 1
}

func noinline divide_ceiling_n(a i32, b i32) res i32 {
    res = 0
    if b == 0 return
    if b == -1 {
        res = i32(0 - a)
        return
    }
    res = a / b
    let a_negative = a < 0
    let b_negative = b < 0
    if a % b != 0 and a_negative == b_negative res = res + 1
}

func noinline modulo_euclid_n(a i32, b i32) res i32 {
    res = 0
    if b == 0 or b == -1 return
    res = a % b
    if res < 0 {
        if b < 0 {
            res = i32(res - b)
        } else {
            res = res + b
        }
    }
}

func noinline remainder_parts_n(a i32, b i32) res i32 {
    res = -1
    if b == 0 or b == -1 return
    # the identity of truncated division, 1 when it holds
    res = 0
    if a / b * b + a % b == a res = 1
}

func noinline clamp_between_n(a i32, b i32) res i32 {
    res = a
    if res < -1000 res = -1000
    if res > b and b >= -1000 res = b
}

func noinline shift_mix_n(a i32, b i32) res i32 {
    let count = b & 31
    res = a << count ^ (a >> count) ^ (b >> (31 - count))
}

func noinline compare_chain_n(a i32, b i32) res i32 {
    res = 0
    if a < b res = res | 1
    if a <= b res = res | 2
    if a == b res = res | 4
    if a != b res = res | 8
    if a >= b res = res | 16
    if a > b res = res | 32
    if not (a < b or a == b) res = res | 64
    if a < 0 and (b < 0 or a + 1 < 0) res = res | 128
    if (a > 100 or b > 100) and not (a > 100 and b > 100) res = res | 256
}

func noinline narrow_mix_n(a i32, b i32) res i32 {
    let small = i8(a)
    let medium = i16(b)
    let sum = i16(small) + medium / 2
    let product = i32(small) * medium
    let folded = i8(product >> 8 ^ product)
    res = product - sum + folded
}

func noinline saturating_narrow_n(a i32, b i32) res i32 {
    let x = i8(a)
    let y = i8(b >> 3)
    var wide = i16(x) + y
    if wide > 127 wide = 127
    if wide < -128 wide = -128
    let narrow = i8(wide)
    var product = i16(x) * y
    if product > 127 product = 127
    if product < -128 product = -128
    res = i32(narrow) * 1000 + product
}

func noinline digits_and_power_n(a i32, b i32) res i32 {
    var digits = i32(1)
    var rest = a / 10
    loop {
        if rest == 0 break
        digits = digits + 1
        rest = rest / 10
    }
    var power = i32(1)
    var count = b & 7
    loop {
        if count == 0 break
        power = i32(power * a)
        count = count - 1
    }
    res = i32(power * 16 + digits)
}

func noinline power_of_two_n(a i32, b i32) res i32 {
    res = 0
    if a > 0 and a & i32(a - 1) == 0 res = 1
    if b > 0 and b & i32(b - 1) == 0 res = res + 2
    if a ^ b < 0 res = res + 4
}

dat edges = i32[]{0, 1, -1, 2, -2, 7, -7, 100, -100, 32767, -32768, 65536, 2147483647, -2147483647 - 1, 46340, -46341, 12345678, 255, -129}

func check_absolute() {
    var fold = i32(0)
    foo edges {
        let a = e
        foo edges {
            let inlined = absolute(a, e)
            let called = absolute_n(a, e)
            if inlined != called exit(2)
            fold = i32(fold * 31 + inlined)
        }
    }
    out_hex32(fold)
    out_nl()
}

func constants_absolute() {
    item(absolute(0, 0))
    item(absolute(1, -2147483647 - 1))
    item(absolute(-1, 2))
    item(absolute(2, 12345678))
    item(absolute(-2, -7))
    item(absolute(-7, 32767))
    item(absolute(-100, 2147483647))
    item(absolute(32767, -1))
    item(absolute(-32768, -46341))
    item(absolute(65536, 7))
    item(absolute(2147483647, -129))
    item(absolute(-2147483647 - 1, -100))
    item(absolute(-46341, 65536))
    item(absolute(12345678, 1))
    item(absolute(255, 46340))
    item(absolute(-129, -2))
    out_nl()
}

