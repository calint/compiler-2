# the type arguments of a call are deduced from the arguments that are
# variables, fields or elements

func assert(err, ok bool) { if not ok exit(err) }

type text<capacity> {
    array i8[capacity],
    len,
}

type str = text<8>
type name = text<4>

type holder {
    n name,
    list name[2],
}

func mut text.append<T type>(s T) {
    array_copy(s.array, self.array[self.len], s.len)
    self.len = self.len + s.len
}

func same<T type>(a T, b T) res bool {
    res = a.len == b.len
}

func zero<T type>() res T {
    res.len = 0
    res.array = {}
}

func main() {
    var n = name
    n.len = 2
    var s = str
    s.append(n)
    assert(1, s.len == 2)
    s.append<name>(n)
    assert(2, s.len == 4)
    var h = holder
    h.n.len = 1
    h.list[1].len = 3
    s.append(h.n)
    s.append(h.list[1])
    assert(3, s.len == 8)
    assert(4, not same(n, h.n))
    var z = zero<name>()
    assert(5, z.len == 0)
}
