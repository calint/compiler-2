# a noinline method that calls a noinline method of another receiver, an
# element indexed by a run-time value, has its own receiver back for the
# reads after the call: the call saves the receiver register before it loads
# the other receiver

type item {
    x,
    y,
}

type box {
    tag,
    items item[3],
}

func noinline id(v) res {
    res = v
}

func noinline item.get() res {
    res = self.x * 10 + self.y
}

func noinline mut item.bump(k) {
    self.y = self.y + k
}

func noinline mut box.walk(n, k, others item[]) res {
    if n == 0 {
        res = self.tag
        return
    }
    self.items[k].bump(n)
    var j = k + 1
    if j == 3 {
        j = 0
    }
    res = self.items[k].get() + others[j].get() + self.walk(n - 1, j, others)
    res = res + self.items[j].get() + self.tag
}

func main() {
    var b = box{7, {{1, 2}, {3, 4}, {5, 6}}}
    var others = item[3]{{0, 1}, {0, 2}, {0, 3}}
    var r = b.walk(id(5), id(2), others)
    if b.items[0].y != 7 exit(1)
    if b.items[1].y != 7 exit(2)
    if b.items[2].y != 13 exit(3)
    exit(r - 416)
}
