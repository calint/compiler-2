# non-inline recursion, references, aggregate returns and large local frames

type point { x, y }
func assert(ok bool) { if not ok exit(1) }

func noinline factorial(value i32) result i32 {
    result = 1
    if value <= 1 return
    var saved = value
    var next i32 = value - 1
    var partial i32 = 0
    partial = factorial(next)
    assert(saved == value)
    assert(next == value - 1)
    result = i32(saved * partial)
}

func noinline shift(value point) result point {
    var buffer[4096] i8
    buffer[4095] = 17
    result = value
    value.x = value.x + 2
    result.y = result.y + buffer[4095]
}

func noinline forward(value point) result point {
    var saved = value.y
    result = shift(value)
    assert(saved == value.y)
}

func main() {
    var value i32 = 5
    var result i32 = 0
    result = factorial(value)
    assert(result == 120)
    assert(value == 5)
    value = 1
    result = factorial(value)
    assert(result == 1)
    var source point = {3, 20}
    var destination point
    destination = forward(source)
    assert(source.x == 5)
    assert(source.y == 20)
    assert(destination.x == 3)
    assert(destination.y == 37)
}