# the arrays of 'array_copy' are computed before the count: the call in the
# count reads 'n' after the call in an array argument wrote it
var n = 0

func w() res {
    n = 2
    res = 0
}

func f() res {
    res = n
}

func main() {
    var a = i8[4]
    a[0] = 4
    a[1] = 5
    var b = i8[4]
    array_copy(a[w()], b, f())
    exit(b[1])
}
