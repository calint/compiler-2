# a constructor is called on a type parameter, T.at(...) builds a point in place
type point { x i32, y i32 }
func point.at(x i32, y i32) self { self.x = x  self.y = y }

type list<T type, capacity> { array T[capacity], len }

func mut list.add(x i32, y i32) res {
    res = self.len
    self.array[res] = T.at(x, y)
    self.len = self.len + 1
}

type points = list<point, 4>

func main() {
    var l = points
    var a = i32(5)
    let first = l.add(1, a)
    let second = l.add(a, 2)
    if l.array[0].y != 5 exit(1)
    if l.array[1].x != 5 exit(2)
    if second != 1 exit(3)
    exit(0)
}
