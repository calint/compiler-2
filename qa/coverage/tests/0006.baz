# jump optimization patterns, the optimized output is compared with --nopt in
# the '0006.TARGET.diff' of each target

func main(){
    var a=1
    var b=2
    var c=3
    var d=4
    # the jump back to the loop start follows the unconditional 'break'
    loop {
        a = 1
        break
    }
    # the last comparison of a list (same-target branches: see 8380)
    var ok = a==1 and b==2
    if not ok
        exit(2)
    # jumps to the next code and a branch over a jump
    if (a==1 and b==2) or (c==3 and d==4)
        exit(0)
    exit(1)
}
