# array_length follows nested array fields

func assert(expr bool) {
    if not expr exit(1)
}

type flags {
    data[8] i8
}

type world {
    time,
    flgs[4] flags
}

func foozi(data[] i8) {
    assert(array_length(data) == 8)
}

func bar(flg flags) {
    assert(array_length(flg) == 4)
}

func main() {
    var worlds[2] world
    foozi(worlds[1].flgs[2].data)
    bar(worlds[1].flgs[1])
}
