# array_length follows nested array fields

func assert(expr bool) {
    if not expr exit(1)
}

type flags {
    data i8[8]
}

type world {
    time,
    flgs flags[4]
}

func foozi(data i8[]) {
    assert(array_length(data) == 8)
}

func bar(flg flags) {
    assert(array_length(flg.data) == 8)
}

func main() {
    var worlds = world[2]{}
    foozi(worlds[1].flgs[2].data)
    bar(worlds[1].flgs[1])
}
