# --checks=alias: the destination has one run-time index and the read two, the
# bytes in the elements are different, which is accepted

type item {
    f i32,
    g i32,
}

type ent {
    items item[2],
    other i32,
}

dat es = ent[3]

func put(x mut i32, i i32, j i32) {
    x = 100 - es[i].items[j].f
}

func main() {
    var k = 0
    var i = i32(0)
    var j = i32(1)

    es[0].items[1].f = 7
    put(es[k].other, i, j)
    if es[0].other != 93 exit(1)
}
