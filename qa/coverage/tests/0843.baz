# the bodies of two instances of a generic 'noinline' function have the same
# source locations, their labels are still unique
type text<capacity> {
    array i8[capacity],
    len,
}

type text2 = text<2>

type text4 = text<4>

func noinline mut text.fill() {
    var i = 0
    loop {
        if i == array_length(self.array) break
        self.array[i] = 1
        i = i + 1
    }
    self.len = i
}

func main() {
    var a = text2
    var b = text4
    a.fill()
    b.fill()
    exit(a.len + b.len)
}
