# an array copy in an inlined body on rv32i: the version that folds the
# indexed arguments into registers runs out of registers inside the copy and
# leaves no bulk registers behind

type row {v i32[4]}
var rows = row[4]
var rows2 = row[4]
var arr = i32[8]
func f(a row, b mut row, p0 i32, p1 i32, p2 i32, p3 i32, p4 i32, p5 i32, p6 i32, p7 i32, p8 i32, p9 i32, p10 i32) {
    array_copy(a.v, b.v, ((p0 + 1) + (p1 + 1) + (p2 + 1) + (p3 + 1) + (p4 + 1) + (p5 + 1) + (p6 + 1) + (p7 + 1) + (p8 + 1) + (p9 + 1) + (p10 + 1)) - 11 + 1)
}
func main() {
    rows[1].v[0] = 7
    var j = 1
    var m = 2
    var k0 = 0
    var k1 = 0
    var k2 = 0
    var k3 = 0
    var k4 = 0
    var k5 = 0
    var k6 = 0
    var k7 = 0
    var k8 = 0
    var k9 = 0
    var k10 = 0
    f(rows[j], rows2[m], arr[k0], arr[k1], arr[k2], arr[k3], arr[k4], arr[k5], arr[k6], arr[k7], arr[k8], arr[k9], arr[k10])
    exit(rows2[2].v[0])
}
