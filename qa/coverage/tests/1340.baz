# a folded conversion passed to an inlined function is a value of the type of
# the parameter, its unary ops apply at that type
func f(p i8) res i16 {
    res = p
}

func main() {
    var r = f(-i8(-128))
    if r == 128 {
        exit(1)
    }
    if r != -128 {
        exit(2)
    }
    exit(0)
}
