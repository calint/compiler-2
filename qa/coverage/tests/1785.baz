# a 'continue' in skipped code does not reach the counter step of a 'foo'
func stop(m) res {
    if m >= 3 exit(m)
    res = 0
}

func g(k) {
    var a = [4]
    foo a {
        if 1 == 2 {
            continue
        }
        var t = stop(k)
    }
    a[k] = 1
}

func main() {
    g(5)
    exit(1)
}
