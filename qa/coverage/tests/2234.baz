# the sector -1 is the last sector 2^32 - 1 of a card of 2 TB, which a count
# of the sectors in 32 bits would leave out

dat newline = "\n"

func main() {
    var bytes = i8[512]
    bytes[0] = 'o'
    bytes[1] = 'k'
    sector_write(-1, bytes)
    bytes[0] = 0
    sector_read(-1, bytes)
    write(1, bytes, 2)
    write(1, newline)
}
