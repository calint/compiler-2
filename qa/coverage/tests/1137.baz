# the innermost declaration of a name wins, a constant or a variable

var n = 5
let m = 3

func main() {
    # a constant hides a global variable
    let n = 3
    if n != 3 {
        exit(1)
    }
    # a variable hides a global constant
    var m = 5
    if m != 5 {
        exit(2)
    }
    var k = 5
    if k == 5 {
        # a constant hides a variable of an outer block
        let k = 3
        if k != 3 {
            exit(3)
        }
    }
    exit(0)
}
