# all functions are inlined

# single statement blocks can ommit braces

func assert(expr bool) { if not expr exit(1) }

# built-in 'read' and 'write' interface with the OS

func print(str i8[], len) {
    write(1, str, len)
}

func input(str i8[], len) nbytes {
    nbytes = read(0, str, len)
}

type str {
    len i8,
    data i8[127]
}

func str_in(mut s str) {
    var nbytes = read(0, s.data, array_length(s.data))
    s.len = i8(nbytes - 1)
} 

func str_out(s str) {
    write(1, s.data, s.len)
} 

type list {
    len i8,
    data i8[127]
}

type exit {
    name str,
    to i8
}

type object {
    name str
}

type entity {
    name str,
    location i8,
    inventory list
}

type location {
    name str,
    note str,
    entities list,
    objects list,
    exits list
}

func foozi(src location, mut dst location) {
    dst.name = {src.name.len, src.name.data}
    dst.note = src.note
}

func main() {
    var locations = location[128]{}
    var entities = entity[128]{}
    var exits = exit[1024]{}

    locations[0].name.data[1] = 0x61

    foozi(locations[0], locations[1])
    assert(locations[1].name.data[1] == 0x61)

}
