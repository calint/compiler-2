# the check of a body without its calls rejects an inlined recursion that an
# instance drives beside a constant argument: an instance folds at no call, so
# every call passes the nesting limit, before the narrowing after it

type point { x, y }

func f(p point, k) {
    if p.x <= 0 {
        return
    }
    var q = point{p.x - 1, p.y}
    f(q, 2)
    var w = i16(300)
    var b = i8(0)
    b = w
}

func main() {
    exit(0)
}
