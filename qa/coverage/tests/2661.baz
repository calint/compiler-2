# a call result reached into is not the whole argument, it tells no type
# parameter and is rejected as in a call without type parameters

type point {x i8, y}

func mk() res point {
    res = {}
}

func twice<T type>(x T) res int {
    res = int(x) * 2
}

func main() {
    exit(twice(mk().x + 1))
}
