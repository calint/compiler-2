# constant counts up to the end of the array are accepted

func assert(code, condition bool) {
    if not condition exit(code)
}

func main() {
    var a = i8[]{1, 2, 3, 4}
    var b = i8[4]{}
    array_copy(a[2], b[2], 2)
    assert(1, b[2] == 3 and b[3] == 4)
    array_copy(a, b, 4)
    assert(2, arrays_equal(a, b, 4))
    assert(3, arrays_equal(a[1], b[1], 3))
    var s = 0
    foo a, 4 {
        s = s + e
    }
    assert(4, s == 10)
    exit(0)
}
