dat hello[] i8="hello\n"
dat world[] i8="world\n"

func print(str[] i8, len) {
    write(1, str, len)
}

func foozi(world[] i8){
    var len=array_size_of(world)
    print(world,len-1)
}

func bar(n,hello[] i8){
    var i=n
    loop{
        var b=2
        if n==0 break
        print(hello,array_size_of(hello)-n)
        n=n-1
        i=i-1
        b=b-1
    }
}

func main(){
    var a=2
    foozi(world)
    bar(a+2,hello)
    exit(0)
}
