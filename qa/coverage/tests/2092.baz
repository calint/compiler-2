# the check of a body without its calls checks the body of a 'foo' whose
# count runs out of registers on x86_64 ('h'), so the swap in it is
# rejected on every target

func h(a i32) res i32 {
    var x0 = a
    var x1 = a
    var x2 = a
    var x3 = a
    var x4 = a
    var x5 = a
    var x6 = a
    var x7 = a
    var x8 = a
    var x9 = a
    var x10 = a
    var x11 = a
    var x12 = a
    res = x12 + (x11 + (x10 + (x9 + (x8 + (x7 + (x6 + (x5 + (x4 + (x3 + (x2 + (x0 / x1)))))))))))
}

type point { x, y }

func f(q i32) {
    var a = i8[4]
    foo a, h(q) {
        var p = point{1, 2}
        p = {p.y, p.x}
    }
}

func main() {
