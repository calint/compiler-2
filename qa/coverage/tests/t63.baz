
func print(str[] i8, len) {
    write(1, str, len)
}

func input(str[] i8, len) nbytes {
    nbytes = read(0, str, len)
}

dat   hello[] i8 = "hello world from baz\n"
dat   input[] i8 = "............................................................"
dat prompt1[] i8 = "enter name:\n"
dat prompt2[] i8 = "that is not a name.\n"
dat prompt3[] i8 = "hello "
dat     dot[] i8 = "."
dat      nl[] i8 = "\n"

func main(){

    print(hello, array_length(hello))
    loop {
        print(prompt1, array_length(prompt1))
        var len = input(input, array_length(input)) - 1    # -1 don't include the '\n'
        if len == 0 {
            break
        }
        if len <= 4 {
            print(prompt2, array_length(prompt2))
            continue
        }
        print(prompt3, array_length(prompt3))
        print(input, len)
        print(dot, array_length(dot))
        print(nl, array_length(nl))
    }
}
