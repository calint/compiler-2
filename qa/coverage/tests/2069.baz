# the check of a body without its call expands an inlined recursion that a
# constant argument ends beside one that does not fold, 'f(x, k + 1)' of the
# 'f(p, 0)' of 'h(p)' reaches 'a[4]'

func f(x, k) res {
    var a = i8[4]
    if k < 6 {
        res = x + a[k] + f(x, k + 1)
        return
    }
    res = 0
}

func h(p) res {
    res = f(p, 0)
}

func main() {
    exit(0)
}
