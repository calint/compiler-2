# the check of a body without its call goes on after an inlined recursion
# that an unsized array ends, to the 'h(3)' after it

func g(n, s i8[]) res {
    if n >= array_length(s) {
        res = 0
        return
    }
    res = s[n] + g(n + 1, s)
}

func h(k) res {
    var a = i8[2]
    res = a[k]
}

func f(t i8[]) res {
    res = g(0, t)
    res = res + h(3)
}

func main() {
    exit(0)
}
