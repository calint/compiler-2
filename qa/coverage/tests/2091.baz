# the check of a body without its calls checks the branches of an 'if'
# whose condition runs out of registers on x86_64 ('h'), so the swap in the
# 'else' that the call 'f(1)' skips is rejected on every target

func h(a i32) res i32 {
    var x0 = a
    var x1 = a
    var x2 = a
    var x3 = a
    var x4 = a
    var x5 = a
    var x6 = a
    var x7 = a
    var x8 = a
    var x9 = a
    var x10 = a
    var x11 = a
    var x12 = a
    res = x12 + (x11 + (x10 + (x9 + (x8 + (x7 + (x6 + (x5 + (x4 + (x3 + (x2 + (x0 / x1)))))))))))
}

type point { x, y }

func f(q i32) {
    if q == 1 {
    } else if h(q) == 1 {
    } else {
        var p = point{1, 2}
        p = {p.y, p.x}
    }
}

func main() {
    f(1)
}
