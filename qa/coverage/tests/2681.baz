# a method called on its type tells no type parameter, it is rejected as in a
# call without type parameters, not made an instance of the type

type point {x i8, y}

func point.get() res i8 {
    res = self.x
}

func first<T type>(x T) res int {
    res = x.len
}

func main() {
    exit(first(point.get()))
}
