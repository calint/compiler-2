# the check of a body without its call goes on after an inlined recursion
# that an instance drives, a constant argument does not end it, to the
# narrowing after it

type point { x, y }

func f(p point, k) {
    if p.x <= 0 {
        return
    }
    var q = point{p.x - 1, p.y}
    f(q, 2)
    var w = i16(300)
    var b = i8(0)
    b = w
}

func main() {
    exit(0)
}
