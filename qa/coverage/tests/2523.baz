# a quotient and remainder by the minimum i32 divide the magnitudes unsigned

func noinline quotient(a, b) res {
    res = a / b
}

func noinline remainder(a, b) res {
    res = a % b
}

func main() {
    if not quotient(7, -2147483648) == 0 exit(1)
    if not remainder(7, -2147483648) == 7 exit(2)
    if not quotient(-2147483648, -2147483648) == 1 exit(3)
}
