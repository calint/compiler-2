# all functions are inlined

func assert(expr bool) {
    if not expr exit(1)
}

# user types are defined using keyword `type`

type point {x, y}
type polygon {nindices, indices i8[8]}
type object {pos point, pgons polygon[8], color i32}

func main() {
    var o = object[1]{}
    o[0].pgons[3].nindices = 4
    o[0].pgons[3].indices[3] = 7

    assert(o[0].pgons[3].indices[3] == 7)
    assert(o[0].pgons[3].nindices == 4)

    o[0].pgons[0].indices[0] = 1
    assert(o[0].pgons[0].indices[0] == 1)
}
