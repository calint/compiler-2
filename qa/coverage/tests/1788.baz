# the methods of an alias's levels are made in the order they are defined,
# so a method does not see one of another level defined after it
type list<T type, n> { a T[n], len }
type text<n> = list<i8, n>

func text.t() res {
    res = self.l()
}

func list.l() res {
    res = 7
}

type str = text<4>

func main() {
    var s = str
    exit(s.t())
}
