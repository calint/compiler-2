# a constant count of records is past the end of an unsized array parameter
# of any size once its bytes reach the 4 GiB that rv32i addresses, one less
# is accepted; x86_64 addresses more

type block {a i8[0x100000]}

func f(a block[], b mut block[]) res bool {
    array_copy(a, b, 0xfff)
    res = arrays_equal(a, b, 0x1000)
}

func main() {
}
