dat hello[] i8="hello\n"
dat world[] i8="world\n"

func print(str[] i8, len) {
    write(1, str, len)
}

func bar(a,b,hello[] i8){
    loop{
        if b==0 return
        print(hello,array_length(hello))
        b=b-1
    }
}

func foozi(world[] i8){
    print(world,array_length(world))
}

func main(){
    var a=1
    var b=2
    var c=3
    bar(a,b,hello)
    foozi(world)
    exit(0)
}
