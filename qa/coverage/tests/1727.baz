# the buffer of 'write' is computed before the count: the call in the buffer
# argument reads 'n' before the call in the count writes it
type s { buf i8[4], }

var n = 0

func h() res {
    res = n
}

func f() res {
    n = n + 1
    res = 2
}

func main() {
    var a = s[2]
    a[0].buf = {'A', '\n', 0, 0}
    a[1].buf = {'B', '\n', 0, 0}
    var k = write(1, a[h()].buf, f())
    exit(k - 2)
}
