# the registers an expression holds survive a 'write' and the sector functions
# of a function inlined in it, e.g. 'r10' and 'r11' on x86_64

func out(c i8) res {
    var b = i8[1]{ c }
    res = write(1, b)
}

func card(c i8) res {
    var b = i8[512]
    b[0] = c
    sector_write(1, b)
    b[0] = 0
    sector_read(1, b)
    res = b[0]
}

func main() {
    var a = 1
    var n = a + (a + (a + (a + (a + (a + (a + (a + (a + out('x')))))))))
    var k = a + (a + (a + (a + (a + (a + (a + (a + card(7))))))))
    if not n == 10 exit(1)
    exit(k)
}
