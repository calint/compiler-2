func assert(expr bool) {
    if not expr exit(1)
}

func print(str[] i8, len) {
    write(1, str, len)
}

func input(str[] i8, len) nbytes {
    nbytes = read(0, str, len)
}

type string {
    len,
    data[64] i8
}

type location {
    name string
}

func main() {
    var locations[4] location

    var i = 0
    loop {
      locations[i].name.len = input(locations[i].name.data, array_length(locations[i].name.data))
      i = i + 1
      if i == 4 break
    }

    i = 0
    loop {
      print(locations[i].name.data, locations[i].name.len)
      i = i + 1
      if i == 4 break
    }
}
