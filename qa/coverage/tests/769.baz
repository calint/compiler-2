# a non-inline body uses its array parameter like an inline one

type pt {
    x i32,
    y i32,
}

func inline_sum(v i32[]) res i32 {
    res = 0
    foo v {
        res = res + e
    }
}

func noinline via_inline(v i32[]) res i32 {
    res = inline_sum(v)
}

func noinline copy_all(src i32[], dst mut i32[]) {
    array_copy(src, dst, array_length(src))
}

func noinline zero_it(v mut i32[]) {
    v = {}
}

func noinline assign(dst mut i32[], src i32[]) {
    dst = src
}

func noinline at(v i32[], ix i32) res i32 {
    res = v[ix]
}

func noinline last(v i32[]) res i32 {
    res = v[array_length(v) - 1]
}

func noinline sum_pts(ps pt[]) res i32 {
    res = 0
    foo ps {
        res = res + e.x + e.y
    }
}

func noinline set_pt(ps mut pt[], ix i32) {
    ps[ix].x = 70
    ps[ix].y = 80
}

func noinline twice(v i32[], w i32[]) res i32 {
    var s = via_inline(v)
    var t = via_inline(w)
    res = s + t
}

func main() {
    var a = i32[3]{ 1, 2, 3 }
    var b = i32[5]{ 1, 2, 3, 4, 5 }
    var r = i32(0)

    r = via_inline(a)
    if r != 6 exit(11)
    r = via_inline(b)
    if r != 15 exit(12)

    var c = i32[3]{}
    copy_all(a, c)
    if c[0] != 1 or c[2] != 3 exit(13)

    zero_it(c)
    if c[0] != 0 or c[2] != 0 exit(14)

    assign(c, a)
    if c[1] != 2 exit(15)

    var ix = i32(1)
    r = at(a, ix)
    if r != 2 exit(16)
    ix = 4
    r = at(b, ix)
    if r != 5 exit(17)

    r = last(a)
    if r != 3 exit(18)
    r = last(b)
    if r != 5 exit(19)

    var ps = pt[2]{ { 1, 2 }, { 3, 4 } }
    r = sum_pts(ps)
    if r != 10 exit(20)
    ix = 1
    set_pt(ps, ix)
    if ps[1].x != 70 or ps[1].y != 80 exit(21)
    r = sum_pts(ps)
    if r != 1 + 2 + 70 + 80 exit(22)

    r = twice(a, b)
    if r != 21 exit(23)
}
