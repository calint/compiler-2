# the count of 'arrays_equal' is computed before the arrays, a call in an array
# argument that writes what the count reads is rejected
var n = 1

func g() res {
    n = 3
    res = 0
}

func main() {
    var a = i8[4]
    var b = i8[4]
    if arrays_equal(a, b[g()], n) {
        exit(1)
    }
    exit(0)
}
