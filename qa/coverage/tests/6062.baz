# rv32i: a remainder into the temporary of a noinline call argument takes a
# register for its result while the helper keeps only its first argument;
# with a second register kept the scratch registers would run out, see 7120

func noinline f(p i32) res i32 {
    res = p + 1
}

func main() {
    var a = i32(7)
    var b = i32(3)
    # note: the nesting holds every scratch register up to 'a7'
    var r = b + (a + (b + (a + (b + (a + (b + (a + (b + (a + (b + (a + (b + (a + (b + (a + (b + (a + (b + (a + (b + (a + (b + (a + (b + (a + (b + f(a % (b ^ a))))))))))))))))))))))))))))
    exit(i8(r - 100))
}
