# nested struct fields

dat fld=42
dat str[] i8="hello world"

type vector{x,y}
type object{pos vector,vel vector,color}

func f(str[] i8,fld){
    var obj object={{1,0},{0,0},0}
    if not obj.pos.x==1 exit(1)
    obj.pos.x=1
    obj.pos.y=2
    obj.vel.x=4
    obj.vel.y=8
    obj.color=array_length(str)
    
    if not fld==42 exit(2)
    if not obj.pos.x==1 exit(3)
    if not obj.pos.y==2 exit(4)
    if not obj.vel.x==4 exit(5)
    if not obj.vel.y==8 exit(6)
    if not obj.color==array_length(str) exit(7)
}

func main(){
    var obj object={{1,0},{0,0},0}
    if not obj.pos.x==1 exit(1)
    obj.pos.x=1
    obj.pos.y=2
    obj.vel.x=4
    obj.vel.y=8
    obj.color=array_length(str)
    
    if not fld==42 exit(2)
    if not obj.pos.x==1 exit(3)
    if not obj.pos.y==2 exit(4)
    if not obj.vel.x==4 exit(5)
    if not obj.vel.y==8 exit(6)
    if not obj.color==array_length(str) exit(7)
    
    f(str,fld)
    exit(0)
}
