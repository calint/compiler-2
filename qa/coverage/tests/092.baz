func assert(expr bool) {
    if not expr exit(1)
}

func print(str[] i8, len) {
    write(1, str, len)
}

func input(str[] i8, len) nbytes {
    nbytes = read(0, str, len)
}

type str_s {
    size i8,
    data[31] i8
}

type str_m {
    size i8,
    data[63] i8
}

type str_l {
    size i8,
    data[127] i8
}

type link {
    name str_s,
    to i32
}

type location {
    name str_s,
    links[8] link
}

func main() {
    var locations[8] location
    var i = 0
    loop {
        var len = 
            input(
                locations[i].name.data,
                array_length(locations[i].name.data)
            )
        locations[i].name.size = i8(len)
        i = i + 1
        if len <= 1 or i == array_length(locations) break
    }
   
    var j = 0
    loop {
        if j == i break
        var size = locations[j].name.size
        print(locations[j].name.data, size)
        j = j + 1
    }
}
