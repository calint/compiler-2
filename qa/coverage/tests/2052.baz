# the check of a body without its call does not expand an inlined recursion
# that the constant of 'g(x, 2)' ends: 'a[3 - n]' past the end at its second
# level is accepted where nothing calls 'f', a call of 'f' rejects it

func g(x, n) res {
    if n == 0 {
        res = 0
        return
    }
    var a = i8[2]
    res = a[3 - n] + g(x, n - 1)
}

func f(x) res {
    res = x + g(x, 2)
}

func main() {
    exit(0)
}
