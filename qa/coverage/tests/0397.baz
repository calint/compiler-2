# a value literal assigned to an element at a run-time index names an array
# for the array field of the element: the array is copied into the field,
# then the scalar field after it is set from the next value; the sizes of
# the array and the field are the same

func assert(err, expr bool) { if not expr exit(err) }

type holder {
    values[2],
    tag
}

func main() {
    var src_values = [2]{31, 32}
    var holders = holder[2]

    var ix = 1
    holders[ix] = {src_values, 9}

    assert(1, ix == 1)
    assert(2, holders[1].values[0] == 31)
    assert(3, holders[1].values[1] == 32)
    assert(4, holders[1].tag == 9)
}
