# x86_64: '==' of 16 bytes compares with two 'cmpsq' and does not take 'rcx',
# the count register of 'repe cmpsq': the script prints the lines of the
# compare that name 'rcx'
type pt {x, y}

func main() {
    var p = pt{1, 2}
    var q = pt{1, 2}
    if p == q {
        exit(1)
    }
    exit(0)
}
