        pad = pad + 1
        pad = pad + 1
        pad = pad + 1
        pad = pad + 1
        pad = pad + 1
        pad = pad + 1
        pad = pad + 1
        pad = pad + 1
        pad = pad + 1
        pad = pad + 1
        pad = 0
        k = k + 1
        if k == 3 break
        if k != 2 continue
        visits = visits + 1
    }
    if visits != 2 exit(1)
    exit(visits + 3)
}
