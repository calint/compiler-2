# 'alias' (on by default): the element 'e' of a 'foo' inside the element of another 'foo'
# reads the same field of the outer array, which can be the element itself
# the value is computed before the destination is written

type item {
    data i32[2],
    other i32,
}

func main() {
    var items = item[2]
    items[0].data[1] = 1

    foo items {
        foo e.data {
            e = e + items[0].data[1]
        }
    }
    exit(items[0].data[1] + items[1].data[0] - 4)
}
