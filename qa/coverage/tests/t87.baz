func assert(expr bool) {
    if not expr exit(1)
}

func print(str[] i8, len) {
    write(1, str, len)
}

func input(str[] i8, len) nbytes {
    nbytes = read(0, str, len)
}

type location {
    name[64] i8,
    name_len
}

dat nl_str[] i8 = "\n"

func nl() {
    print(nl_str, array_size_of(nl_str))
}

func pn(num) {
    var buf[20] i8
    var n = num
    var is_negative bool = false

    if n < 0 {
        is_negative = true
        n = -n
    }

    var i = 20
    loop {
        i = i - 1
        var ascii = 48 + (n % 10)
        buf[i] = i8(ascii)
        # note: not buf[i] = 48 + ... because operation is done in byte sized
        #       with n overflows
        n = n / 10
        if n == 0 break
    }

    if is_negative {
        i = i - 1
        buf[i] = 45  # '-'
    }

    write(1, buf, 20 - i, i)
}

func main() {
    var locations[4] location

    var i = 0
    loop {
      locations[i].name_len = input(locations[i].name, array_size_of(locations[i].name))
      pn(locations[i].name_len)
      nl()
      print(locations[i].name, locations[i].name_len)
      nl()
      i = i + 1
      if i == 4 break
    }

    i = 0
    loop {
      pn(locations[i].name_len)
      nl()
      print(locations[i].name, locations[i].name_len)
      nl()
      i = i + 1
      if i == 4 break
    }
}
