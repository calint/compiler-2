# a negated operand that is also the destination is read before a leading constant is stored: 'n = -n + 1'

type counter {
    n,
}

func mut counter.bump() {
    self.n = -self.n + 1
}

func main() {
    var n = 5
    n = -n + 1
    if n != -4 exit(1)

    n = -n - 3
    if n != 1 exit(2)

    var c = counter{5}
    c.bump()
    if c.n != -4 exit(3)
}
