# the array of a 'foo' is addressed once: an index of its path that the body
# changes, also through a 'mut' parameter, moves no element
type row {xs i32[2]}
func f(rs mut row[], k mut) {
    foo rs[k].xs {
        k = k + 1
        e = 7
    }
}
func main() {
    {
        var rs = row[2]
        var k = 0
        foo rs[k].xs {
            k = 100
            e = 7
        }
        if rs[0].xs[0] != 7 exit(1)
        if rs[0].xs[1] != 7 exit(2)
    }
    var rs = row[2]
    var k = 0
    f(rs, k)
    if rs[0].xs[0] != 7 exit(5)
    if rs[0].xs[1] != 7 exit(6)
    if rs[1].xs[0] != 0 exit(7)
    if k != 2 exit(8)
}
