func assert(exit, expr bool) {
    if not expr exit(exit)
}

func inv(i i32) res i32 {
    res = ~i
}

func main() {
    var arr = i32[4]{}

    arr[1] = ~2
    arr[2] = ~arr[1]
    arr[3] = 1

    var ix = 3

    # note: temporary because the result may share storage with the argument
    var tmp1 = inv(arr[ix])
    arr[ix-2] = tmp1
    assert(1, arr[1] == ~1)
}
