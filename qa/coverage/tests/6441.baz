# the start of a bulk operand at a constant index of an unsized array reaches
# from that element on: 'f' writes 'a[1]' and later elements, not the
# 'g[0].y' it reads, so the call with 'g' is accepted

type pt {x, y}

var g = pt[3]{{1, 2}, {3, 4}, {5, 6}}

func noinline f(a mut pt[]) {
    array_copy(a[2], a[1], 1)
    a[2].x = g[0].y
}

func main() {
    f(g)
    exit(g[1].x * 10 + g[2].x)
}
