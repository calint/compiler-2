# arrays_equal compares indexed byte ranges

func assert(x bool) { if not x exit(1) }
func main() {
    var a = i8[4]{9, 1, 2, 7}
    var b = i8[4]{8, 1, 2, 6}
    var z = arrays_equal(a[1],b[1],2)
    assert(z)
    assert(not arrays_equal(a[0], b[0], 2))
    assert(not arrays_equal(a[2], b[2], 2))
}
