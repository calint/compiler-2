# a global reaches a global named by a callee through two non-inline calls
# with '--checks=-alias', which otherwise rejects the call first: the
# function uses the global the call passes it

var g = 2

func swap_values(x mut, y mut) {
    var tmp = x
    x = y
    y = tmp
}

func noinline outer(a mut) {
    swap_values(a, g)
}

func noinline middle(b mut) {
    outer(b)
}

func main() {
    middle(g)
}
