# disjoint elements forwarded through parameters do not share storage

func assert(err, ok bool) { if not ok exit(err) }

func copy_over(dst mut i32, src mut i32) {
    dst = src
    src = 0
}

func forward(a mut i32, b mut i32) {
    copy_over(a, b)
}

func main() {
    var arr = i32[4]
    arr[1] = 7
    forward(arr[0], arr[1])
    assert(1, arr[0] == 7)
    assert(2, arr[1] == 0)
}
