# with the overflow check, logic constants wider than an immediate and the
# subtraction of the immediate minimum
func main() {
    var x = 3000
    x = x + -2048
    x = x - -2048
    var y = x & 6144
    if y != 2048 exit(3)
    var z = x | 8192
    if z != 11192 exit(4)
    var w = x ^ 10240
    if w != 9144 exit(5)
    exit(x - 2998)
}
