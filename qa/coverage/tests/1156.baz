# the body of a 'noinline' function has its own registers, the variables base
# and the frame base are not handed out

func noinline f() {
    var a = 1
    var b = a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + (a + a)))))))))))))))))))))))))))))
    exit(b)
}

func main() {
    f()
}
