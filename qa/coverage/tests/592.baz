# rv32i zero, copy and compare loops at an address inside a word take a byte
# and a halfword head up to the loop width when every address is the same
# distance from it; a run-time count may end within the head

func assert(err, expr bool) { if not expr exit(err) }

type rgb { r i8, g i8, b i8 }

type pixel { fg rgb, bg rgb, alpha i8, depth i8 }

func check_zero(err, z mut i8[]) {
    var i = 0
    loop {
        if i == array_length(z) break
        assert(err, z[i] == 0)
        z[i] = i8(i + 1)
        i = i + 1
    }
}

func fill(a mut i8[]) {
    var i = 0
    loop {
        if i == array_length(a) break
        a[i] = i8(i + 1)
        i = i + 1
    }
}

# the first 'n' bytes of 'b' match 'a' and the rest is still zero
func check_copy(err, a i8[], b i8[], n) {
    var i = 0
    loop {
        if i == array_length(b) break
        if i < n {
            assert(err, b[i] == a[i])
        } else {
            assert(err, b[i] == 0)
        }
        i = i + 1
    }
}

# every count from 0 to the array size, including counts that end within
# the head
func check_counts(err, a i8[], b mut i8[]) {
    var n = 0
    loop {
        if n > array_length(b) break
        var i = 0
        loop {
            if i == array_length(b) break
            b[i] = 0
            i = i + 1
        }
        array_copy(a, b, n)
        check_copy(err, a, b, n)
        assert(err, arrays_equal(a, b, n))
        if n > 0 {
            b[n - 1] = 0
            assert(err, not arrays_equal(a, b, n))
            assert(err, arrays_equal(a, b, n - 1))
        }
        n = n + 1
    }
}

func noinline check_frame(rounds) {
    var round = 0
    loop {
        if round == rounds break

        # both 3 B past a word boundary: a byte head then words
        var pad1 = i8[3]{}
        var a1 = i8[9]{}
        var pad2 = i8[3]{}
        var b1 = i8[9]{}
        fill(a1)
        check_counts(10, a1, b1)

        # 1 and 3 B past a word boundary: a byte head then halfwords
        var pad3 = i8(0)
        var a2 = i8[7]{}
        var pad4 = i8[3]{}
        var b2 = i8[7]{}
        fill(a2)
        check_counts(11, a2, b2)

        round = round + 1
    }
}

func main() {
    var rounds = 2
    var round = 0
    loop {
        if round == rounds break

        # 1, 3 and 2 B past a word boundary: zero loops after a head
        var pad1 = i8(0)
        var z1 = i8[80]{}
        var pad2 = i8[2]{}
        var z2 = i8[80]{}
        var pad3 = i8[3]{}
        var z3 = i8[80]{}
        check_zero(1, z1)
        check_zero(2, z2)
        check_zero(3, z3)

        # both 1 B past a word boundary: a copy of a known size and a
        # comparison take a 3 B head
        var pad4 = i8[3]{}
        var a1 = i8[40]{}
        var pad5 = i8[4]{}
        var b1 = i8[40]{}
        var after = i8(5)
        fill(a1)
        array_copy(a1, b1, 40)
        check_copy(4, a1, b1, 40)
        assert(5, after == 5)
        assert(6, pad4[2] == 0 and pad5[0] == 0 and pad5[3] == 0)

        var pad6 = i8[3]{}
        var p = pixel{{1, 2, 3}, {4, 5, 6}, 7, 8}
        var pad7 = i8[4]{}
        var q = p
        assert(7, equal(p, q))
        q.fg.r = 0
        assert(8, not equal(p, q))
        q = p
        q.depth = 0
        assert(9, not equal(p, q))

        # both 2 B past a word boundary: a halfword head then words
        var pad8 = i8(0)
        var a2 = i8[9]{}
        var pad9 = i8[3]{}
        var b2 = i8[9]{}
        fill(a2)
        check_counts(12, a2, b2)

        round = round + 1
    }

    check_frame(rounds)
}
