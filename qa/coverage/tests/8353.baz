# a 'continue' ends its path: a branch that continues need not set the result
# for the 'break' after the 'if'
func f() res {
    var k = 0
    loop {
        k = k + 1
        if k < 3 {
            continue
        } else {
            res = k
        }
        break
    }
}

func main() {
    exit(f())
}
