# a 'bool' element that starts a line keeps the whitespace and comments before
# it in the reproduced source, as a number does
type flags { f bool[2] }

dat d = bool[2]{
    # first
    true,
    false}

func main() {
    var t = true
    var a = bool[]{true,
      false}
    var b = bool[]{
        t, false}
    var r = flags{{
        false,
        t}}
    if a[0] and d[0] and b[0] and r.f[1] {
        exit(3)
    }
    exit(0)
}
