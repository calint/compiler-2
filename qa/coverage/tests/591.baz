# rv32i unrolled zero, copy and constant stores at an address inside a word
# take a byte and a halfword up to the word boundary, then words and a tail;
# a copy between different positions within a word keeps smaller accesses

func assert(err, expr bool) { if not expr exit(err) }

type rgb { r i8, g i8, b i8 }

type pixel { fg rgb, bg rgb, alpha i8, depth i8 }

func check_zero(err, z mut i8[]) {
    var i = 0
    loop {
        if i == array_length(z) break
        assert(err, z[i] == 0)
        z[i] = i8(i + 1)
        i = i + 1
    }
}

func check_text(err, s i8[]) {
    var i = 0
    loop {
        if i == array_length(s) break
        assert(err, s[i] == i8('a' + i))
        i = i + 1
    }
}

func noinline check_frame(n) {
    var round = 0
    loop {
        if round == n break

        # declarations zero again each round after the checks wrote them
        var pad1 = i8(0)
        var z1 = i8[20]{}
        var pad2 = i8(0)
        var z2 = i8[7]{}
        var pad3 = i8[2]{}
        var z3 = i8[13]{}
        check_zero(10, z1)
        check_zero(11, z2)
        check_zero(12, z3)
        pad1 = 1
        pad2 = 2
        pad3[1] = 3

        var t1 = "abcdefghijk"
        var pad4 = i8(0)
        var t2 = "abcdef"
        check_text(13, t1)
        check_text(14, t2)
        assert(15, pad4 == 0)

        var c1 = i8[11]{}
        array_copy(t1, c1, 11)
        check_text(16, c1)

        round = round + 1
    }
}

func main() {
    var pad1 = i8(0)
    var z1 = i8[20]{}
    var pad2 = i8[2]{}
    var z2 = i8[15]{}
    check_zero(20, z1)
    check_zero(21, z2)
    assert(22, pad1 == 0)
    assert(23, pad2[0] == 0 and pad2[1] == 0)

    # different positions within a word: 's0 + 39' to 's0 + 56'
    var pad3 = i8(0)
    var s1 = "abcdefghijklm"
    var pad4 = i8[4]{}
    var d1 = i8[13]{}
    array_copy(s1, d1, 13)
    check_text(24, s1)
    check_text(25, d1)
    assert(26, pad3 == 0 and pad4[0] == 0 and pad4[3] == 0)

    # same position within a word: 's0 + 39' to 's0 + 71'
    var pad5 = i8[2]{}
    var d2 = i8[13]{}
    array_copy(s1, d2, 13)
    check_text(27, d2)
    assert(28, pad5[0] == 0 and pad5[1] == 0)

    var p = pixel{{1, 2, 3}, {4, 5, 6}, 7, 8}
    var pad6 = i8(0)
    var q = p
    assert(29, equal(p, q))
    assert(30, pad6 == 0)

    var s2 = "abcde"
    check_text(31, s2)

    var rounds = 3
    check_frame(rounds)
}
