# a condition stored in an inlined result that a later element reads, the
# result is written after all elements are read
func f(x int) res bool {
    res = false
    res = x == 1 and res
}

func g(x int, v bool) res bool {
    res = x == 1 and v
}

func h(x int) res bool {
    res = false
    res = g(x, res)
}

func main() {
    var n = 0
    if f(1) {
        n = n + 1
    }
    if h(1) {
        n = n + 2
    }
    if not f(1) {
        n = n + 4
    }
    exit(n)
}
