# a copy of no elements whose source starts at a run-time element of the
# destination copies nothing and needs no overlap check
func main() {
    var a = i8[4]
    a[0] = 1
    var k = 1
    array_copy(a, a[k], 0)
    var b = i8[4]
    if not arrays_equal(a, b[k], 0) {
        exit(1)
    }
    exit(a[0])
}
