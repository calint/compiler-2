# on rv32i the sector -1 is the last sector 2^32 - 1 of a card of 2 TB, the
# routine of the system calls counts its sectors in 32 bits

dat newline = "\n"

func main() {
    var bytes = i8[512]
    bytes[0] = 'o'
    bytes[1] = 'k'
    sector_write(-1, bytes)
    bytes[0] = 0
    sector_read(-1, bytes)
    write(1, bytes, 2)
    write(1, newline)
}
