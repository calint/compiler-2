# a run-time index of an unsized array parameter may be any element, so it
# shares storage with a constant element of the same array

func swap(a mut i8, b mut i8) {
    var t = a
    a = b
    b = t
}

func f(p mut i8[], i) {
    swap(p[i], p[1])
}

func main() {
    var a = i8[4]
    a[1] = 7
    f(a, 1)
    exit(a[1])
}
