# the address of a place with a run-time index is held in a register across a
# later argument that calls a noinline function, and the callee writes through
# it
var g = 0

func noinline idx() res {
    res = 2
}

func noinline k(x) res {
    g = g + x
    res = x * 2
}

func noinline put(a mut, n) {
    a = a * 10 + n
}

func main() {
    var v = []{1, 2, 3}
    var i = idx()
    put(v[i], k(4))
    exit(v[2] + g)
}
