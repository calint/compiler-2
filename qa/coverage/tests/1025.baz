# a variable named like a scratch register is not the storage of an argument that is computed into that register

func sum(a, b) res {
    res = b + a
}

func main() {
    var r = 1
    var t0 = sum(r + 1, r + 2)
    var t1 = sum(r + 3, r + 4)
    var r14 = sum(r + 5, r + 6)
    var r15 = sum(r + 7, r + 8)
    if t0 != 5 exit(1)
    if t1 != 9 exit(2)
    if r14 != 13 exit(3)
    if r15 != 17 exit(4)
    exit(0)
}
