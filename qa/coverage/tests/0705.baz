# an error in a method body names the method call
# with '--checks=-alias', which otherwise rejects the call first: the
# function uses the global the call passes it

type point {
    x,
    y
}

var g = point{1, 2}

func point.bad(v) {
    g = {v + self.x, g.x}
}

func main() {
    var p = point{1, 2}
    p.bad(g.y)
}
