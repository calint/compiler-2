# a variable named like a scratch register is not taken for a read of that
# register: the list needs no extra scratch register and is accepted

func main() {
    var a = 1
    var b = 2
    var c = 3
    var d = 4
    var e = 5
    var f = 6
    var g = 7
    var h = 8
    var i = 9
    var j = 10
    var k = 11
    var l = 12
    var m = 13
    var rax = 14
    var x = 0
    x = a - (a * b - (b * c - (c * d - (d * e - (e * f - (f * g - (g * h - (h * i - (i * j - (j * k - (k * l - (l * m - (m * rax - (rax * a))))))))))))))
    exit(x)
}
