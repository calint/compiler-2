# the generic type of a method names its instance like a type name does, so a
# 'foo' in the method may declare 'e' when the generic type is 'e'

type e<n> {
    v i8[n],
}

func e.sum() res int {
    res = 0
    foo self.v {
        res = res + e
    }
}

type e4 = e<4>

func main() {
    var b = e4
    b.v[1] = 2
    b.v[3] = 5
    exit(b.sum())
}
