# boolean assignment from comparisons, an integer is compared first

func assert(expr bool) { if not expr exit(1) }

func main() {
    var x = 1
    var y = 2

    var b = false

    b = x == 1
    assert(b)

    b = x != 0
    assert(b)
    
    b = x == 1 and y == 2
    assert(b)

    b = x == 1 or y == 2
    assert(b)
}
