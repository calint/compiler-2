func assert(expr bool) {
    if not expr exit(1)
}

func print(str[] i8, len) {
    write(1, str, len)
}

func input(str[] i8, len) nbytes {
    nbytes = read(0, str, len)
}

dat ok[] i8 = "ok\n"

func main() {
    var word1[64] i8
    var word2[64] i8

    print(ok, array_length(ok))

    # expect same word input for both
    var len1 = input(word1, array_length(word1))
    print(word1, len1)

    print(ok, array_length(ok))

    var len2 = input(word2, array_length(word2))
    print(word2, len2)
  
    assert(arrays_equal(word1, word2, len1))

    print(ok, array_length(ok))

    # expect not same word input for both
    len1 = input(word1, array_length(word1))
    print(word1, len1)

    print(ok, array_length(ok))
 
    len2 = input(word2, array_length(word2))
    print(word2, len2)
 
    assert(not arrays_equal(word1, word2, len1))

    print(ok, array_length(ok))
}
