# remove an input prefix with array_copy

func assert(expr bool) {
    if not expr exit(1)
}

func print(str[] i8, len) {
    write(1, str, len)
}

func input(str[] i8, len) nbytes {
    nbytes = read(0, str, len)
}

func main() {
    var inp[80] i8
    var len = input(inp, array_length(inp))
    len = len - 3
    array_copy (  inp[3]   ,    inp     ,      len       ) 
    print(inp, len)
}
