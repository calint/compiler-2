# the range of the destination is checked on its own: a copy of a run-time
# count whose source range fits and whose destination range from a run-time
# start passes the end panics

func main() {
    var a = i32[8]
    var b = i32[4]
    var i = 2
    var n = 2
    array_copy(a, b[i], n)
    n = 3
    array_copy(a, b[i], n)
}
