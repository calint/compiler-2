# a sector of 32 bits or less is its value modulo 2^32 on every target:
# 'i32(-2)' and 'i16(-2)' are the sector 2^32 - 2 of a card of 2 TB

dat newline = "\n"

func main() {
    var bytes = i8[512]
    var s = i32(-2)
    var h = i16(-2)
    bytes[0] = 'o'
    sector_write(s, bytes)
    bytes[0] = 0
    sector_read(h, bytes)
    bytes[1] = 'k'
    sector_write(h, bytes)
    bytes = {}
    sector_read(s, bytes)
    write(1, bytes, 2)
    write(1, newline)
}
