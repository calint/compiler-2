# constructors: 'func point.at(x, y) self' builds a 'point' in 'self' and is
# called as 'point.at(1, 2)'

func assert(err, ok bool) { if not ok exit(err) }

type point {
    x,
    y
}

type object {
    pos point,
    color
}

func point.at(x, y) self {
    self.x = x
    self.y = y
}

func point.origin() self {
    self = {0, 0}
}

func point.sum() res {
    res = self.x + self.y
}

# a constructor calling a constructor, fields assigned on every path
func object.at(x, y, color) self {
    self.pos = point.at(x, y)
    if color == 0 {
        self.color = 0xffffff
        return
    }
    self.color = color
}

# a method on a fully built 'self' is allowed
func point.diagonal(d) self {
    self.x = d
    self.y = d
    self.x = self.sum()
}

func noinline point.scaled(x, y, k) self {
    self.x = x * k
    self.y = y * k
}

func main() {
    # the type comes from the constructor
    var p = point.at(1, 2)
    assert(1, p.x == 1 and p.y == 2)

    var q = point.origin()
    assert(2, q.x == 0 and q.y == 0)

    p = point.at(3, 4)
    assert(3, p.x == 3 and p.y == 4)

    var ps = point[2]{}
    var i = 1
    ps[i] = point.at(5, 6)
    assert(4, ps[1].x == 5 and ps[1].y == 6)

    var o = object.at(7, 8, 0)
    assert(5, o.pos.x == 7 and o.pos.y == 8 and o.color == 0xffffff)

    var o3 = object[2]{}
    o3[1] = object.at(9, 10, 0xff)
    assert(6, o3[1].pos.y == 10 and o3[1].color == 0xff)

    # in an instance literal
    var o2 = object{point.at(11, 12), 13}
    assert(7, o2.pos.x == 11 and o2.color == 13)
    var p2 = point.at(11, 12)
    assert(8, equal(o2.pos, p2))

    o2.pos = point.at(14, 15)
    assert(9, o2.pos.sum() == 29)

    var d = point.diagonal(3)
    assert(10, d.x == 6 and d.y == 3)

    var x = 2
    var y = 3
    var k = 10
    var s = point.scaled(x, y, k)
    assert(11, s.x == 20 and s.y == 30)
    s = point.scaled(y, x, k)
    assert(12, s.x == 30 and s.y == 20)
}
