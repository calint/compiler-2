# a constant count 0 compares nothing, a start at the end of the array is
# accepted like in 'array_copy' and 'write'
func main() {
    var a = []{1, 2, 3, 4}
    var b = []{5, 6, 7, 8}
    var n = 0
    if arrays_equal(a[4], b, 0) {
        n = n + 1
    }
    if not arrays_equal(a, b[4], 0) {
        n = n + 2
    }
    var e = arrays_equal(a[4], b[4], 0)
    if e {
        n = n + 4
    }
    exit(n)
}
