# a 'mut bool' parameter writes the variable of the caller, inlined or not

func assert(ok bool) { if not ok exit(1) }

func set(b mut bool) {
    b = true
}

func noinline clear(b mut bool) {
    b = false
}

type flags { on bool }

func main() {
    var x = false
    set(x)
    assert(x)
    clear(x)
    assert(not x)
    var f = flags{false}
    set(f.on)
    assert(f.on)
    clear(f.on)
    assert(not f.on)
}
