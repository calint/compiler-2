# aliasing: the destination has two run-time indexes and the read one, the
# read is of the same field that the destination can select
# the value is computed before the destination is written
# with '--checks=-alias': the function uses the global the call passes it,
# which the alias check rejects

type item {
    f i32,
    g i32,
}

type ent {
    items item[2],
    other i32,
}

dat es = ent[3]

func put(x mut i32, k i32) {
    x = 100 - es[k].items[0].f
}

func main() {
    var i = 0
    var j = 0
    var k = i32(0)

    put(es[i].items[j].f, k)
    exit(es[0].items[0].f - 100)
}
