# --checks=alias: three nested 'foo' read the array the second one iterates,
# which can contain the element itself

type leaf {
    v i32[2],
}

type mid {
    leaves leaf[2],
    other i32,
}

func main() {
    var m = mid[2]

    foo m {
        foo e.leaves {
            foo e.v {
                e = e + m[0].leaves[1].v[0]
            }
        }
    }
}
