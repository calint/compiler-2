# a 'let' of an expression of constants is a constant: it can precede 'dat' and size an array

let base = 5
let sum = 2 * 3 + 1
let mixed = (base + 3) * 2 - -4
let bits = 7 & 3 | 8 ^ 1
let shifted = 1 << 3 + 1
let right = -64 >> 2 >> 1
let quotient = -7 / 2
let remainder = -7 % 4
let size = (1 + 2)
let two = sum - 5

dat data = i8[size]{1, 2, 3}

func main() {
    var arr = i8[two]
    var total = 0
    foo data { total = total + e }
    if sum != 7 exit(1)
    if mixed != 20 exit(2)
    if bits != 11 exit(3)
    if shifted != 9 exit(4)
    if right != -8 exit(5)
    if quotient != -3 exit(6)
    if remainder != -3 exit(7)
    if array_length(arr) != 2 exit(8)
    if total != 6 exit(9)
    exit(0)
}
