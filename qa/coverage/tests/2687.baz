# a product by the minimum of its width is a shift: the factor is classified
# at the width of the product, where it is a power of two; the instructions of
# the lines marked '# folds' are pinned
func main() {
    var a = i8(1)
    var b = i16(1)
    a = a * -128 # folds
    b = b * -32768 # folds
    if a != -128 or b != -32768 {
        exit(1)
    }
}
