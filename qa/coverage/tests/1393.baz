# an element of an array field of a literal is a destination of its own: a
# call that writes element 0 may read element 1

type point {x, y}
type t {ps point[2]}

func noinline mk(v) res point {
    res = {v, v}
}

func main() {
    var w = t{{{1, 2}, {3, 4}}}
    w = {{mk(w.ps[1].x), {5, 6}}}
    exit(w.ps[0].y + w.ps[1].x - 8)
}
