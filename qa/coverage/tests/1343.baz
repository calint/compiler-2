# the check of an uncalled inlined function with a result has the registers
# of a noinline body and reaches the result through an address, so an
# expression that fits the registers of 'main' is rejected
var g = 1

func f() res {
    res = (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + g * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g)
}

func h() res {
    res = (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + (g + g * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g) * g)
}

func main() {
    exit(0)
}
