# three nested 'foo' read the array the second one iterates, which can
# contain the element itself
# the value is computed before the destination is written

type leaf {
    v i32[2],
}

type mid {
    leaves leaf[2],
    other i32,
}

func main() {
    var m = mid[2]

    foo m {
        foo e.leaves {
            foo e.v {
                e = 1
            }
        }
    }
    m[0].leaves[1].v[0] = 3

    foo m {
        foo e.leaves {
            foo e.v {
                e = e + m[0].leaves[1].v[0]
            }
        }
    }
    if m[0].leaves[0].v[1] != 4 exit(1)
    if m[0].leaves[1].v[0] != 6 exit(2)
    if m[0].leaves[1].v[1] != 7 exit(3)
    if m[1].leaves[1].v[1] != 7 exit(4)
}
