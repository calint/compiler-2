# the bounds check of a run-time count of a 'foo' names the line of the
# count, also on a line of its own

# a value the compiler does not know
func noinline id(x) res {
    res = x
}

func main() {
    var arr = i8[4]
    var n = id(5)
    var sum = 0
    foo arr,
        n {
        sum = sum + e
    }
    exit(sum)
}
