}

func noinline make_nine() res nine {
    res.x[0].p.a = 7
    res.x[0].p.b = 2
    res.x[0].c = 7
    res.x[1].p.a = 7
    res.x[1].p.b = 2
    res.x[1].c = 7
    res.x[2].p.a = 7
    res.x[2].p.b = 2
    res.x[2].c = 7
    res.x[3].p.a = 7
    res.x[3].p.b = 2
    res.x[3].c = 7
    res.t = 7
}

func noinline is_nine_whole() res bool {
    var got = make_nine()
    var want = nine{
        {
            {{7, 2}, 7},
            {{7, 2}, 7},
            {{7, 2}, 7},
            {{7, 2}, 7},
        },
        7,
    }
    res = got == want
}

func noinline make_many() res many {
    res.x[0].p.a = 7
    res.x[0].p.b = 2
    res.x[0].c = 7
    res.x[1].p.a = 7
    res.x[1].p.b = 2
    res.x[1].c = 7
    res.x[2].p.a = 7
    res.x[2].p.b = 2
    res.x[2].c = 7
    res.x[3].p.a = 7
    res.x[3].p.b = 2
    res.x[3].c = 7
    res.x[4].p.a = 7
    res.x[4].p.b = 2
    res.x[4].c = 7
    res.x[5].p.a = 7
    res.x[5].p.b = 2
    res.x[5].c = 7
    res.t = 7
}

func noinline is_many_whole() res bool {
    var got = make_many()
    var want = many{
        {
            {{7, 2}, 7},
            {{7, 2}, 7},
            {{7, 2}, 7},
            {{7, 2}, 7},
            {{7, 2}, 7},
            {{7, 2}, 7},
        },
        7,
    }
    res = got == want
}

func noinline make_outer() res outer {
    res.m.x[0].p.a = 7
    res.m.x[0].p.b = 2
    res.m.x[0].c = 7
    res.m.x[1].p.a = 7
    res.m.x[1].p.b = 2
    res.m.x[1].c = 7
    res.m.x[2].p.a = 7
    res.m.x[2].p.b = 2
    res.m.x[2].c = 7
    res.m.x[3].p.a = 7
    res.m.x[3].p.b = 2
    res.m.x[3].c = 7
    res.m.x[4].p.a = 7
    res.m.x[4].p.b = 2
    res.m.x[4].c = 7
    res.m.x[5].p.a = 7
    res.m.x[5].p.b = 2
    res.m.x[5].c = 7
    res.m.t = 7
    res.u = 7
}

func noinline is_outer_whole() res bool {
    var got = make_outer()
    var want = outer{
        {
            {
                {{7, 2}, 7},
                {{7, 2}, 7},
                {{7, 2}, 7},
                {{7, 2}, 7},
                {{7, 2}, 7},
                {{7, 2}, 7},
            },
            7,
        },
        7,
    }
    res = got == want
}

func noinline make_l4() res l4 {
    res.w = 7
    res.v.v[0].w = 7
    res.v.v[0].v.v.p.a = 7
    res.v.v[0].v.v.p.b = 2
    res.v.v[0].v.v.c = 7
    res.v.v[0].v.w = 7
    res.v.v[1].w = 7
    res.v.v[1].v.v.p.a = 7
    res.v.v[1].v.v.p.b = 2
    res.v.v[1].v.v.c = 7
    res.v.v[1].v.w = 7
    res.v.w = 7
}

func noinline is_l4_whole() res bool {
    var got = make_l4()
    var want = l4{
        7,
        {
            {
                {
                    7,
                    {
                        {{7, 2}, 7},
                        7,
                    },
                },
                {
                    7,
                    {
                        {{7, 2}, 7},
                        7,
                    },
                },
            },
            7,
        },
    }
    res = got == want
}

func main() {
    scribble()
    if not is_four_whole() exit(1)
    scribble()
    if not is_five_whole() exit(2)
    scribble()
    if not is_eight_whole() exit(3)
    scribble()
    if not is_nine_whole() exit(4)
    scribble()
    if not is_many_whole() exit(5)
    scribble()
    if not is_outer_whole() exit(6)
    scribble()
    if not is_l4_whole() exit(7)
}
