    res.x[0].p.a = 7
    res.x[0].p.b = 2
    res.x[0].c = 7
    res.x[1].p.a = 7
    res.x[1].p.b = 2
    res.x[1].c = 7
    res.x[2].p.a = 7
    res.x[2].p.b = 2
    res.x[2].c = 7
    res.x[3].p.a = 7
    res.x[3].p.b = 2
    res.x[3].c = 7
}

func noinline is_eight_whole() res bool {
    var got = make_eight()
    var want = eight{
        {
            {{7, 2}, 7},
            {{7, 2}, 7},
            {{7, 2}, 7},
