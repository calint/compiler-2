# --checks=alias: two run-time indexes in a path, the read is of the same field
# of an element that both indexes can select

type item {
    f i32,
}

type ent {
    items item[2],
}

dat es = ent[3]

func put(x mut i32) {
    x = 100 - es[0].items[1].f
}

func main() {
    var i = 0
    var j = 1

    put(es[i].items[j].f)
    exit(es[0].items[1].f)
}
