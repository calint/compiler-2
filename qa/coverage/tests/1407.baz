# a part of a value may read under another name a part of the destination
# that is not written yet
# with '--checks=-alias': the function uses the global the call passes it,
# which the alias check rejects

type point {x, y}

var g = point{3, 5}

func f(p mut point) {
    p = {g.y, 1}
}

func main() {
    f(g)
    exit(g.x - 5)
}
