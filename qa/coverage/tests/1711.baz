# a call reaches of a 'mut' argument what its body writes: 'sety' writes only
# 'q.y', so the earlier read of 'q.x' is accepted, inlined and noinline

type pt {x, y}

func sety(p mut pt) res {
    p.y = 5
    res = 1
}

func noinline nsety(p mut pt) res {
    p.y = 6
    res = 2
}

func add(a, b) res {
    res = a + b
}

func main() {
    var q = pt{1, 2}
    var a = add(q.x, sety(q))
    var b = add(q.x, nsety(q))
    exit(a * 10 + b + q.y)
}
