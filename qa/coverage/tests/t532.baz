# constant indexes set every element of an array field
func assert(ok bool) { if not ok exit(1) }
type pair {cells[2]}
func make_pair() res pair {
    res.cells[0] = 5
    res.cells[1] = res.cells[0] + 1
}
func main() {
    var p pair = make_pair()
    assert(p.cells[0] == 5)
    assert(p.cells[1] == 6)
}
