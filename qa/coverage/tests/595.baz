# a constant index in range is an offset known at compile, no index register
# is computed at run time
#
# test-constant-folding.sh checks the instructions of lines marked '# folds'

const two = 2

type point {x i32, y i32}

type shape {id i8, pts[3] point}

func assert(err, expr bool) { if not expr exit(err) }

func third(arr[] i32) res {
    res = arr[two] # folds
}

func main() {
    var arr[4] i32
    arr[2] = 5 # folds
    arr[3] = arr[2] + 1 # folds
    assert(1, arr[3] == 6)
    assert(2, third(arr) == 5)

    var shapes[2] shape
    shapes[1].pts[two].y = 7 # folds
    shapes[1].id = 3 # folds
    assert(3, shapes[1].pts[2].y == 7)
    assert(4, shapes[1].id == 3)

    # a run-time index keeps its register, a constant one adds to the offset
    var i = 1
    shapes[i].pts[1].x = 9 # folds
    assert(5, shapes[1].pts[1].x == 9)
    shapes[0].pts[i].x = 11 # folds
    assert(6, shapes[0].pts[1].x == 11)

    # a constant range start with a run-time count keeps the bounds check
    var n = 2
    var dst[2] i32
    array_copy(arr[2], dst, n)
    assert(7, dst[0] == 5 and dst[1] == 6)

    # a range may start at the end when it copies nothing
    var none = 0
    array_copy(arr[4], dst, none)
    assert(8, dst[0] == 5)
}
