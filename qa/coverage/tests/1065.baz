# a type defined after an alias and before a method of the generic type does
# not hide the type parameter of the method's instance
type list<T type> {
    a T,
}

type s = list<i8>

type T {x}

func list.get() res T {
    res = T(self.a + 1)
}

func main() {
    var l = s
    l.a = 4
    var t = T{2}
    exit(int(l.get()) + t.x)
}
