# the check of a body without its call binds an instance argument of an
# inlined recursion it does not expand, 'rs[5]' past the end of 'rs' of 'f'

type row { a i8[4] }

func g(r row, rs row[], x) res {
    if x > 0 {
        res = g(rs[5], rs, x - 1)
        return
    }
    res = r.a[0]
}

func f(x) res {
    var rs = row[2]
    res = g(rs[0], rs, x)
}

func main() {
    exit(0)
}
