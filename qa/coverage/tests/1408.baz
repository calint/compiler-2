# a part of a value may not read under another name a part of the destination
# that is already written
# the call is rejected: the function uses the global the call passes it

type point {x, y}

var g = point{3, 5}

func f(p mut point) {
    p = {g.y, g.x}
}

func main() {
    f(g)
    exit(g.x)
}
