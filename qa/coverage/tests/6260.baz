# with only the upper bound checked, a run-time range whose end passes the
# largest 'int' of rv32i fails the bounds check: the end 'start + count' is
# compared unsigned, not as a negative number below the length

# a value the compiler does not know
func noinline id(x) res {
    res = x
}

func main() {
    var x = i8[4]
    var start = id(1)
    var count = id(0x7fffffff)
    write(1, x, count, start)
}
