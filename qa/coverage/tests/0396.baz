# a value literal assigned to an element at a run-time index, its nested
# literal assigned in place to the field of a user type, then the scalar
# field after it

func assert(err, expr bool) { if not expr exit(err) }

type pair {
    x,
    y
}

type outer {
    p pair,
    tag
}

func main() {
    var data = outer[2]
    var ix = 1

    data[ix] = {{10, 20}, 7}

    assert(1, ix == 1)
    assert(2, data[1].p.x == 10)
    assert(3, data[1].p.y == 20)
    assert(4, data[1].tag == 7)
}
