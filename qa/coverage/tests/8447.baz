# inlined calls whose constant arguments fold a 'break', a 'return' or the
# count of a 'foo' away: the code after the loop and after the call still runs
func fa(n i32, x mut i32) {
    loop {
        if n == 1 {
            x = x + 1
            break
        }
        x = x + 10
        if x > 25 break
    }
    x = x + 100
}
func fb(n i32, x mut i32) {
    if n == 0 {
        x = x + 1
        return
    } else {
        x = x + 2
    }
    x = x + 10
}
func gb(n i32, x mut i32) {
    fb(n, x)
    x = x + 100
    fb(0, x)
    x = x + 1000
    fb(1, x)
}
func fc(a i32[], k) res i32 {
    foo a, k {
        res = e
        return
    }
    res = -5
}
func fd(k i32, x i32) res i32 {
    res = 0
    loop {
        if k == 0 break
        res = res + x
        if res > 10 return
    }
    res = res + 1000
}
func main() {
    {
        var x = i32(0)
        fa(0, x)
        if x != 130 exit(1)
        x = 0
        fa(1, x)
        if x != 101 exit(2)
        var n = i32(0)
        x = 0
        fa(n, x)
        if x != 130 exit(3)
    }
    {
        var x = i32(0)
        gb(0, x)
        # 1 + 100 + 1 + 1000 + 12
        if x != 1114 exit(11)
        x = 0
        gb(1, x)
        if x != 12 + 100 + 1 + 1000 + 12 exit(12)
    }
    {
        var a = i32[]{7, 8}
        if fc(a, 0) != -5 exit(21)
        if fc(a, 1) != 7 exit(22)
        var k = 0
        if fc(a, k) != -5 exit(23)
        k = 2
        if fc(a, k) != 7 exit(24)
        if fc(a, 0) + fc(a, 2) * 10 != 65 exit(25)
    }
    {
        var x = i32(4)
        if fd(0, x) != 1000 exit(31)
        if fd(1, x) != 12 exit(32)
        var k = i32(0)
        if fd(k, x) != 1000 exit(33)
    }
}
