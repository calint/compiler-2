# a count from a call that copies arrays, with the overlap check the copy is a
# loop at run time

func nested(source i8[], destination mut i8[]) count {
    array_copy(source, destination, 1)
    count = 2
}

func main() {
    var source = i8[]{1, 2, 3}
    var destination = i8[3]
    array_copy(source, destination, nested(source, destination))
    if not arrays_equal(source, destination, nested(source, destination)) {
        exit(1)
    }
    exit(destination[2])
}
