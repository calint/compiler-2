# a value read under another name of the destination while it is computed
# goes through a scratch register: 'g' would be written before 'p' is read
# again
# with '--checks=-alias': the function uses the global the call passes it,
# which the alias check rejects

var g = 3

func f(p) {
    g = p * 2 + p
}

func main() {
    f(g)
    exit(g - 9)
}
