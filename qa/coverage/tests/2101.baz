# a comparison of a known size compiles both addresses before it takes its
# registers, so an index may shift or divide on x86_64

type point { x, y }

func main() {
    var a = i32[64]
    var b = i32[64]
    var i = 3
    var k = 1
    a[7] = 5
    b[7] = 5
    if not arrays_equal(a[i << k], b[(i / k) << k], 8) { exit(1) }
    a[8] = 1
    if arrays_equal(a[i << k], b[(i / k) << k], 8) { exit(2) }
    var ps = point[8]
    var qs = point[8]
    ps[6] = {1, 2}
    qs[6] = {1, 2}
    if ps[i << k] != qs[(i / k) << k] { exit(3) }
    qs[6].y = 3
    if ps[i << k] == qs[(i / k) << k] { exit(4) }
}
