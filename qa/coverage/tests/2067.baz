# a negated memory comparison of arrays and instances that only branches
# takes the branch on the right side, equal and unequal

type pt {x, y}

func main() {
    var a = i32[3]
    var b = i32[3]
    var p = pt{1, 2}
    var q = pt{1, 3}
    var r = 0
    if not (a == b) { r = r + 1 }
    if not (p == q) { r = r + 2 }
    b[1] = 5
    if not (a == b) { r = r + 4 }
    q.y = 2
    if not (p == q) { r = r + 8 }
    var c = not (a == b)
    if c { r = r + 16 }
    exit(r)
}
