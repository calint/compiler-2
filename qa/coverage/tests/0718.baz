# a system call inside nested loops keeps the loop register 'r11' of x86

dat a = i8[]{65, 10}

func main() {
    foo a {
        foo a {
            foo a {
                foo a {
                    foo a {
                        write(1, a, 2)
                        # 'e' is read through 'r11' after the system call
                        if e != 65 and e != 10 exit(1)
                    }
                }
            }
        }
    }
}
