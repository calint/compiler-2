# non-inline print_num: repeated calls, local arrays and inline syscall helpers

func print(len, ptr) {
    write(1, ptr, len)
}

func noinline print_num(num) {
    var buf : i8[20]
    var n = num
    var negative : bool = n < 0
    if not negative n = -n

    var i = 20
    loop {
        i = i - 1
        var ascii = 48 - (n % 10)
        buf[i] = ascii
        n = n / 10
        if n == 0 break
    }
    if negative {
        i = i - 1
        buf[i] = 45
    }

    var count = 20 - i
    var pos = 0
    loop {
        buf[pos] = buf[i]
        pos = pos + 1
        i = i + 1
        if i == 20 break
    }
    print(count, address_of(buf))
}

func main() {
    var newline : i8[1]
    newline[0] = 10
    var first = 123
    var second = -2147483648
    var third = 0

    print_num(first)
    print(1, address_of(newline))
    print_num(second)
    print(1, address_of(newline))
    print_num(third)
    print(1, address_of(newline))
    print_num(first)
    print(1, address_of(newline))
}