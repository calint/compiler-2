func assert(expr : bool) {
    if not expr exit(1)
}

func print(len, ptr) {
    write(1, ptr, len)
}

func input(len, ptr) : nbytes i64 {
    nbytes = read(0, ptr, len)
}

type location {
    name : i8[64],
    name_len
}

dat nl_str : i8[] = "\n"

func nl() {
    print(array_size_of(nl_str), address_of(nl_str))
}

func pn(num) {
    var buf : i8[20]
    var n = num
    var is_negative : bool = false

    if n < 0 {
        is_negative = true
        n = -n
    }

    var i = 20
    loop {
        i = i - 1
        var ascii = 48 + (n % 10)
        buf[i] = ascii
        # note: not buf[i] = 48 + ... because operation is done in byte sized
        #       with n overflows
        n = n / 10
        if n == 0 break
    }

    if is_negative {
        i = i - 1
        buf[i] = 45  # '-'
    }

    print(20 - i, address_of(buf[i]))
}

func main() {
    var locations : location[4]

    var i = 0
    loop {
      locations[i].name_len = input(array_size_of(locations[i].name), address_of(locations[i].name))
      pn(locations[i].name_len)
      nl()
      print(locations[i].name_len, address_of(locations[i].name))
      nl()
      i = i + 1
      if i == 4 break
    }

    i = 0
    loop {
      pn(locations[i].name_len)
      nl()
      print(locations[i].name_len, address_of(locations[i].name))
      nl()
      i = i + 1
      if i == 4 break
    }
}
