# register-bound arguments with unary values

func assert(expr bool) {
    if not expr exit(1)
}

func foozi(x reg_rsi, y reg_rcx) {
    assert(x == -2)    # ~1 == 0xfffffffe
    assert(y == -2)
}

func fow(x reg_rsi, y reg_rcx) {
    assert(x == 0)
    assert(y == 0)
}

func main(){
    var a = 1
    foozi(~1, ~a)
    fow(~-1, ~-a)
    foozi(a - 3, -2)
    fow(a - 1, 0)
}
