const n = 3
func exit(v : reg_rdi) {
    mov(rax, 60)
    mov(rdi, v)
    syscall()
}
func assert(x : bool) if not x exit(1)
func main() {
    dat values : i8[n] = {1,2,3}
    var copy : i8[n]
    copy[0] = values[0]
    copy[1] = values[1]
    copy[2] = values[2]
    assert(copy[0] == 1)
    assert(copy[1] == 2)
    assert(copy[2] == 3)
}
