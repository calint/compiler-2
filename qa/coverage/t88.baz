func assert(expr : bool) {
    if not expr exit(1)
}

func print(len, ptr) {
    write(1, ptr, len)
}

func input(len, ptr) : nbytes i64 {
    nbytes = read(0, ptr, len)
}

func main() {
    var input_buffer : i8[80]
    var len = input(array_size_of(input_buffer), address_of(input_buffer))
    print(len, address_of(input_buffer))
}
