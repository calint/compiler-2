# array_copy from an indexed struct element

func assert(expr : bool) {
    if not expr exit(1)
}

func print(len, ptr) {
    write(1, ptr, len)
}

func input(len, ptr) : nbytes i64 {
    nbytes = read(0, ptr, len)
}

type object {
    size : i16
}

func main() {
    var objs : object[3]
    objs[1].size = 2

    array_copy(objs[1], objs, 2)

    assert(objs[0].size == 2)
    assert(objs[1].size == 0)
}
