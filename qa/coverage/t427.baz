# foo loop variable indexes its data field

type item { data : [2] }

dat values : item[3] =
    {
        { {1, 2} },
        { {3, 4} },
        { {5, 6} }
    }

func increment(value) {
    value = value + 10
}

func assert(x : bool) { if not x exit(1) }

func main() {
    foo values {
        increment(e.data[1])
    }
    assert(values[0].data[0] == 1)
    assert(values[0].data[1] == 12)
    assert(values[1].data[0] == 3)
    assert(values[1].data[1] == 14)
    assert(values[2].data[0] == 5)
    assert(values[2].data[1] == 16)
}
