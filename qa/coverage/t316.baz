const C1  =   100
const    C2     =      -20
const       C3        =         50
type          Inner           {            a             :              i32               ,                b                 :                  i8                   [                    4                     ]                      }
type                       Outer                        {                         in                          :                           Inner                            ,                             flag                              :                               bool                                }
                                                                                                    dat                                                                                                     d_arr                                                                                                      :                                                                                                       i32                                                                                                        [                                                                                                         3                                                                                                          ]                                                                                                           =                                                                                                            {                                                                                                             10                                                                                                              ,                                                                                                               20                                                                                                                ,                                                                                                                 30                                                                                                                  }                                                                                                                   
func                                                           assert                                                            (                                                             x                                                              :                                                               bool                                                                )                                                                 { if                                                                  not                                                                   x                                                                    exit                                                                     (                                                                      1                                                                       ) }
func                                                                        compute                                                                         (                                                                          x                                                                           :                                                                            i32                                                                             ,                                                                              y                                                                               :                                                                                i32                                                                                 )                                                                                  :                                                                                   r                                                                                    i32                                                                                     {                                                                                      
                                                                                       r                                                                                        =                                                                                         x                                                                                          +                                                                                           y                                                                                            *                                                                                             2                                                                                              
}
func                                                                                               main                                                                                                (                                                                                                 )                                                                                                  {                                                                                                   
                                                                                                                    var                                                                                                                     out_obj                                                                                                                      :                                                                                                                       Outer                                                                                                                        
                                                                                                                         out_obj                                                                                                                          .                                                                                                                           in                                                                                                                            .                                                                                                                             a                                                                                                                              =                                                                                                                               10                                                                                                                                
                                                                                                                                 out_obj                                                                                                                                  .                                                                                                                                   in                                                                                                                                    .                                                                                                                                     b                                                                                                                                      [                                                                                                                                       2                                                                                                                                        ]                                                                                                                                         =                                                                                                                                          77                                                                                                                                           
                                                                                                                                            out_obj                                                                                                                                             .                                                                                                                                              flag                                                                                                                                               =                                                                                                                                                true                                                                                                                                                 
                                                                                                                                                  var                                                                                                                                                   res                                                                                                                                                    :                                                                                                                                                     i32                                                                                                                                                      =                                                                                                                                                       compute                                                                                                                                                        (                                                                                                                                                         out_obj                                                                                                                                                          .                                                                                                                                                           in                                                                                                                                                            .                                                                                                                                                             a                                                                                                                                                              ,                                                                                                                                                               d_arr                                                                                                                                                                [                                                                                                                                                                 1                                                                                                                                                                  ]                                                                                                                                                                   )                                                                                                                                                                    
                                                                                                                                                                     assert                                                                                                                                                                      (                                                                                                                                                                       res                                                                                                                                                                        ==                                                                                                                                                                         50                                                                                                                                                                          )                                                                                                                                                                           
                                                                                                                                                                            assert                                                                                                                                                                             (                                                                                                                                                                              out_obj                                                                                                                                                                               .                                                                                                                                                                                in                                                                                                                                                                                 .                                                                                                                                                                                  b                                                                                                                                                                                   [                                                                                                                                                                                    2                                                                                                                                                                                     ]                                                                                                                                                                                      ==                                                                                                                                                                                       77                                                                                                                                                                                        )                                                                                                                                                                                         
                                                                                                                                                                                          assert                                                                                                                                                                                           (                                                                                                                                                                                            out_obj                                                                                                                                                                                             .                                                                                                                                                                                              flag                                                                                                                                                                                               )                                                                                                                                                                                                
                                                                                                                                                                                                 assert                                                                                                                                                                                                  (                                                                                                                                                                                                   C1                                                                                                                                                                                                    ==                                                                                                                                                                                                     100                                                                                                                                                                                                      )                                                                                                                                                                                                       
                                                                                                                                                                                                        assert                                                                                                                                                                                                         (                                                                                                                                                                                                          C2                                                                                                                                                                                                           ==                                                                                                                                                                                                            -20                                                                                                                                                                                                             )                                                                                                                                                                                                              
                                                                                                                                                                                                               assert                                                                                                                                                                                                                (                                                                                                                                                                                                                 C3                                                                                                                                                                                                                  ==                                                                                                                                                                                                                   50                                                                                                                                                                                                                    )                                                                                                                                                                                                                     
}
