dat hello[] i8="hello\n"
dat world[] i8="world\n"

func print(len, ptr) {
    write(1, ptr, len)
}

func foozi(world[] i8){
    var len=array_size_of(world)
    print(len-1,address_of(world))
}

func bar(n,hello[] i8){
    var i=n
    loop{
        var b=2
        if n==0 break
        print(array_size_of(hello)-n,address_of(hello))
        n=n-1
        i=i-1
        b=b-1
    }
}

func main(){
    var a=2
    foozi(world)
    bar(a+2,hello)
    exit(0)
}
