# variable array initialization for built-in and user types

type point { x, y }

func assert(code, x : bool) if not x exit(code)

func fooz(v) : i64 res {
    res = v * 2
}

func main() {
    var x = 10
    var y = 4
    var numbers : i64[3] = { x, 20, 30 }
    var points : point[2] = { {1, 2}, {3, fooz(y) + 1} }

    assert(1, numbers[0] == 10)
    assert(2, numbers[1] == 20)
    assert(3, numbers[2] == 30)
    assert(4, points[0].x == 1)
    assert(5, points[0].y == 2)
    assert(6, points[1].x == 3)
    assert(7, points[1].y == 9)
}
