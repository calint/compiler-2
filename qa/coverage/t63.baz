func exit(v : reg_rdi) {
    mov(rax, 60)  # exit system call
    mov(rdi, v)   # return code
    syscall()
}

func print(len : reg_rdx, ptr : reg_rsi) {
    mov(rax, 1)   # write system call
    mov(rdi, 1)   # file descriptor for standard out
    mov(rsi, ptr) # buffer address 
    mov(rdx, len) # buffer size
    syscall()
}

func read(len : reg_rdx, ptr : reg_rsi) : i64 nbytes {
    mov(rax, 0)   # read system call
    mov(rdi, 0)   # file descriptor for standard input
    mov(rsi, ptr) # buffer address
    mov(rdx, len) # buffer size
    syscall()
    mov(nbytes, rax) # return value
}

func main(){
    dat   hello:i8[] = "hello world from baz\n"
    dat   input:i8[] = "............................................................"
    dat prompt1:i8[] = "enter name:\n"
    dat prompt2:i8[] = "that is not a name.\n"
    dat prompt3:i8[] = "hello "
    dat     dot:i8[] = "."
    dat      nl:i8[] = "\n"

    print(array_size_of(hello), address_of(hello))
    loop {
        print(array_size_of(prompt1), address_of(prompt1))
        var len = read(array_size_of(input), address_of(input)) - 1    # -1 don't include the '\n'
        if len == 0 {
            break
        }
        if len <= 4 {
            print(array_size_of(prompt2), address_of(prompt2))
            continue
        }
        print(array_size_of(prompt3), address_of(prompt3))
        print(len, address_of(input))
        print(array_size_of(dot), address_of(dot))
        print(array_size_of(nl), address_of(nl))
    }
}
