func exit(v : reg_rdi) {
    mov(rax, 60)  # exit system call
    mov(rdi, v)   # return code
    syscall()
}

func assert(expr : bool) if not expr exit(1)

type point {x, y}

func main() {
    dat data_a
    dat data_b : i32 = 32
    dat data_c : i16[4] = { 1, 2, 3, 4 }
    dat data_e : i8
    dat data_f : bool = true
    dat data_g : i16[] = {  1  , 2  ,  3  }
    dat data_h : i16[5] = {1,2}
    dat data_i : i8[128]
    dat data_j : bool = false
    dat data_k : bool[] = {true, false}
    dat data_l : i8[] = "hello world\n"
    dat data_m : i8[10] = "a"
    dat data_n : i8[4] = { -1, 2 }

    dat     pt : point = { -1, -2 }

    assert(data_a == 0)
    data_a = 0xff
    assert(data_a == 0xff)

    assert(data_b == 32)
    data_b = 10
    assert(data_b == 10)

    assert(data_c[0] == 1)
    assert(data_c[1] == 2)
    assert(data_c[2] == 3)
    assert(data_c[3] == 4)
    data_c[0] = 5
    data_c[1] = 6
    data_c[2] = 7
    data_c[3] = 8
    assert(data_c[0] == 5)
    assert(data_c[1] == 6)
    assert(data_c[2] == 7)
    assert(data_c[3] == 8)

    assert(data_e == 0)
    data_e = 1
    assert(data_e == 1)

    assert(data_f == true)
    data_f = false
    assert(data_f == false)

    assert(data_g[0] == 1)
    assert(data_g[1] == 2)
    assert(data_g[2] == 3)

    assert(data_h[2] == 0)
    assert(data_h[3] == 0)
    assert(data_h[4] == 0)

    data_i[127] = 0xfe
    assert(data_i[127] == 0xfe)

    assert(array_size_of(data_l) == 12)
    assert(data_l[0] == 104) # 'h'
    assert(data_l[11] == 10) # '\n'

    assert(array_size_of(data_m) == 10)
    assert(data_m[0] == 97) # 'a'
    assert(data_m[9] == 0) # '\0'

    assert(pt.x == -1)
    assert(pt.y == -2)
    pt.x = 3
    pt.y = 4
    assert(pt.x == 3)
    assert(pt.y == 4)

    assert(data_n[0] == -1)
    assert(data_n[1] == 2)
}
