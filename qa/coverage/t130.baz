# indexed values participate in a shift expression

func assert(expr : bool) if not expr exit(1)

func fiz(x : i32, shf) : i32 res {
    res = x + x << shf
}

func main() {
    var arr : i32[4]
    var ix = 1
    arr[ix] = 2
    arr[3] = 3
    var c : i32 = fiz(arr[ix], arr[3])
    assert(c == 18)
}
