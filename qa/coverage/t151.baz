# constant identifiers in data initializers

func assert(expr : bool) { if not expr exit(1) }

const yes = 1
const no = 0
const maybe = -1

type point { x, y }

dat p1 : point = { true, maybe }

func main() {
    assert (p1.x == yes)
    assert (p1.y == maybe)

    var answer = maybe
    assert(answer == -1)

    answer = yes
    assert(answer == 1)

    var p2 : point = { no, yes }
    assert (p2.x == no)
    assert (p2.y == yes)
}
