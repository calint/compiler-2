func exit(v : reg_rdi) {
    mov(rax, 60)  # exit system call
    mov(rdi, v)   # return code
    syscall()
}

func assert(expr : bool) if not expr exit(1)

const yes = 1
const no = 0
const maybe = -1

func main() {
    var answer = maybe
    assert(answer == -1)

    answer = yes
    assert(answer == 1)
}
