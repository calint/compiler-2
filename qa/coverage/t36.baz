dat name:i8[]="............................................................"

func print(len, ptr) {
    write(1, ptr, len)
}

func input(len, ptr) : i64 nbytes_read {
    nbytes_read = read(0, ptr, len)
}

func main(){
    var len=input(array_size_of(name),address_of(name))-1 # remove the \n
    print(len,address_of(name))
    exit(0)
}
