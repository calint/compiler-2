func assert(expr : bool) {
    if not expr exit(1)
}

func print(len, ptr) {
    write(1, ptr, len)
}

func input(len, ptr) : i64 nbytes {
    nbytes = read(0, ptr, len)
}

type string {
    len,
    data : i8[64]
}

type location {
    name : string
}

func main() {
    var locations : location[4]

    var i = 0
    loop {
      locations[i].name.len = input(array_size_of(locations[i].name.data), address_of(locations[i].name.data))
      i = i + 1
      if i == 4 break
    }

    i = 0
    loop {
      print(locations[i].name.len, address_of(locations[i].name.data))
      i = i + 1
      if i == 4 break
    }
}
