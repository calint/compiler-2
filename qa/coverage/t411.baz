# foo over an array of user types

type point { x, y }

dat points : point[3] = { {1, 2}, {3, 4}, {5, 6} }

func exit(v : reg_rdi) {
    mov(rax, 60)
    mov(rdi, v)
    syscall()
}

func assert(x : bool) if not x exit(1)

func main() {
    foo(points) {
        e.x = e.x + 10
    }
    assert(points[0].x == 11)
    assert(points[1].x == 13)
    assert(points[2].x == 15)
}
