# foo over an array of user types

type point { x, y }

dat points : point[3] = { {1, 2}, {3, 4}, {5, 6} }

func exit(v : reg_rdi) {
    mov(rax, 60)
    mov(rdi, v)
    syscall()
}

func assert(x : bool) if not x exit(1)

func main() {
    foo points {
        e.y = e.y + 10
    }
    assert(points[0].y == 12)
    assert(points[1].y == 14)
    assert(points[2].y == 16)
}
