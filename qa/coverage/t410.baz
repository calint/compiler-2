dat data : [] = { -1, 1, 3, 7, 11 }
dat inner_data : [] = { 1, 2, 3 }
dat outer_data : [] = { 1, 2 }

func assert(x : bool) if not x exit(1)

func main() {
    foo data {
        assert(n == 5)
        if(i == 2) continue
        if(i == 4) break
        e = e + n
    }

    assert(data[0] == 4)
    assert(data[1] == 6)
    assert(data[2] == 3)
    assert(data[3] == 12)

    var inner_seen

    foo inner_data {
        var j
        const n2 = n
        loop {
            j = j + 1
            if j == 2 continue
            inner_seen = inner_seen + 1
            if j == 3 break
        }
        e = e + n
    }

    assert(inner_seen == 6)
    assert(inner_data[0] == 4)
    assert(inner_data[1] == 5)
    assert(inner_data[2] == 6)

    var outer_count

    loop {
        outer_count = outer_count + 1
        foo outer_data {
            e = e + n
        }
        if outer_count == 2 break
    }

    assert(outer_count == 2)
    assert(outer_data[0] == 5)
    assert(outer_data[1] == 6)

    assert(data[4] == 11)
}
