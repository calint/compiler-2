dat hello:i8[]="hello\n"
dat world:i8[]="world\n"

func print(len, ptr) {
    write(1, ptr, len)
}

func bar(a,b,hello:i8[]){
    loop{
        if b==0 return
        print(array_size_of(hello),address_of(hello))
        b=b-1
    }
}

func foozi(world:i8[]){
    print(array_size_of(world),address_of(world))
}

func main(){
    var a=1
    var b=2
    var c=3
    bar(a,b,hello)
    foozi(world)
    exit(0)
}
