dat    str_hello = "\nwelcome to adventure #7\n    type 'help'\n"
dat       str_uc = "u c "
dat    str_exits = "exits: "
dat   str_prompt = " > "
dat str_turn_end = "--\n"

dat str_not_understood = "not understood\n"

dat flag = "\n\nFLAG\n\n"

let max_name_len = 16
let max_id_list_len = 32
let max_room_objects_len = 64
let max_room_entities_len = 32
let max_room_links_len = 8
let max_link_names_len = 1024
let max_rooms_len = 128
let max_entities_len = 32
let max_objects_len = 1024
let max_entity_messages_len = 16

type id_list = list<int, max_id_list_len>

type name = text<max_name_len>

dat str_told_u = " told u "
dat str_said = " said "

let message_told = 0
let message_said = 1
let message_event = 2

type message {
    from,
    kind,
    text str,
}

type messages = list<message, max_entity_messages_len>

func mut messages.add(from, kind, text str) {
    let ix = self.reserve()
    self.array[ix] = { from, kind, text }
}

type entity {
    name name,
    room_id,
    objects id_list,
    messages messages,
}

func entity.print() {
    out.print(self.name.array, self.name.len)
}

type entities = list<entity, max_entities_len>

# the bare entity, the creation script makes the rest
dat entities = entities{
    { # array begin
        { { "u", 1 }, 0 }  # entity[0]
    }, # array end
    1 # array len
}

func message.print() {
    entities.array[self.from].name.print()
    if self.kind == message_said {
        out.print_all(str_said)
    } else if self.kind == message_told {
        out.print_all(str_told_u)
    } else if self.kind == message_event {
        out.print_all(str_space)
    }
    self.text.print()
}

func mut entity.print_messages() {
    foo self.messages.array, self.messages.len {
        e.print()
        out.println()
    }

    self.messages.len = 0
}

func mut entities.add(nm name, room_id) entity_id {
    entity_id = self.reserve()
    self.array[entity_id] = { nm, room_id }
}

type link_names = list<name, max_link_names_len>

dat link_names = link_names

type link {
    link_name_id,
    to,
}

type links = list<link, max_room_links_len>

func mut links.add(link_name_id, to) {
    let ix = self.reserve()
    self.array[ix] = { link_name_id, to }
}

type object {
    name name,
}

type objects = list<object, max_objects_len>

func mut objects.add(name name) object_id {
    object_id = self.reserve()
    self.array[object_id] = { name }
}

dat objects = objects

type room {
    name name,
    description str,
    note str,
    entities id_list,
    links links,
    objects id_list,
}

dat str_u_r_in = "u r in "

func room.print(cur_entity) {
    if self.name.len != 0 {
        out.print_all(str_u_r_in)
        self.name.print()
        out.println()
    }
    if self.description.len != 0 {
        self.description.print()
        out.println()
    }
    var present = joiner
    foo self.entities.array, self.entities.len {
        if e == cur_entity continue
        present.next(str_uc)
        entities.array[e].print()
    }
    foo self.objects.array, self.objects.len {
        present.next(str_uc)
        objects.array[e].name.print()
    }
    if present.printed {
        out.println()
    }
    if self.links.len != 0 {
        out.print_all(str_exits)
        foo self.links.array, self.links.len {
            if i != 0 out.print_all(str_comma)
            link_names.array[e.link_name_id].print()
        }
        out.println()
    }
    if self.note.len != 0 {
        self.note.print()
        out.println()
    }
}

func mut room.remove_entity(id) {
    # find entity
    var found_ix = self.entities.len
    let name = entities.array[id].name
    foo self.entities.array, self.entities.len {
        if entities.array[e].name.equals(name) {
            found_ix = i
            break
        }
    }

    # check program error
    assert(1, found_ix != self.entities.len)

    self.entities.delete_index(found_ix)
}

type rooms = list<room, max_rooms_len>

# the bare room, the creation script makes the rest
dat rooms = rooms{
    { # array
        { # room[0]
            { }, # name
            { }, # description
            { }, # note
            { { 0 }, 1 } # entities id_list
        }
    },
    1 # array len
}

# the index in the inventory of the object named by the token or the length
func noinline entity.find_object(tz tokenizer) res {
    res = self.objects.len
    foo self.objects.array, self.objects.len {
        if tz.is(objects.array[e].name) {
            res = i
            break
        }
    }
}

func notify_room(room_id, from, kind, text str) {
    let room_entities_len = rooms.array[room_id].entities.len
    foo rooms.array[room_id].entities.array, room_entities_len {
        if e == from continue

        if entities.array[e].messages.is_full() continue

        entities.array[e].messages.add(from, kind, text)
    }
}

# the index of the link to the room or the length
func links.index_of_link_to(room_id) res {
    res = self.len
    foo self.array, self.len {
        if e.to == room_id {
            res = i
            break
        }
    }
}

dat str_went_to = "went to "
dat str_go_where = "go where\n"
dat str_no_such_exit = "cannot go there\n"
dat str_home = "home"
dat str_arrived_from = "arrived from "

func action_go(eid, tz mut tokenizer) {
    if not tz.next_or_say(str_go_where) return

    if tz.is_array(str_home) exit(0)

    # find link
    let cur_room_id = entities.array[eid].room_id

    let links_len = rooms.array[cur_room_id].links.len
    var found_ix = links_len
    foo rooms.array[cur_room_id].links.array, links_len {
        if tz.is(link_names.array[e.link_name_id]) {
            found_ix = i
            break
        }
    }

    if found_ix == links_len {
        out.print_all(str_no_such_exit)
        return
    }

    # move entity
    let link = rooms.array[cur_room_id].links.array[found_ix]
    let to_room_id = link.to
    entities.array[eid].room_id = to_room_id 

    rooms.array[to_room_id].entities.push(eid)
    rooms.array[cur_room_id].entities.delete_item(eid)

    out.print_all(str_went_to)
    tz.print()
    out.println()

    # the ones left behind see it
    var went_text = str
    went_text.add(str_went_to)
    went_text.append(link_names.array[link.link_name_id])

    notify_room(cur_room_id, eid, message_event, went_text)

    let to_found_ix = rooms.array[to_room_id].links.index_of_link_to(cur_room_id)

    # missing link back is program error
    assert(2, to_found_ix != rooms.array[to_room_id].links.len)

    var arrived_text = str
    arrived_text.add(str_arrived_from)
    arrived_text.append(
        link_names.array[
            rooms.array[to_room_id].links.array[to_found_ix].link_name_id
        ]
    )

    notify_room(to_room_id, eid, message_event, arrived_text)
}

func find_link_name_or_make(tz tokenizer) res {
    let link_name = tz.token<name>()

    res = link_names.find_or_add(link_name)
}

dat str_what_exit_name_to = "what is exit name to new room\n"
dat str_what_exit_name_back = "what is exit name back to this room\n"
dat str_new_room_created = "new room created\n"

func action_new_room(eid, tz mut tokenizer) {
    if not tz.next_or_say(str_what_exit_name_to) return

    let cur_room_id = entities.array[eid].room_id 

    let link_name_id = find_link_name_or_make(tz)

    if not tz.next_or_say(str_what_exit_name_back) return

    let link_name_back_id = find_link_name_or_make(tz)

    let new_room_id = rooms.reserve()

    # link to next room
    rooms.array[cur_room_id].links.add(link_name_id, new_room_id)

    # link back to this room from the new room
    rooms.array[new_room_id].links.add(link_name_back_id, cur_room_id)

    out.print_all(str_new_room_created)
}

dat str_new_room_description = "new room description\n"

func action_set_room_description(eid, tz mut tokenizer) {
    tz.to_end()
    rooms.array[entities.array[eid].room_id].description = tz.token()

    out.print_all(str_new_room_description)
}

func action_set_room_note(eid, tz mut tokenizer) {
    tz.to_end()
    rooms.array[entities.array[eid].room_id].note = tz.token()
}

dat str_what_name = "what name\n"
dat str_name_too_long = "name too long\n"
dat str_new_room_name = "new room name\n"

# moves to the next token, it must exist and fit a name, else the user is told
func mut tokenizer.next_name_or_say() res bool {
    res = false
    if not self.next_or_say(str_what_name) return

    if self.len() > max_name_len {
        out.print_all(str_name_too_long)
        return
    }

    res = true
}

func action_set_room_name(eid, tz mut tokenizer) {
    if not tz.next_name_or_say() return

    rooms.array[entities.array[eid].room_id].name = tz.token()

    out.print_all(str_new_room_name)
}

dat str_new_entity_created = "new entity created\n"

func action_new_entity(eid, tz mut tokenizer) {
    if not tz.next_name_or_say() return

    let name = tz.token<name>()

    let room_id = entities.array[eid].room_id

    let entity_id = entities.add(name, room_id)

    rooms.array[room_id].entities.push(entity_id)

    out.print_all(str_new_entity_created)
}

dat str_new_object_created = "new object created\n"

func action_new_object(eid, tz mut tokenizer) {
    if not tz.next_name_or_say() return

    let name = tz.token<name>()

    let object_id = objects.add(name)

    entities.array[eid].objects.push(object_id)

    out.print_all(str_new_object_created)
}

dat str_u_have = "u have: "
dat str_u_have_nothing = "u have nothing\n"

func action_inventory(eid, tz tokenizer) {
    let len = entities.array[eid].objects.len
    if  len == 0 {
        out.print_all(str_u_have_nothing)
        return
    }

    var carried = joiner

    foo entities.array[eid].objects.array, len {
        carried.next(str_u_have)
        objects.array[e].name.print()
    }

    out.println()
}

dat str_drop_what = "drop what\n"
dat str_not_carrying = "u do not have that\n"
dat str_dropped = "dropped "

func action_drop(eid, tz mut tokenizer) {
    if not tz.next_or_say(str_drop_what) return

    let found_ix = entities.array[eid].find_object(tz)

    if found_ix == entities.array[eid].objects.len {
        out.print_all(str_not_carrying)
        return
    }

    # move object from inventory to room
    let object_id = entities.array[eid].objects.array[found_ix]
    let room_id = entities.array[eid].room_id
    rooms.array[room_id].objects.push(object_id)
    entities.array[eid].objects.delete_index(found_ix)

    out.print_all(str_dropped)
    tz.print()
    out.println()
}

dat str_give_what = "give what\n"
dat str_give_to_whom = "give to whom\n"
dat str_is_not_here = " is not here\n"
dat str_gave = "gave "
dat str_to = " to "

func action_give(eid, tz mut tokenizer) {
    if not tz.next_or_say(str_give_what) return

    let found_ix = entities.array[eid].find_object(tz)

    if found_ix == entities.array[eid].objects.len {
        out.print_all(str_not_carrying)
        return
    }

    let object_id = entities.array[eid].objects.array[found_ix]
    let object_name = objects.array[object_id].name

    if not tz.next_or_say(str_give_to_whom) return

    # find other entity in the same room
    let room_id = entities.array[eid].room_id
    let room_entities_len = rooms.array[room_id].entities.len
    var to_entity = 0
    var found = false
    foo rooms.array[room_id].entities.array, room_entities_len {
        if e == eid continue
        if tz.is(entities.array[e].name) {
            to_entity = e
            found = true
            break
        }
    }

    if not found {
        tz.print()
        out.print_all(str_is_not_here)
        return
    }

    # move object between inventories
    entities.array[to_entity].objects.push(object_id)
    entities.array[eid].objects.delete_index(found_ix)

    out.print_all(str_gave)
    object_name.print()
    out.print_all(str_to)
    entities.array[to_entity].name.print()
    out.println()

    var gave_text = str
    gave_text.add(str_gave)
    gave_text.append(entities.array[to_entity].name)
    gave_text.add(str_space)
    gave_text.append(object_name)

    notify_room(room_id, eid, message_event, gave_text)
}

dat str_tell_whom = "tell whom\n"
dat str_tell_what = "tell what\n"
dat str_does_not_exist = " does not exist\n"
dat str_has_too_many_messages = " has too many messages\n"

func action_tell(eid, tz mut tokenizer) {
    if not tz.next_or_say(str_tell_whom) return

    # find entity anywhere
    let to_entity = entities.index_of_name(tz)

    if to_entity == entities.len {
        tz.print()
        out.print_all(str_does_not_exist)
        return
    }

    if entities.array[to_entity].messages.is_full() {
        tz.print()
        out.print_all(str_has_too_many_messages)
        return
    }

    # the message is the rest of the line
    tz.to_end()

    if tz.is_empty() {
        out.print_all(str_tell_what)
        return
    }

    let text = tz.token<str>()

    entities.array[to_entity].messages.add(eid, message_told, text)
}

dat str_say_what = "say what\n"

func action_say(eid, tz mut tokenizer) {
    # the text is the rest of the line
    tz.to_end()

    if tz.is_empty() {
        out.print_all(str_say_what)
        return
    }

    let text = tz.token<str>()

    notify_room(entities.array[eid].room_id, eid,
                    message_said, text)
}

dat str_help = "\
  help: this message\n\
  go to: go <exit>\n\
  inventory: i\n\
  create new object: on <name>\n\
  drop object: d <object>\n\
  give object: g <object> <entity>\n\
  tell entity: t <entity> <message>\n\
  say to room: s <text>\n\
  new room: rn <to exit> <from exit>\n\
  set room name: rnm <text>\n\
  set room description: rd <text>\n\
  set room note: rnt <text>\n\
  new entity: en <name>\n\
"

func action_help(eid, tz tokenizer) {
    out.print_all(str_help)
}

dat str_action_help = "help"
dat str_action_go = "go"
dat str_action_inventory = "i"
dat str_action_new_object = "on"
dat str_action_drop = "d"
dat str_action_give = "g"
dat str_action_tell = "t"
dat str_action_say = "s"
dat str_action_new_room = "rn"
dat str_action_set_room_name = "rnm"
dat str_action_set_room_description = "rd"
dat str_action_set_room_note = "rnt"
dat str_action_new_entity = "en"

# note: `noinline` because it unfolds into a lot of code and called from 2
#       locations
func noinline parse_input(eid, tz mut tokenizer) {
    tz.next()

    if tz.is_array(str_action_go) {
        action_go(eid, tz)

    } else if tz.is_array(str_action_new_room) {
        action_new_room(eid, tz)

    } else if tz.is_array(str_action_set_room_description) {
        action_set_room_description(eid, tz)

    } else if tz.is_array(str_action_set_room_note) {
        action_set_room_note(eid, tz)

    } else if tz.is_array(str_action_set_room_name) {
        action_set_room_name(eid, tz)

    } else if tz.is_array(str_action_new_entity) {
        action_new_entity(eid, tz)

    } else if tz.is_array(str_action_new_object) {
        action_new_object(eid, tz)

    } else if tz.is_array(str_action_inventory) {
        action_inventory(eid, tz)

    } else if tz.is_array(str_action_drop) {
        action_drop(eid, tz)

    } else if tz.is_array(str_action_give) {
        action_give(eid, tz)

    } else if tz.is_array(str_action_tell) {
        action_tell(eid, tz)

    } else if tz.is_array(str_action_say) {
        action_say(eid, tz)

    } else if tz.is_array(str_action_help) {
        action_help(eid, tz)

    } else {
        out.print_all(str_not_understood)
    }
}

dat str_creation_script = "\
rnm roome\n\
rnt todo: find an exit\n\
rn none roome\n\
go none\n\
rnm office\n\
go roome\n\
en me\n"

# runs the lines of the script as the bare entity, a line ends with '\n'
func run_creation_script(tz mut tokenizer) {
    var line_start = 0
    var eid = 0
    foo str_creation_script {
        if e == '\n' {
            tz.set_line(str_creation_script, line_start, i - line_start)
            parse_input(eid, tz)
            line_start = i + 1
        }
    }
}

func main() {
    var tz = tokenizer

    out.set_silenced(true)
    run_creation_script(tz)
    out.set_silenced(false)

    # messages made by the script are not for the players
    foo entities.array, entities.len {
        e.messages.len = 0
    }

    out.print_all(str_ascii_art)
    out.print_all(str_hello)

    var eid = 0
    loop {
        if eid == entities.len {
            eid = 0
        }
        entities.array[eid].print_messages()
        out.println()
        rooms.array[entities.array[eid].room_id].print(eid)
        entities.array[eid].name.print()
        out.print_all(str_prompt)
        tz.input()
        out.println()
        parse_input(eid, tz)
        out.print_all(str_turn_end)
        eid = eid + 1
    }
}
