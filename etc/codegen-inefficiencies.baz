# local code generation inefficiencies found in the rv32i assessment
# (2026-09-26) and in a survey of all coverage tests on both targets
# (2026-09-28), see etc/todo.txt
#
# comments show rv32i code unless marked 'x86:'; 'sites' counts the
# occurrences in the coverage tests; fixed items are removed
#
# within one machine operation:
#   constant part of a run-time index
# between machine operations of one statement:
#   helper/'idiv'/syscall operands and results copied through a scratch
#   register, runtime bool argument materialized
# across statements (register allocation, out of scope for now):
#   value reloaded right after it was stored
#
# review with: ./baz --target=rv32i etc/codegen-inefficiencies.baz
#         and: ./baz etc/codegen-inefficiencies.baz
# etc/codegen-inefficiencies.s: ./baz --target=rv32i-fpga

type point {x, y}

type object {pos point, color i32}

type world { locations[8] }

func assert(ok bool) { if not ok exit(1) }

func inv(i i32) res i32 {
    res = ~i
}

func point.at(x, y) self {
    self.x = x
    self.y = y
}

func object.at(x, y, color i32) self {
    self.pos = point.at(x, y)
    self.color = color
}

func noinline print_num(num) {
    var buf = i8[20]{}
    var n = num
    var i = 20
    loop {
        i = i - 1
        # across statements: 'sw t0, 28(s1)' above then 'lw t0, 28(s1)' here
        # (574 sites)
        #
        # divide call: 'lw t2; addi a0, t2, 0' instead of 'lw a0' (107 sites)
        # and 'addi t2, a1, 0; sub t1, t1, t2' instead of 'sub t1, t1, a1'
        # (257 sites); x86: 'mov rax, r13' before 'cqo' and 'mov r13, rdx'
        # after 'idiv' (113 sites each)
        buf[i] = i8('0' - n % 10)
        n = n / 10
        if n == 0 break
    }
    write(1, buf, 20)
}

func main() {
    var x = 1
    var arr = i32[4]{}
    var arr3 = []{ 3, 5 }
    var o3 = object[2]{}
    var worlds = world[8]{}

    assert(arr3[0] + 2 == 3 + 0 + 2)
    assert(array_length(arr3) == 2)

    arr[1] = 2
    assert(arr[1] == 2)

    o3[1].pos.y = 74
    assert(o3[1].pos.y == 74)

    worlds[1].locations[1] = 0xffee

    # with bounds checks on the constant part of a run-time index is not
    # folded into the displacement: 'addi t0, t0, 1' before 'sw t2, 4(t3)'
    # instead of 'sw t2, 8(t3)', x86: 'add r15, 1' before
    # '[rbp + r15 * 4 + 8]' instead of '+ 12'; without checks it is folded
    var ix = 1
    arr[ix + 1] = arr[ix]
    worlds[ix].locations[1] = 0xffee

    var a = -x
    a = ~x

    var b = i8(0)
    b = i8(x - 1)

    var p1 = point{-x, -a}

    # low priority: '~' in 'inv' and on the result give two 'xori t1, t1, -1'
    # (x86: two 'not dword')
    arr[ix] = ~inv(arr[ix - 1])

    # runtime bool argument: 'lw; xori; sltiu; bne' instead of 'lw; li; bne',
    # x86: 'sete r15b; cmp r15b, 0; jne' (97 rv32i sites)
    assert(x == 1)

    var eq = x == 1
    assert(eq)

    a = x * 10

    # low priority: the address goes into a new register 'slli t1, t0, 2'
    # instead of reusing the index register
    a = arr[ix]

    o3[ix] = object.at(2, 74, 0xffffff)

    var buf = i8[20]{}

    var q = p1
    assert(p1 == q)

    array_copy(worlds[1].locations, worlds[0].locations,
               array_length(worlds[0].locations))

    print_num(a)

    assert(buf[0] == 0)
    assert(b == 0)
    assert(p1.x == -1)

    # code after an explicit exit is still generated, here the implicit
    # 'exit(0)' at the end of 'main'
    exit(0)
}
