include "lib.baz"

let limit = 4

var total = 0

type point {
    x,
    y,
}

type label = text<16>

type shape {
    origin point,
    title label,
}

type shapes = list<shape, limit>

dat shapes = shapes

func mut point.move(dx, dy) {
    self.x = self.x + dx
    self.y = self.y + dy
}

func point.print() {
    total = total + self.x
}

func shape.print() {
    self.origin.print()
    self.title.print()
}

func add(a, b) res {
    res = a + b
}

func locals(count) res {
    var local = count
    local = add(local, limit)
    res = local
}

func shadow() {
    var count = 1
    {
        var count = 2
        count = count + 2
    }
    count = count + 1
}

func make_point(px, py) res point {
    res.x = px
    res.y = py
}

func first_shape() {
    let first = shapes.array[0]
}

func main() {
    var p = point
    p.move(1, 2)
    p.print()
    var s = shape
    s.print()
    s.origin.move(3, 4)
    s.title.print()
    var all = shapes
    var at = all.reserve()
    all.array[at].print()
    foo all.array, all.len {
        e.print()
    }
    var q = make_point(5, 6)
    q.print()
    total = lib_helper(total)
    total = add(total, 1)
    total = total + lib_size
    lib_counter = 0
}
