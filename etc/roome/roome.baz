dat  str_hello = "\nwelcome to adventure #6\n    type 'help'\n"
dat     str_uc = "u c "
dat  str_exits = "exits: "
dat str_prompt = " > "
dat     str_nl = "\n"
dat  str_comma = ", "
dat  str_erase = "\b \b"

dat str_not_understood = "not understood\n"

dat flag = "\n\nFLAG\n\n"

func print(s i8[]) {
    write(1, s)
}

type str {
    array i8[127],
    len,
}

func str.print() {
    write(1, self.array, self.len)
}

func str.input() {
    # the uart does not echo, so each byte is written back as it is read
    var nbytes = 0
    loop {
        if nbytes == array_length(self.array) break
        if read(0, self.array, 1, nbytes) == 0 break
        if self.array[nbytes] == '\x7f' {
            if nbytes > 0 {
                nbytes = nbytes - 1
                write(1, str_erase)
            }
            continue
        }
        write(1, self.array, 1, nbytes)
        if self.array[nbytes] == '\n' break
        nbytes = nbytes + 1
    }
    self.len = nbytes
}

const max_name_len = 16
const max_id_list_len = 32
const max_room_objects_len = 64
const max_room_entities_len = 32
const max_room_links_len = 8
const max_link_names_len = 1024
const max_rooms_len = 128
const max_entities_len = 32
const max_objects_len = 1024

type id_list {
    array[max_id_list_len],
    len,
}

func id_list.delete_index(ix) {
    # array copy it away
    array_copy(
        self.array[ix + 1],
        self.array[ix],
        self.len - ix - 1
    )

    # set new len
    self.len = self.len - 1
}

func id_list.delete_element(id) {
    var found_ix = self.len
    foo self.array, self.len {
        if e == id {
            found_ix = i
            break
        }
    }

    if found_ix == self.len return

    self.delete_index(found_ix)
}

func id_list.add(ix) res { 
    self.array[self.len] = ix
    res = self.len
    self.len = self.len + 1
}

type name {
    array i8[max_name_len],
    len,
}

func name.print() {
    write(1, self.array, self.len)
}

func name.equals(nm name) res bool {
    if self.len != nm.len {
        res = false
        return
    }

    res = arrays_equal(self.array, nm.array, self.len)
}

type entity {
    name name,
    room_id,
    objects id_list,
    messages str[16],
}

func entity.print() {
    write(1, self.name.array, self.name.len)
}

type entities {
    array entity[max_entities_len],
    len,
}

dat entities = entities{
    { # array begin
        { { "me", 2 }, 0 } # entity[0]
    }, # array end
    1 # len
}

func entities.add(nm name, room_id) entity_id {
    self.array[self.len] = { nm, room_id } 
    entity_id = self.len
    self.len = self.len + 1
}

type link_names {
    array name[max_link_names_len],
    len
}

dat link_names = link_names{
    { # array begin
        { "none", 4 }
    }, # array end
    1 # len
}

type link {
    link_name_id,
    to,
}

type object {
    name name,
}

type objects {
    array object[max_objects_len],
    len,
}

func objects.add(name name) object_id {
    self.array[self.len] = { name }
    object_id = self.len
    self.len = self.len + 1
}

dat objects = objects{}

type room {
    name name,
    description str,
    note str,
    entities id_list,
    links link[max_room_links_len],
    links_len,
    objects id_list,
}

func room.remove_entity(id) {
    # find entity
    var found_ix = self.entities.len
    var name = entities.array[id].name
    foo self.entities.array, self.entities.len {
        if entities.array[e].name.equals(name) {
            found_ix = i
            break
        }
    }

    # check program error
    if found_ix == self.entities.len exit(1)

    self.entities.delete_index(found_ix)
}

type rooms {
    array room[max_rooms_len],
    len,
}

dat rooms = rooms{
    { # array
        { # room[0] 
            { "roome", 5 }, # name
            { }, # description
            { "todo: find an exit", 18 }, # note
            { { 0 }, 1 }, # entities id_list
            { {0, 1} }, # links array
            1 # links array len
        }
    },
    1 # len
}

dat str_u_r_in = "u r in "

func room.print(cur_entity) {
    if self.name.len != 0 {
        print(str_u_r_in)
        self.name.print()
        print(str_nl)
    }
    if self.description.len != 0 {
        self.description.print()
        print(str_nl)
    }
    var first_elem_printed = false
    foo self.entities.array, self.entities.len {
        if e == cur_entity continue
        if not first_elem_printed {
            print(str_uc)
        }
        if first_elem_printed {
            print(str_comma)
        }
        entities.array[e].print()
        first_elem_printed = true
    }
    foo self.objects.array, self.objects.len {
        if not first_elem_printed {
            print(str_uc)
        }
        if first_elem_printed {
            print(str_comma)
        }
        objects.array[e].name.print()
        first_elem_printed = true
    }
    if first_elem_printed {
        print(str_nl)
    }
    if(self.links_len != 0) {
        print(str_exits)
        foo self.links, self.links_len {
            if i != 0 print(str_comma)
            link_names.array[e.link_name_id].print()
        }
        print(str_nl)
    }
    if self.note.len != 0 {
        self.note.print()
        print(str_nl)
    }
}

type tokenizer {
    str str,
    start,
    end,
}

func tokenizer.input() {
    self.start = 0
    self.end = 0
    self.str.input()
}

func tokenizer.skip_whitespace() {
    self.start = self.end
    loop {
        if self.start >= self.str.len {
            self.end = self.start
            return
        }
        if self.str.array[self.start] != ' ' break
        self.start = self.start + 1
    }
    self.end = self.start
}

func tokenizer.first() {
    self.skip_whitespace()
    self.end = self.start
    loop {
        if self.end >= self.str.len break
        if self.str.array[self.end] == ' ' break
        self.end = self.end + 1
    }
}

func tokenizer.next() {
    self.skip_whitespace()
    self.end = self.start
    loop {
        if self.end >= self.str.len break
        if self.str.array[self.end] == ' ' break
        self.end = self.end + 1
    }
}

func tokenizer.len() res {
    res = self.end - self.start
}

func tokenizer.print() {
    write(1, self.str.array, self.len(), self.start)
}

func tokenizer.is_str(str i8[]) res bool {
    res = self.len() == array_length(str) and
          arrays_equal(str, self.str.array[self.start], array_length(str))
}

func tokenizer.is_name(nm name) res bool {
    res = self.len() == nm.len and
          arrays_equal(nm.array, self.str.array[self.start], nm.len)
}

func tokenizer.is_empty() res bool {
    res = self.start == self.end
}

func tokenizer.to_name() dst name {
    dst.len = self.len()
    dst.array = {}
    array_copy(self.str.array[self.start], dst.array, dst.len)
}

func tokenizer.to_str() res str {
    res.len = self.len()
    res.array = {}
    array_copy(self.str.array[self.start], res.array, res.len)
}

func tokenizer.to_end() {
    self.start = self.end
    self.end = self.str.len
}

dat str_went_to = "went to "
dat str_go_where = "go where\n"
dat str_no_such_exit = "cannot go there\n"
dat str_home = "home"

func action_go(cur_entity, tz tokenizer) {
    tz.next()
    if tz.is_empty() {
        print(str_go_where)
        return
    }

    if tz.is_str(str_home) {
        exit(0)
    }

    # find link
    var cur_room_id = entities.array[cur_entity].room_id

    var links_len = rooms.array[cur_room_id].links_len
    var found_ix = links_len
    foo rooms.array[cur_room_id].links, links_len {
        if tz.is_name(link_names.array[e.link_name_id]) {
            found_ix = i
            break
        }
    }

    if found_ix == links_len {
        print(str_no_such_exit)
        return
    }

    # move entity
    var to_id = rooms.array[cur_room_id].links[found_ix].to
    entities.array[cur_entity].room_id = to_id 
    var discarded = rooms.array[to_id].entities.add(cur_entity)
    rooms.array[cur_room_id].entities.delete_element(cur_entity)

    print(str_went_to)
    tz.print()
    print(str_nl)
}

func find_link_name_or_make(tz tokenizer) res {
    res = link_names.len
    foo link_names.array, link_names.len {
        if tz.is_name(e) {
            res = i
            break
        }
    }

    if res != link_names.len return

    link_names.array[link_names.len] = tz.to_name()

    res = link_names.len

    link_names.len = link_names.len + 1
}

dat str_what_exit_name_to = "what is exit name to new room\n"
dat str_what_exit_name_back = "what is exit name back to this room\n"

func action_new_room(cur_entity, tz tokenizer) {
    tz.next()

    if tz.is_empty() {
        print(str_what_exit_name_to)
        return
    }

    var cur_room_id = entities.array[cur_entity].room_id 

    var cur_room_next_link_id = rooms.array[cur_room_id].links_len

    var link_name_id = find_link_name_or_make(tz)

    tz.next()

    if tz.is_empty() {
        print(str_what_exit_name_back)
        return
    }

    var link_name_back_id = find_link_name_or_make(tz)

    # link to next room
    rooms.array[cur_room_id].links[cur_room_next_link_id] = { 
        link_name_id,
        rooms.len
    }
    rooms.array[cur_room_id].links_len = cur_room_next_link_id + 1

    # link back to this from from the new room
    rooms.array[rooms.len].links[0] = { 
        link_name_back_id,
        cur_room_id
    }
    rooms.array[rooms.len].links_len = 1

    # increase number of rooms
    rooms.len = rooms.len + 1
}

func action_set_room_description(cur_entity, tz tokenizer) {
    tz.skip_whitespace()
    tz.to_end()
    rooms.array[entities.array[cur_entity].room_id].description = tz.to_str()
}

func action_set_room_note(cur_entity, tz tokenizer) {
    tz.skip_whitespace()
    tz.to_end()
    rooms.array[entities.array[cur_entity].room_id].note = tz.to_str()
}

dat str_what_name = "what name"
dat str_name_too_long = "name too long\n"

func action_set_room_name(cur_entity, tz tokenizer) {
    tz.next()

    if tz.is_empty() {
        print(str_what_name)
        return
    }

    if tz.len() > max_name_len {
        print(str_name_too_long)
        return
    }

    rooms.array[entities.array[cur_entity].room_id].name = tz.to_name()
}

dat str_new_entity_created = "new entity created\n"

func action_new_entity(cur_entity, tz tokenizer) {
    tz.next()

    if tz.is_empty() {
        print(str_what_name)
        return
    }

    var name = tz.to_name()

    var room_id = entities.array[cur_entity].room_id

    var entity_id = entities.add(name, room_id)

    var discarded = rooms.array[room_id].entities.add(entity_id)

    print(str_new_entity_created)
}

dat str_new_object_created = "new object created\n"

func action_new_object(cur_entity, tz tokenizer) {
    tz.next()

    if tz.is_empty() {
        print(str_what_name)
        return
    }

    var name = tz.to_name()

    var object_id = objects.add(name)

    var discarded = entities.array[cur_entity].objects.add(object_id)

    print(str_new_object_created)
}

dat str_u_have = "u have: "
dat str_u_have_nothing = "u have nothing\n"

func action_inventory(cur_entity, tz tokenizer) {
    var len = entities.array[cur_entity].objects.len
    if  len == 0 {
        print(str_u_have_nothing)
        return
    }

    var first_printed = false

    foo entities.array[cur_entity].objects.array, len {

        if not first_printed {
            print(str_u_have)
            first_printed = true
        } else {
            print(str_comma)
        }

        objects.array[e].name.print()
    }

    print(str_nl)
}

dat str_drop_what = "drop what\n"
dat str_not_carrying = "u do not have that\n"
dat str_dropped = "dropped "

func action_drop(cur_entity, tz tokenizer) {
    tz.next()

    if tz.is_empty() {
        print(str_drop_what)
        return
    }

    # find object in inventory
    var len = entities.array[cur_entity].objects.len
    var found_ix = len
    foo entities.array[cur_entity].objects.array, len {
        if tz.is_name(objects.array[e].name) {
            found_ix = i
            break
        }
    }

    if found_ix == len {
        print(str_not_carrying)
        return
    }

    # move object from inventory to room
    var object_id = entities.array[cur_entity].objects.array[found_ix]
    var room_id = entities.array[cur_entity].room_id
    var discarded = rooms.array[room_id].objects.add(object_id)
    entities.array[cur_entity].objects.delete_index(found_ix)

    print(str_dropped)
    tz.print()
    print(str_nl)
}

dat str_give_what = "give what\n"
dat str_give_to_whom = "give to whom\n"
dat str_nobody_here = "nobody like that here\n"
dat str_gave = "gave "

func action_give(cur_entity, tz tokenizer) {
    tz.next()

    if tz.is_empty() {
        print(str_give_what)
        return
    }

    # find object in inventory
    var len = entities.array[cur_entity].objects.len
    var found_ix = len
    foo entities.array[cur_entity].objects.array, len {
        if tz.is_name(objects.array[e].name) {
            found_ix = i
            break
        }
    }

    if found_ix == len {
        print(str_not_carrying)
        return
    }

    var object_id = entities.array[cur_entity].objects.array[found_ix]
    var object_name = objects.array[object_id].name

    tz.next()

    if tz.is_empty() {
        print(str_give_to_whom)
        return
    }

    # find other entity in the same room
    var room_id = entities.array[cur_entity].room_id
    var room_entities_len = rooms.array[room_id].entities.len
    var to_entity = room_entities_len
    foo rooms.array[room_id].entities.array, room_entities_len {
        if e == cur_entity continue
        if tz.is_name(entities.array[e].name) {
            to_entity = e
            break
        }
    }

    if to_entity == room_entities_len {
        print(str_nobody_here)
        return
    }

    # move object between inventories
    var discarded = entities.array[to_entity].objects.add(object_id)
    entities.array[cur_entity].objects.delete_index(found_ix)

    print(str_gave)
    object_name.print()
    print(str_nl)
}

dat str_help = "\
  help: this message\n\
  go to: go <exit>\n\
  inventory: i\n\
  create new object: on <name>\n\
  drop object: d <object>\n\
  give object: g <object> <entity>\n\
  new room: rn <to exit> <from exit>\n\
  set room name: rnm <text>\n\
  set room description: rd <text>\n\
  set room note: rnt <text>\n\
  new entity: en <name>\n\
"

func action_help(entity_id, tz tokenizer) {
    print(str_help)
}

dat str_action_help = "help"
dat str_action_go = "go"
dat str_action_inventory = "i"
dat str_action_new_object = "on"
dat str_action_drop = "d"
dat str_action_give = "g"
dat str_action_new_room = "rn"
dat str_action_set_room_name = "rnm"
dat str_action_set_room_description = "rd"
dat str_action_set_room_note = "rnt"
dat str_action_new_entity = "en"

func parse_input(cur_entity, tz tokenizer) {
    tz.first()

    if tz.is_str(str_action_go) {
        action_go(cur_entity, tz)

    } else if tz.is_str(str_action_new_room) {
        action_new_room(cur_entity, tz)

    } else if tz.is_str(str_action_set_room_description) {
        action_set_room_description(cur_entity, tz)

    } else if tz.is_str(str_action_set_room_note) {
        action_set_room_note(cur_entity, tz)

    } else if tz.is_str(str_action_set_room_name) {
        action_set_room_name(cur_entity, tz)

    } else if tz.is_str(str_action_new_entity) {
        action_new_entity(cur_entity, tz)

    } else if tz.is_str(str_action_new_object) {
        action_new_object(cur_entity, tz)

    } else if tz.is_str(str_action_inventory) {
        action_inventory(cur_entity, tz)

    } else if tz.is_str(str_action_drop) {
        action_drop(cur_entity, tz)

    } else if tz.is_str(str_action_give) {
        action_give(cur_entity, tz)

    } else if tz.is_str(str_action_help) {
        action_help(cur_entity, tz)

    } else {
        print(str_not_understood)
    }
}

func main() {
    print(str_hello)

    var tz = tokenizer{}
    var cur_entity = 0
    loop {
        if cur_entity == entities.len {
            cur_entity = 0
        }
        print(str_nl)
        rooms.array[entities.array[cur_entity].room_id].print(cur_entity)
        entities.array[cur_entity].name.print()
        print(str_prompt)
        tz.input()
        print(str_nl)
        parse_input(cur_entity, tz)
        cur_entity = cur_entity + 1
    }
}

