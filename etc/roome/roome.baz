dat  str_hello = "\nwelcome to adventure #6\n    type 'help'\n"
dat     str_uc = "u c "
dat  str_exits = "exits: "
dat str_prompt = " > "
dat     str_nl = "\n"
dat  str_comma = ", "
dat  str_erase = "\b \b"

dat str_not_understood = "not understood"

dat flag = "\n\nFLAG\n\n"

func print(s i8[]) {
    write(1, s)
}

type str {
    data i8[127],
    len i8,
}

func str.print() {
    write(1, self.data, self.len)
}

func str.input() {
    # the uart does not echo, so each byte is written back as it is read
    var nbytes = 0
    loop {
        if nbytes == array_length(self.data) break
        if read(0, self.data, 1, nbytes) == 0 break
        if self.data[nbytes] == '\x7f' {
            if nbytes > 0 {
                nbytes = nbytes - 1
                write(1, str_erase)
            }
            continue
        }
        write(1, self.data, 1, nbytes)
        if self.data[nbytes] == '\n' break
        nbytes = nbytes + 1
    }
    self.len = i8(nbytes)
}

const name_len = 16
const id_list_len = 32
const room_objects_len = 64
const room_entities_len = 32
const room_links_len = 8
const link_names_len = 1024
const rooms_len = 128
const entities_len = 32

type id_list {
    ids i16[id_list_len],
    len i16
}

type name {
    data i8[name_len],
    len i8,
}

func name.print() {
    write(1, self.data, self.len)
}

dat link_names = name[link_names_len]{
    { "none", 4 } 
}
dat link_names_len = i16(1)

type link {
    link_name_id i16,
    to i16,
}

type room {
    name name,
    description str,
    note str,
    entities id_list,
    links link[room_links_len],
    links_len i16,
    objects i16[room_objects_len],
    objects_len i16,
}
dat rooms = room[rooms_len]{
    { 
        { "roome", 5 },
        { },
        { "todo: find an exit", 18 },
        { { 0 }, 1 },
        { {0, 1} }, 1
    } 
}
dat rooms_len = i16(1)

type entity {
    name name,
    room_id i16,
    messages str[16],
}
dat entities = entity[entities_len]{
    { { "me", 2 }, 0 }
}
dat entities_len = 1

func entity.print() {
    write(1, self.name.data, self.name.len)
}

dat str_u_r_in = "u r in "
func room.print() {
    if self.name.len != 0 {
        print(str_u_r_in)
        self.name.print()
        print(str_nl)
    }
    if self.description.len != 0 {
        self.description.print()
        print(str_nl)
    }
    if(self.entities.len != 0) {
        print(str_uc)
        var i = i16(0)
        loop {
            if self.entities.len == i break
            entities[self.entities.ids[i]].print()
            print(str_nl)
            i = i + 1
        }
    }
    if(self.links_len != 0) {
        print(str_exits)
        var i = i8(0)
        loop {
            if self.links_len == i break
            if i != 0 print(str_comma)
            link_names[self.links[i].link_name_id].print()
            i = i + 1
        }
        print(str_nl)
    }
    if self.note.len != 0 {
        self.note.print()
        print(str_nl)
    }
}

type tokenizer {
    str str,
    start i16,
    end i16,
}

func tokenizer.input() {
    self.start = 0
    self.end = 0
    self.str.input()
}

func tokenizer.skip_whitespace() {
    self.start = self.end
    loop {
        if self.start >= self.str.len {
            self.end = self.start
            return
        }
        if self.str.data[self.start] != ' ' break
        self.start = self.start + 1
    }
    self.end = self.start
}

func tokenizer.first() {
    self.skip_whitespace()
    self.end = self.start
    loop {
        if self.end >= self.str.len break
        if self.str.data[self.end] == ' ' break
        self.end = self.end + 1
    }
}

func tokenizer.next() {
    self.skip_whitespace()
    self.end = self.start
    loop {
        if self.end >= self.str.len break
        if self.str.data[self.end] == ' ' break
        self.end = self.end + 1
    }
}

func tokenizer.len() res {
    res = self.end - self.start
}

func tokenizer.print() {
    write(1, self.str.data, self.len(), self.start)
}

func tokenizer.is_str(str i8[]) res bool {
    res = self.len() == array_length(str) and
          arrays_equal(str, self.str.data[self.start], array_length(str))
}

func tokenizer.is_name(nm name) res bool {
    res = self.len() == nm.len and
          arrays_equal(nm.data, self.str.data[self.start], nm.len)
}

func tokenizer.is_empty() res bool {
    res = self.start == self.end
}

func tokenizer.copy_to_name(dst name) {
    dst.len = i8(self.len())
    array_copy(self.str.data[self.start], dst.data, dst.len)
}

func tokenizer.copy_to_str(dst str) {
    dst.len = i8(self.len())
    array_copy(self.str.data[self.start], dst.data, dst.len)
}

func tokenizer.to_end() {
    self.start = self.end
    self.end = self.str.len
}

dat str_went_to = "went to "
dat str_go_where = "go where\n"
dat str_no_such_exit = "cannot go there\n"
dat str_home = "home"

func action_go(cur_entity, tz tokenizer) {
    tz.next()
    if tz.is_empty() {
        print(str_go_where)
        return
    }

    if tz.is_str(str_home) {
        exit(0)
    }

    # find link
    var i = 0
    var room_id = entities[cur_entity].room_id
    var links_len = rooms[room_id].links_len
    loop {
        if i == links_len break
        var link_name_id = rooms[room_id].links[i].link_name_id
        if tz.is_name(link_names[link_name_id]) break
        i = i + 1
    }

    if i == links_len {
        print(str_no_such_exit)
        return
    }

    # move entity
    entities[cur_entity].room_id = rooms[room_id].links[i].to

    print(str_went_to)
    tz.print()
    print(str_nl)
}

func find_link_name_or_make(tz tokenizer) res i16 {
    var i = i16(0)
    loop {
        if i == link_names_len break
        if tz.is_name(link_names[i]) break
        i = i + 1
    }

    if i != link_names_len {
        res = i
        return
    }

    tz.copy_to_name(link_names[link_names_len])

    res = link_names_len

    link_names_len = link_names_len + 1
}

dat str_what_exit_name_to = "what is exit name to new room\n"
dat str_what_exit_name_back = "what is exit name back to this room\n"

func action_new_room(cur_entity, tz tokenizer) {
    tz.next()

    if tz.is_empty() {
        print(str_what_exit_name_to)
        return
    }

    var cur_room_id = entities[cur_entity].room_id 

    var cur_room_next_link_id = rooms[cur_room_id].links_len

    var link_name_id = find_link_name_or_make(tz)

    tz.next()

    if tz.is_empty() {
        print(str_what_exit_name_back)
        return
    }

    var link_name_back_id = find_link_name_or_make(tz)

    # link to next room
    rooms[cur_room_id].links[cur_room_next_link_id] = { 
        link_name_id,
        rooms_len
    }
    rooms[cur_room_id].links_len = cur_room_next_link_id + 1

    # link back to this from from the new room
    rooms[rooms_len].links[0] = { 
        link_name_back_id,
        cur_room_id
    }
    rooms[rooms_len].links_len = 1

    # increase number of rooms
    rooms_len = rooms_len + 1
}

func str_action_set_room_description(cur_entity, tz tokenizer) {
    tz.skip_whitespace()
    tz.to_end()
    tz.copy_to_str(rooms[entities[cur_entity].room_id].description)
}

dat str_action_go = "go"
dat str_action_new_room = "rn"
dat str_action_set_room_description = "rd"

func parse_input(cur_entity, tz tokenizer) {
    tz.first()

    if tz.is_str(str_action_go) {
        action_go(cur_entity, tz)

    } else if tz.is_str(str_action_new_room) {
        action_new_room(cur_entity, tz)

    } else if tz.is_str(str_action_set_room_description) {
        str_action_set_room_description(cur_entity, tz)

    } else {
        print(str_not_understood)
        print(str_nl)
    }
}

func main() {
    print(str_hello)

    var tz = tokenizer{}
    var cur_entity = 0
    loop {
        if cur_entity == entities_len {
            cur_entity = 0
        }
        print(str_nl)
        rooms[entities[cur_entity].room_id].print()
        entities[cur_entity].name.print()
        print(str_prompt)
        tz.input()
        print(str_nl)
        parse_input(cur_entity, tz)
    }
}

