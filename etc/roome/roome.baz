dat flag = "\n\nFLAG\n\n"

func assert(code, ok bool) { if not ok exit(code) }

# all output goes through the printer
# silenced while the creation script runs
type printer {
    silenced bool,
}

dat out = printer{}

func mut printer.set_silenced(silenced bool) {
    self.silenced = silenced
}

func printer.print_at(s i8[], count, start) {
    if self.silenced return

    write(1, s, count, start)
}

func printer.print(s i8[], count) {
    self.print_at(s, count, 0)
}

func printer.print_all(s i8[]) {
    self.print(s, array_length(s))
}

func printer.println() {
    self.print_all(str_nl)
}

func printer.println_all(s i8[]) {
    self.print_all(s)
    self.println()
}

type str {
    array i8[127],
    len,
}

func str.print() {
    out.print(self.array, self.len)
}

func mut str.add(s i8[]) {
    array_copy(s, self.array[self.len], array_length(s))
    self.len = self.len + array_length(s)
}

func mut str.input() {
    # the uart does not echo, so each byte is written back as it is read
    var nbytes = 0
    loop {
        if nbytes == array_length(self.array) break
        if read(0, self.array, 1, nbytes) == 0 break
        if self.array[nbytes] == '\x7f' {
            if nbytes > 0 {
                nbytes = nbytes - 1
                out.print_all(str_erase)
            }
            continue
        }
        out.print_at(self.array, 1, nbytes)
        if self.array[nbytes] == '\n' break
        nbytes = nbytes + 1
    }
    self.len = nbytes
}

let max_name_len = 16
let max_id_list_len = 32
let max_room_objects_len = 64
let max_room_entities_len = 32
let max_room_links_len = 8
let max_link_names_len = 1024
let max_rooms_len = 128
let max_entities_len = 32
let max_objects_len = 1024
let max_entity_messages_len = 16

type id_list {
    array[max_id_list_len],
    len,
}

func mut id_list.delete_index(ix) {
    # array copy it away
    array_copy(
        self.array[ix + 1],
        self.array[ix],
        self.len - ix - 1
    )

    # set new len
    self.len = self.len - 1
}

func mut id_list.delete_element(id) {
    var found_ix = self.len
    foo self.array, self.len {
        if e == id {
            found_ix = i
            break
        }
    }

    if found_ix == self.len return

    self.delete_index(found_ix)
}

func mut id_list.add(ix) res { 
    self.array[self.len] = ix
    res = self.len
    self.len = self.len + 1
}

type name {
    array i8[max_name_len],
    len,
}

func name.print() {
    out.print(self.array, self.len)
}

func name.equals(nm name) res bool {
    if self.len != nm.len {
        res = false
        return
    }

    res = arrays_equal(self.array, nm.array, self.len)
}

func mut str.add_name(nm name) {
    array_copy(nm.array, self.array[self.len], nm.len)
    self.len = self.len + nm.len
}

dat str_told_u = " told u "
dat str_said = " said "
dat str_space = " "

let message_told = 0
let message_said = 1
let message_event = 2

type message {
    from,
    kind,
    text str,
}

type messages {
    array message[max_entity_messages_len],
    len,
}

func mut messages.add(from, kind, text str) {
    self.array[self.len] = { from, kind, text }
    self.len = self.len + 1
}

type entity {
    name name,
    room_id,
    objects id_list,
    messages messages,
}

func entity.print() {
    out.print(self.name.array, self.name.len)
}

type entities {
    array entity[max_entities_len],
    len,
}

# the bare entity, the creation script makes the rest
dat entities = entities{
    { # array begin
        { { "u", 1 }, 0 }  # entity[0]
    }, # array end
    1 # len
}

func message.print() {
    entities.array[self.from].name.print()
    if self.kind == message_said {
        out.print_all(str_said)
    }
    if self.kind == message_told {
        out.print_all(str_told_u)
    }
    if self.kind == message_event {
        out.print_all(str_space)
    }
    self.text.print()
}

func mut entity.print_messages() {
    foo self.messages.array, self.messages.len {
        e.print()
        out.println()
    }

    self.messages.len = 0
}

func mut entities.add(nm name, room_id) entity_id {
    self.array[self.len] = { nm, room_id } 
    entity_id = self.len
    self.len = self.len + 1
}

type link_names {
    array name[max_link_names_len],
    len
}

dat link_names = link_names{}

type link {
    link_name_id,
    to,
}

type object {
    name name,
}

type objects {
    array object[max_objects_len],
    len,
}

func mut objects.add(name name) object_id {
    self.array[self.len] = { name }
    object_id = self.len
    self.len = self.len + 1
}

dat objects = objects{}

type room {
    name name,
    description str,
    note str,
    entities id_list,
    links link[max_room_links_len],
    links_len,
    objects id_list,
}

dat str_u_r_in = "u r in "

func room.print(cur_entity) {
    if self.name.len != 0 {
        out.print_all(str_u_r_in)
        self.name.print()
        out.println()
    }
    if self.description.len != 0 {
        self.description.print()
        out.println()
    }
    var first_elem_printed = false
    foo self.entities.array, self.entities.len {
        if e == cur_entity continue
        if not first_elem_printed {
            out.print_all(str_uc)
        } else {
            out.print_all(str_comma)
        }
        entities.array[e].print()
        first_elem_printed = true
    }
    foo self.objects.array, self.objects.len {
        if not first_elem_printed {
            out.print_all(str_uc)
        } else {
            out.print_all(str_comma)
        }
        objects.array[e].name.print()
        first_elem_printed = true
    }
    if first_elem_printed {
        out.println()
    }
    if(self.links_len != 0) {
        out.print_all(str_exits)
        foo self.links, self.links_len {
            if i != 0 out.print_all(str_comma)
            link_names.array[e.link_name_id].print()
        }
        out.println()
    }
    if self.note.len != 0 {
        self.note.print()
        out.println()
    }
}

func mut room.remove_entity(id) {
    # find entity
    var found_ix = self.entities.len
    let name = entities.array[id].name
    foo self.entities.array, self.entities.len {
        if entities.array[e].name.equals(name) {
            found_ix = i
            break
        }
    }

    # check program error
    assert(1, found_ix != self.entities.len)

    self.entities.delete_index(found_ix)
}

type rooms {
    array room[max_rooms_len],
    len,
}

# the bare room, the creation script makes the rest
dat rooms = rooms{
    { # array
        { # room[0]
            { }, # name
            { }, # description
            { }, # note
            { { 0 }, 1 } # entities id_list
        }
    },
    1 # len
}

type tokenizer {
    str str,
    start,
    end,
}

func mut tokenizer.reset() {
    self.start = 0
    self.end = 0
}

func mut tokenizer.input() {
    self.start = 0
    self.end = 0
    self.str.input()
}

func mut tokenizer.set_line(script i8[], line_start, count) {
    self.start = 0
    self.end = 0
    array_copy(script[line_start], self.str.array, count)
    self.str.len = count
}

func mut tokenizer.skip_whitespace() {
    self.start = self.end
    loop {
        if self.start >= self.str.len {
            self.end = self.start
            return
        }
        if self.str.array[self.start] != ' ' break
        self.start = self.start + 1
    }
    self.end = self.start
}

func mut tokenizer.first() {
    self.skip_whitespace()
    self.end = self.start
    loop {
        if self.end >= self.str.len break
        if self.str.array[self.end] == ' ' break
        self.end = self.end + 1
    }
}

func mut tokenizer.next() {
    self.skip_whitespace()
    self.end = self.start
    loop {
        if self.end >= self.str.len break
        if self.str.array[self.end] == ' ' break
        self.end = self.end + 1
    }
}

func tokenizer.len() res {
    res = self.end - self.start
}

func tokenizer.print() {
    out.print_at(self.str.array, self.len(), self.start)
}

func tokenizer.is_str(str i8[]) res bool {
    res = self.len() == array_length(str) and
          arrays_equal(str, self.str.array[self.start], array_length(str))
}

func tokenizer.is_name(nm name) res bool {
    res = self.len() == nm.len and
          arrays_equal(nm.array, self.str.array[self.start], nm.len)
}

func tokenizer.is_empty() res bool {
    res = self.start == self.end
}

func tokenizer.to_name() dst name {
    dst.len = self.len()
    dst.array = {}
    array_copy(self.str.array[self.start], dst.array, dst.len)
}

func tokenizer.to_str() res str {
    res.len = self.len()
    res.array = {}
    array_copy(self.str.array[self.start], res.array, res.len)
}

func mut tokenizer.to_end() {
    self.start = self.end
    self.end = self.str.len
}

func notify_room(room_id, from, kind, text str) {
    let room_entities_len = rooms.array[room_id].entities.len
    foo rooms.array[room_id].entities.array, room_entities_len {
        if e == from continue

        if entities.array[e].messages.len == max_entity_messages_len continue

        entities.array[e].messages.add(from, kind, text)
    }
}

dat str_went_to = "went to "
dat str_go_where = "go where\n"
dat str_no_such_exit = "cannot go there\n"
dat str_home = "home"
dat str_arrived_from = "arrived from "

func action_go(eid, tz mut tokenizer) {
    tz.next()
    if tz.is_empty() {
        out.print_all(str_go_where)
        return
    }

    if tz.is_str(str_home) exit(0)

    # find link
    let cur_room_id = entities.array[eid].room_id

    let links_len = rooms.array[cur_room_id].links_len
    var found_ix = links_len
    foo rooms.array[cur_room_id].links, links_len {
        if tz.is_name(link_names.array[e.link_name_id]) {
            found_ix = i
            break
        }
    }

    if found_ix == links_len {
        out.print_all(str_no_such_exit)
        return
    }

    # move entity
    let to_room_id = rooms.array[cur_room_id].links[found_ix].to
    entities.array[eid].room_id = to_room_id 

    let discarded = rooms.array[to_room_id].entities.add(eid)
    rooms.array[cur_room_id].entities.delete_element(eid)

    out.print_all(str_went_to)
    tz.print()
    out.println()

    # the ones left behind see it
    var went_text = str{}
    went_text.add(str_went_to)
    went_text.add_name(
        link_names.array[
            rooms.array[cur_room_id].links[found_ix].link_name_id
        ]
    )

    notify_room(cur_room_id, eid, message_event, went_text)

    let to_links_len = rooms.array[to_room_id].links_len
    var to_found_ix = to_links_len
    foo rooms.array[to_room_id].links, to_links_len {
        if e.to == cur_room_id {
            to_found_ix = i
            break
        }
    }

    # missing link back is program error
    assert(2, to_found_ix != to_links_len)

    var arrived_text = str{}
    arrived_text.add(str_arrived_from)
    arrived_text.add_name(
        link_names.array[
            rooms.array[to_room_id].links[to_found_ix].link_name_id
        ]
    )

    notify_room(to_room_id, eid, message_event, arrived_text)
}

func find_link_name_or_make(tz tokenizer) res {
    res = link_names.len
    foo link_names.array, link_names.len {
        if tz.is_name(e) {
            res = i
            break
        }
    }

    if res != link_names.len return

    let name = tz.to_name()
    link_names.array[link_names.len] = name

    res = link_names.len

    link_names.len = link_names.len + 1
}

dat str_what_exit_name_to = "what is exit name to new room\n"
dat str_what_exit_name_back = "what is exit name back to this room\n"
dat str_new_room_created = "new room created\n"

func action_new_room(eid, tz mut tokenizer) {
    tz.next()

    if tz.is_empty() {
        out.print_all(str_what_exit_name_to)
        return
    }

    let cur_room_id = entities.array[eid].room_id 

    let cur_room_next_link_id = rooms.array[cur_room_id].links_len

    let link_name_id = find_link_name_or_make(tz)

    tz.next()

    if tz.is_empty() {
        out.print_all(str_what_exit_name_back)
        return
    }

    let link_name_back_id = find_link_name_or_make(tz)

    # link to next room
    rooms.array[cur_room_id].links[cur_room_next_link_id] = { 
        link_name_id,
        rooms.len
    }
    rooms.array[cur_room_id].links_len = cur_room_next_link_id + 1

    # link back to this from from the new room
    rooms.array[rooms.len].links[0] = { 
        link_name_back_id,
        cur_room_id
    }
    rooms.array[rooms.len].links_len = 1

    # increase number of rooms
    rooms.len = rooms.len + 1

    out.print_all(str_new_room_created)
}

dat str_new_room_description = "new room description\n"

func action_set_room_description(eid, tz mut tokenizer) {
    tz.skip_whitespace()
    tz.to_end()
    let new_description = tz.to_str()
    rooms.array[entities.array[eid].room_id].description = new_description

    out.print_all(str_new_room_description)
}

func action_set_room_note(eid, tz mut tokenizer) {
    tz.skip_whitespace()
    tz.to_end()
    let new_note = tz.to_str()
    rooms.array[entities.array[eid].room_id].note = new_note
}

dat str_what_name = "what name\n"
dat str_name_too_long = "name too long\n"
dat str_new_room_name = "new room name\n"

func action_set_room_name(eid, tz mut tokenizer) {
    tz.next()

    if tz.is_empty() {
        out.print_all(str_what_name)
        return
    }

    if tz.len() > max_name_len {
        out.print_all(str_name_too_long)
        return
    }

    let new_name = tz.to_name()
    rooms.array[entities.array[eid].room_id].name = new_name

    out.print_all(str_new_room_name)
}

dat str_new_entity_created = "new entity created\n"

func action_new_entity(eid, tz mut tokenizer) {
    tz.next()

    if tz.is_empty() {
        out.print_all(str_what_name)
        return
    }

    let name = tz.to_name()

    let room_id = entities.array[eid].room_id

    let entity_id = entities.add(name, room_id)

    let discarded = rooms.array[room_id].entities.add(entity_id)

    out.print_all(str_new_entity_created)
}

dat str_new_object_created = "new object created\n"

func action_new_object(eid, tz mut tokenizer) {
    tz.next()

    if tz.is_empty() {
        out.print_all(str_what_name)
        return
    }

    let name = tz.to_name()

    let object_id = objects.add(name)

    let discarded = entities.array[eid].objects.add(object_id)

    out.print_all(str_new_object_created)
}

dat str_u_have = "u have: "
dat str_u_have_nothing = "u have nothing\n"

func action_inventory(eid, tz tokenizer) {
    let len = entities.array[eid].objects.len
    if  len == 0 {
        out.print_all(str_u_have_nothing)
        return
    }

    var first_printed = false

    foo entities.array[eid].objects.array, len {

        if not first_printed {
            out.print_all(str_u_have)
            first_printed = true
        } else {
            out.print_all(str_comma)
        }

        objects.array[e].name.print()
    }

    out.println()
}

dat str_drop_what = "drop what\n"
dat str_not_carrying = "u do not have that\n"
dat str_dropped = "dropped "

func action_drop(eid, tz mut tokenizer) {
    tz.next()

    if tz.is_empty() {
        out.print_all(str_drop_what)
        return
    }

    # find object in inventory
    let len = entities.array[eid].objects.len
    var found_ix = len
    foo entities.array[eid].objects.array, len {
        if tz.is_name(objects.array[e].name) {
            found_ix = i
            break
        }
    }

    if found_ix == len {
        out.print_all(str_not_carrying)
        return
    }

    # move object from inventory to room
    let object_id = entities.array[eid].objects.array[found_ix]
    let room_id = entities.array[eid].room_id
    let discarded = rooms.array[room_id].objects.add(object_id)
    entities.array[eid].objects.delete_index(found_ix)

    out.print_all(str_dropped)
    tz.print()
    out.println()
}

dat str_give_what = "give what\n"
dat str_give_to_whom = "give to whom\n"
dat str_is_not_here = " is not here\n"
dat str_gave = "gave "
dat str_to = " to "

func action_give(eid, tz mut tokenizer) {
    tz.next()

    if tz.is_empty() {
        out.print_all(str_give_what)
        return
    }

    # find object in inventory
    let len = entities.array[eid].objects.len
    var found_ix = len
    foo entities.array[eid].objects.array, len {
        if tz.is_name(objects.array[e].name) {
            found_ix = i
            break
        }
    }

    if found_ix == len {
        out.print_all(str_not_carrying)
        return
    }

    let object_id = entities.array[eid].objects.array[found_ix]
    let object_name = objects.array[object_id].name

    tz.next()

    if tz.is_empty() {
        out.print_all(str_give_to_whom)
        return
    }

    # find other entity in the same room
    let room_id = entities.array[eid].room_id
    let room_entities_len = rooms.array[room_id].entities.len
    var to_entity = room_entities_len
    foo rooms.array[room_id].entities.array, room_entities_len {
        if e == eid continue
        if tz.is_name(entities.array[e].name) {
            to_entity = e
            break
        }
    }

    if to_entity == room_entities_len {
        tz.print()
        out.print_all(str_is_not_here)
        return
    }

    # move object between inventories
    let discarded = entities.array[to_entity].objects.add(object_id)
    entities.array[eid].objects.delete_index(found_ix)

    out.print_all(str_gave)
    object_name.print()
    out.print_all(str_to)
    entities.array[to_entity].name.print()
    out.println()

    var gave_text = str{}
    gave_text.add(str_gave)
    gave_text.add_name(entities.array[to_entity].name)
    gave_text.add(str_space)
    gave_text.add_name(object_name)

    notify_room(room_id, eid, message_event, gave_text)
}

dat str_tell_whom = "tell whom\n"
dat str_tell_what = "tell what\n"
dat str_does_not_exist = " does not exist\n"
dat str_has_too_many_messages = " has too many messages\n"

func action_tell(eid, tz mut tokenizer) {
    tz.next()

    if tz.is_empty() {
        out.print_all(str_tell_whom)
        return
    }

    # find entity anywhere
    var to_entity = entities.len
    foo entities.array, entities.len {
        if tz.is_name(e.name) {
            to_entity = i
            break
        }
    }

    if to_entity == entities.len {
        tz.print()
        out.print_all(str_does_not_exist)
        return
    }

    if entities.array[to_entity].messages.len == max_entity_messages_len {
        tz.print()
        out.print_all(str_has_too_many_messages)
        return
    }

    # the message is the rest of the line
    tz.skip_whitespace()
    tz.to_end()

    if tz.is_empty() {
        out.print_all(str_tell_what)
        return
    }

    let text = tz.to_str()

    entities.array[to_entity].messages.add(eid, message_told, text)
}

dat str_say_what = "say what\n"

func action_say(eid, tz mut tokenizer) {
    # the text is the rest of the line
    tz.skip_whitespace()
    tz.to_end()

    if tz.is_empty() {
        out.print_all(str_say_what)
        return
    }

    let text = tz.to_str()

    notify_room(entities.array[eid].room_id, eid,
                    message_said, text)
}

dat str_help = "\
  help: this message\n\
  go to: go <exit>\n\
  inventory: i\n\
  create new object: on <name>\n\
  drop object: d <object>\n\
  give object: g <object> <entity>\n\
  tell entity: t <entity> <message>\n\
  say to room: s <text>\n\
  new room: rn <to exit> <from exit>\n\
  set room name: rnm <text>\n\
  set room description: rd <text>\n\
  set room note: rnt <text>\n\
  new entity: en <name>\n\
"

func action_help(eid, tz tokenizer) {
    out.print_all(str_help)
}

dat str_action_help = "help"
dat str_action_go = "go"
dat str_action_inventory = "i"
dat str_action_new_object = "on"
dat str_action_drop = "d"
dat str_action_give = "g"
dat str_action_tell = "t"
dat str_action_say = "s"
dat str_action_new_room = "rn"
dat str_action_set_room_name = "rnm"
dat str_action_set_room_description = "rd"
dat str_action_set_room_note = "rnt"
dat str_action_new_entity = "en"

# note: `noinline` because it unfolds into a lot of code and called from 2
#       locations
func noinline parse_input(ceid, tz mut tokenizer) {
    tz.first()

    # a copy, the parameter may point into a global the actions also name
    var eid = ceid

    if tz.is_str(str_action_go) {
        action_go(eid, tz)

    } else if tz.is_str(str_action_new_room) {
        action_new_room(eid, tz)

    } else if tz.is_str(str_action_set_room_description) {
        action_set_room_description(eid, tz)

    } else if tz.is_str(str_action_set_room_note) {
        action_set_room_note(eid, tz)

    } else if tz.is_str(str_action_set_room_name) {
        action_set_room_name(eid, tz)

    } else if tz.is_str(str_action_new_entity) {
        action_new_entity(eid, tz)

    } else if tz.is_str(str_action_new_object) {
        action_new_object(eid, tz)

    } else if tz.is_str(str_action_inventory) {
        action_inventory(eid, tz)

    } else if tz.is_str(str_action_drop) {
        action_drop(eid, tz)

    } else if tz.is_str(str_action_give) {
        action_give(eid, tz)

    } else if tz.is_str(str_action_tell) {
        action_tell(eid, tz)

    } else if tz.is_str(str_action_say) {
        action_say(eid, tz)

    } else if tz.is_str(str_action_help) {
        action_help(eid, tz)

    } else {
        out.print_all(str_not_understood)
    }
}

dat str_creation_script = "\
rnm roome\n\
rnt todo: find an exit\n\
rn none roome\n\
go none\n\
rnm office\n\
go roome\n\
en me\n"

# runs the lines of the script as the bare entity, a line ends with '\n'
func run_creation_script(tz mut tokenizer) {
    var line_start = 0
    var eid = 0
    foo str_creation_script {
        if e == '\n' {
            tz.set_line(str_creation_script, line_start, i - line_start)
            parse_input(eid, tz)
            line_start = i + 1
        }
    }
}

func main() {
    var tz = tokenizer{}

    out.set_silenced(true)
    run_creation_script(tz)
    out.set_silenced(false)

    # messages made by the script are not for the players
    foo entities.array, entities.len {
        e.messages.len = 0
    }

    out.print_all(str_ascii_art)
    out.print_all(str_hello)

    var eid = 0
    loop {
        if eid == entities.len {
            eid = 0
        }
        entities.array[eid].print_messages()
        out.println()
        rooms.array[entities.array[eid].room_id].print(eid)
        entities.array[eid].name.print()
        out.print_all(str_prompt)
        tz.input()
        out.println()
        parse_input(eid, tz)
        out.print_all(str_turn_end)
        eid = eid + 1
    }
}

