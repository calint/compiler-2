dat  str_hello = "\nwelcome to adventure #6\n    type 'help'\n"
dat     str_uc = "u c "
dat  str_exits = "exits: "
dat str_prompt = " > "
dat     str_nl = "\n"
dat  str_erase = "\b \b"

dat str_not_understood = "not understood"

dat str_action_look = "l"
dat str_action_go = "go"

func print(s i8[]) {
    write(1, s)
}

type str {
    data i8[127],
    len i8,
}

func str.print() {
    write(1, self.data, self.len)
}

func str.input() {
    # the uart does not echo, so each byte is written back as it is read
    var nbytes = 0
    loop {
        if nbytes == array_length(self.data) break
        if read(0, self.data, 1, nbytes) == 0 break
        if self.data[nbytes] == '\x7f' {
            if nbytes > 0 {
                nbytes = nbytes - 1
                write(1, str_erase)
            }
            continue
        }
        write(1, self.data, 1, nbytes)
        if self.data[nbytes] == '\n' break
        nbytes = nbytes + 1
    }
    self.len = i8(nbytes)
}

const name_len = 16
const id_list_len = 32
const room_objects_len = 64
const room_entities_len = 32
const room_links_len = 8
const link_names_len = 1024
const rooms_len = 128
const entities_len = 32

type id_list {
    ids i16[id_list_len],
    len i16
}

type name {
    text i8[name_len],
    len i8,
}

func name.print() {
    write(1, self.text, self.len)
}

dat link_names = name[link_names_len]{
    { "none", 4 } 
}

type link {
    link_name_id i16,
    from i16,
    to i16,
}

type room {
    name name,
    description str,
    note str,
    entities id_list,
    links link[room_links_len],
    links_len i8,
    objects i16[room_objects_len],
}

type entity {
    name name,
    room_id i16,
    messages str[16],
}

func entity.print() {
    write(1, self.name.text, self.name.len)
}

dat rooms = room[rooms_len]{
    { 
        { "roome", 5 },
        { "u r in roome", 12 },
        { "todo: find an exit", 18 },
        { { 0 }, 1 },
        { {0, 0, 0} }, 1
    } 
}

dat entities = entity[entities_len]{
    { { "me", 2 }, 0 }
}

dat entities_len = 1

func room.print() {
    self.description.print()
    print(str_nl)
    if(self.entities.len > 0) {
        print(str_uc)
        var i = i16(0)
        loop {
            if self.entities.len == i break
            entities[self.entities.ids[i]].print()
            print(str_nl)
            i = i + 1
        }
    }
    if(self.links_len > 0) {
        print(str_exits)
        var i = i8(0)
        loop {
            if self.links_len == i break
            link_names[self.links[i].link_name_id].print()
            print(str_nl)
            i = i + 1
        }
    }
    if self.note.len != 0 {
        self.note.print()
        print(str_nl)
    }
}

dat str_went = "went to "
dat str_which_link = "go where\n"

func next_token(inp str, s, e) {
    # leading whitespace
    loop {
        if s >= inp.len {
            e = s
            return
        }
        if inp.data[s] != ' ' break
        s = s + 1
    }
    # exit name
    e = s
    loop {
        if e >= inp.len break
        if inp.data[e] == ' ' break
        e = e + 1
    }
}

func action_go(cur_entity, inp str, inp_ix) {
    var s = inp_ix
    var e = s
    next_token(inp, s, e)
    if s == e {
        print(str_which_link)
        return
    }

    var to = str{}
    to.len = i8(e - s)
    array_copy(inp.data[s], to.data, to.len)
    print(str_went)
    to.print()
    print(str_nl)
}

func parse_input(cur_entity, inp str) {
    if i(inp.len) >= array_length(str_action_go) and
       arrays_equal(str_action_go, inp.data, array_length(str_action_go)) {
        action_go(cur_entity, inp, array_length(str_action_go))
        return
    }

    print(str_not_understood)
    print(str_nl)
}

func main() {
    print(str_hello)

    var inp = str{}
    var cur_entity = 0
    loop {
        if cur_entity == entities_len {
            cur_entity = 0
        }
        print(str_nl)
        rooms[entities[cur_entity].room_id].print()
        entities[cur_entity].name.print()
        print(str_prompt)
        inp.input()
        parse_input(cur_entity, inp)
    }
}

