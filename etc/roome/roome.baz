func assert(code, ok bool) { if not ok exit(code) }

# all output goes through the printer
# silenced while the creation script runs
type printer {
    silenced bool,
}

dat out = printer

func mut printer.set_silenced(silenced bool) {
    self.silenced = silenced
}

func printer.print_at(s i8[], count, start) {
    if self.silenced return

    write(1, s, count, start)
}

func printer.print(s i8[], count) {
    self.print_at(s, count, 0)
}

func printer.print_all(s i8[]) {
    self.print(s, array_length(s))
}

func printer.println() {
    self.print_all(str_nl)
}

func printer.println_all(s i8[]) {
    self.print_all(s)
    self.println()
}

type text<capacity> {
    array i8[capacity],
    len,
}

type str = text<127>

func text.print() {
    out.print(self.array, self.len)
}

func mut text.add(s i8[]) {
    array_copy(s, self.array[self.len], array_length(s))
    self.len = self.len + array_length(s)
}

# appends a text of any capacity
func mut text.append<T type>(s T) {
    array_copy(s.array, self.array[self.len], s.len)
    self.len = self.len + s.len
}

func mut text.input() {
    # the uart does not echo, so each byte is written back as it is read
    var nbytes = 0
    loop {
        if nbytes == array_length(self.array) break
        if read(0, self.array, 1, nbytes) == 0 break
        if self.array[nbytes] == '\x7f' {
            if nbytes > 0 {
                nbytes = nbytes - 1
                out.print_all(str_erase)
            }
            continue
        }
        out.print_at(self.array, 1, nbytes)
        if self.array[nbytes] == '\n' break
        nbytes = nbytes + 1
    }
    self.len = nbytes
}

# compares with a text of any capacity
func text.equals<T type>(other T) res bool {
    if self.len != other.len {
        res = false
        return
    }

    res = arrays_equal(self.array, other.array, self.len)
}

let max_name_len = 16
let max_id_list_len = 32
let max_room_objects_len = 64
let max_room_entities_len = 32
let max_room_links_len = 8
let max_link_names_len = 1024
let max_rooms_len = 128
let max_entities_len = 32
let max_objects_len = 1024
let max_entity_messages_len = 16

# a list of up to 'capacity' items
type list<T type, capacity> {
    array T[capacity],
    len,
}

func list.is_full() res bool {
    res = self.len == array_length(self.array)
}

# makes room for an item and returns its index, the caller writes the item in
# place
func mut list.reserve() res {
    res = self.len
    self.len = self.len + 1
}

func mut list.push(item T) res {
    res = self.reserve()
    self.array[res] = item
}

func mut list.delete_index(ix) {
    # array copy it away
    array_copy(
        self.array[ix + 1],
        self.array[ix],
        self.len - ix - 1
    )

    # set new len
    self.len = self.len - 1
}

# the index of the first item equal to 'item' or the length
func list.index_of(item T) res {
    res = self.len
    foo self.array, self.len {
        if e == item {
            res = i
            break
        }
    }
}

# the index of the first item named by the token or the length
func list.index_of_name<K type>(tz K) res {
    res = self.len
    foo self.array, self.len {
        if tz.is(e.name) {
            res = i
            break
        }
    }
}

# the index of 'item', it is added when not found
func mut list.find_or_add(item T) res {
    res = self.index_of(item)
    if res != self.len return

    res = self.push(item)
}

func mut list.delete_item(item T) {
    let found_ix = self.index_of(item)
    if found_ix == self.len return

    self.delete_index(found_ix)
}

type id_list = list<int, max_id_list_len>

type name = text<max_name_len>

dat str_told_u = " told u "
dat str_said = " said "
dat str_space = " "

let message_told = 0
let message_said = 1
let message_event = 2

