# a tour of baz from the easiest to the most difficult concepts
# each concept is introduced in code followed by a comment explaining it

# comments start with '#' and last until the end of the line

# a file starts with 'include "other.baz"' lines to add the definitions of
# another file, relative to the including file, each file once
# the tutorial is one file so it has none

func assert(ok bool) { if not ok exit(1) }
# a helper used throughout the tutorial, functions and booleans are explained
# further down
# 'exit' is a built-in function that ends the program with an exit code

#
# constants and variables
#

let size = 4
# a constant at the top level is visible to every function and can be used
# where a size is needed
# top level constants come before any 'dat', used by 'arrays' below

func constants_and_variables() {
    let answer = 42
    # a constant is known at compile time and takes no storage

    var count = 1
    # a variable always has an initial value and gets its type from it
    # here the default type: 'i64' on x86_64 and 'i32' on rv32i

    count = count + answer
    assert(count == 43)
    # '=' assigns and '==' compares, statements need no semicolons

    let doubled = count * 2
    assert(doubled == 86)
    # a 'let' with a non-constant initializer is a variable that is read-only
    # after its initializer, 'doubled = 0' is a compile error
}

#
# literals
#

func literals() {
    var dec = 255
    var hex = 0xff
    var bin = 0b11111111
    assert(dec == hex and hex == bin)
    # hex values start with '0x' and binary values with '0b'

    var letter = 'a'
    assert(letter == 97)
    # a character literal is the byte value of the character, escapes such as
    # '\n' and '\x41' are supported

    var neg = -dec
    var inv = ~dec
    assert(neg == -255)
    assert(inv == -256)
    # unary '-' negates and '~' inverts the bits
}

#
# arithmetic
#

func arithmetic() {
    var a = 7
    var b = 2
    assert(a + b == 9)
    assert(a - b == 5)
    assert(a * b == 14)
    assert(a / b == 3)
    assert(a % b == 1)
    assert(-a / b == -3)
    assert(-a % b == -1)
    # division truncates toward zero, the remainder has the sign of the
    # dividend

    assert(a & 3 == 3)
    assert(a | 8 == 15)
    assert(a ^ 1 == 6)
    assert(a << 2 == 28)
    assert(-a >> 1 == -4)
    # bitwise and, or, xor and shifts, '>>' keeps the sign

    var one = 1
    assert(one + 2 * 3 == 7)
    assert(one + one << 3 == 9)
    assert(b * one | 2 == 6)
    assert(6 & 3 ^ one == 2)
    # precedence from lowest to highest: '+ -', '* / %', '|', '&', '^',
    # '<< >>'
    # unlike c, bitwise operations and shifts bind tighter than arithmetic
    # and '^' binds tighter than '&'

    assert((one + one) << 3 == 16)
    # parentheses group as usual
}

#
# sized types and conversions
#

func sized_types() {
    var small = i8(100)
    # built-in integer types are 'i64', 'i32', 'i16' and 'i8', a conversion
    # such as 'i8(100)' gives the variable that type
    # 'i64' is not available on rv32i

    small = i8(small + small)
    assert(small == -56)
    # the arithmetic of a conversion wraps at the width of the type, without
    # the conversion the sum is an overflow, see the checks below

    var wide = int(small)
    assert(wide == -56)
    # 'int(x)' converts to the default type, 'int' also names that type, e.g.
    # 'int[4]' and 'list<int, 8>'

#   small = wide
#   compile error because the value might not fit, narrowing must be
#   acknowledged with a conversion

    small = i8(wide + 1)
    assert(small == -55)
}

#
# booleans
#

func booleans() {
    var yes = true
    var no = false
    # the built-in type 'bool' has the values 'true' and 'false'

    var x = 1
    var less = x < 2
    assert(less)
    # comparisons '==', '!=', '<', '<=', '>' and '>=' give a 'bool'

    assert(yes and not no)
    assert(no or yes)
    assert(not (no or x > 2))
    # 'and', 'or' and 'not' combine booleans, evaluation stops as soon as the
    # result is known
}

#
# control flow
#

func control_flow() {
    var n = 3
    var kind = 0
    if n < 0 {
        kind = -1
    } else if n == 0 {
        kind = 0
    } else {
        kind = 1
    }
    assert(kind == 1)
    # conditions need no parentheses

    if n == 3 kind = 2
    assert(kind == 2)
    # a single statement needs no braces

    var sum = 0
    var i = 0
    loop {
        i = i + 1
        if i == 3 continue
        if i > 5 break
        sum = sum + i
    }
    assert(sum == 1 + 2 + 4 + 5)
    # 'loop' repeats until 'break', 'continue' starts the next iteration
    # there is no 'while' or 'for'

    if sum != 12 exit(3)
    # 'exit' ends the program at once with an exit code, 0 is success, the
    # 'assert' helper exits with 1 and here the code is never reached
}

#
# scopes
#

func scopes() {
    let level = 1
    var x = 1
    {
        let level = 2
        var x = 2
        assert(level == 2 and x == 2)
    }
    assert(level == 1 and x == 1)
    # a block opens a new scope, its constants and variables shadow outer ones
    # and end with the block
}

#
# arrays
#

func arrays() {
    var zeros = i32[size]
    assert(zeros[3] == 0)
    # an array names the element type and size, elements start zeroed
    # 'i32[4]{}' is the same

    var primes = []{2, 3, 5, 7}
    assert(array_length(primes) == 4)
    # '[]' takes the size from the elements, no type name means the default
    # type and 'array_length' is a built-in function

    var ix = 2
    primes[ix] = primes[ix + 1] * 2
    assert(primes[2] == 14)
    # indexes start at 0 and can be expressions

    let table = []{10, 20, 30}
    assert(table[1] == 20)
    # a read-only 'let' array and the fields of a read-only 'let' instance
    # are read-only too, 'table[1] = 0' is a compile error

    var sum = 0
    foo primes {
        sum = sum + e
    }
    assert(sum == 2 + 3 + 14 + 7)
    # 'foo' iterates over an array injecting:
    #   'e': the current element
    #   'i': the index starting at 0
    #   'n': the constant size of the array

    foo primes {
        e = i + n
    }
    assert(primes[0] == 4 and primes[3] == 7)
    # 'e' refers to the element, assigning it changes the array

    var part = 1
    part = part + 2
    var partial = 0
    foo primes, part {
        partial = partial + e
    }
    assert(partial == 4 + 5 + 6)
    # 'foo' with a count visits only the first elements, 'n' is still the
    # size of the array

    var copy = primes
    copy[0] = 0
    assert(primes[0] == 4)
    # initializing from an array copies it

    array_copy(primes[1], copy, 3)
    assert(copy[0] == 5 and copy[2] == 7 and copy[3] == 7)
    # built-in 'array_copy' copies from, to and number of elements, an
    # indexed array starts at that element

    assert(arrays_equal(primes[1], copy, 3))
    assert(primes != copy)
    # built-in 'arrays_equal' compares a number of elements and '=='
    # compares arrays of the same size
}

#
# strings and data
#

dat greeting = "hello from the tutorial\n"
# 'dat' is data stored in the program image and initialized before variables
# like 'var' the initializer gives the type, a string is an 'i8' array of its
# size

func strings() {
    write(1, greeting)
    # 'write' is a built-in function writing an array to a file descriptor,
    # here 1 is standard output
    # it has 2 more optional arguments: count and start index

    var word = "baz\n"
    assert(array_length(word) == 4 and word[0] == 'b')
    # a string initializes an 'i8' array of its size

    write(1, word, 2, 1)
    write(1, word, 1, 3)
    # writes 2 elements from index 1, then the newline at index 3
}

func reading() {
    var line = i8[16]
    var got = read(0, line, 16)
    write(1, line, got)
    # 'read' fills an array from a file descriptor, here 0 is standard input
    # it returns the number of elements read, 0 at the end of the input, and
    # takes the same optional count and start index as 'write'
    # 'main' does not call this function because it waits for input
}

#
# functions
#

func twice(v) res {
    res = v * 2
}
# the result 'res' is named and assigned like a variable
# argument and result types are the default type when omitted

func increment(v mut) {
    v = v + 1
}
# arguments are read-only, 'mut' after an argument name allows writing it
# and 'v = v + 1' changes the variable of the caller

func sign(v) res {
    res = 0
    if v == 0 return
    res = 1
    if v < 0 res = -1
}
# 'return' leaves early, the result must be assigned on every path or it is a
# compile error

func low_byte(v i32) res i8 {
    res = i8(v & 0xff)
}
# types follow the argument and result names

func first(arr i32[]) res i32 {
    res = arr[0]
}
# an array argument has '[]' after the type, only '[]' for the default type,
# its size comes from the caller

func sum_of(a, b) res {
    res = a + b
}
# an argument without 'mut' is read-only, 'a = 0' is a compile error and the
# caller can pass a 'let' to it

func total(values[]) res {
    res = 0
    foo values {
        res = res + e
    }
}
# an array argument without 'mut' cannot be written either, not even through
# 'e'

func functions() {
    var x = 3
    assert(twice(x) == 6)
    assert(twice(x + 1) == 8)

    increment(x)
    assert(x == 4)

    assert(sign(-x) == -1)
    assert(sign(0) == 0)

    var w = i32(0x1234)
    assert(low_byte(w) == 0x34)

    var arr = i32[]{9, 8}
    assert(first(arr) == 9)
    # functions are inlined at every call by default

    let fixed = 5
    assert(sum_of(x, fixed) == 9)
    let items = []{1, 2, 3}
    assert(total(items) == 6)
}

#
# user types
#

type point {x, y}
# a user type with 2 fields of the default type

type pixel {
    pos point,
    color i32,
    tags i8[2], # trailing comma allowed
}
# fields have optional types and can be arrays or other user types

func user_types() {
    var p = point{1, 2}
    assert(p.x == 1 and p.y == 2)
    # an instance literal names the type and lists the fields in order

    var origin = point
    assert(origin.x == 0 and origin.y == 0)
    # without a literal all fields are zeroed, 'point{}' is the same, and
    # missing fields of a literal are zeroed too

    var px = pixel{{3, 4}, 0xff0000}
    px.pos.x = 5
    px.tags[1] = 'z'
    assert(px.pos.x == 5 and px.color == 0xff0000 and px.tags[1] == 'z')
    # nested literals need no type name, fields are accessed with '.'

    var q = px.pos
    q.y = 4
    assert(q == px.pos)
    # copying an instance copies all fields, '==' and '!=' compare instances of
    # the same type

    var points = point[3]{{1, 2}, {3, 4}}
    points[2] = points[0]
    assert(points[2].y == 2)
    # arrays of instances work like other arrays
}

#
# methods
#

func mut point.move(dx, dy) {
    self.x = self.x + dx
    self.y = self.y + dy
}
# a method on a user type is called as 'p.move(1, 2)', 'self' refers to 'p'
# 'mut' before the type allows the method to write 'self', without it 'self' is
# read-only like an argument and the method also works on a 'let' receiver

func point.sum() res {
    res = self.x + self.y
}

func mut point.x(x) {
    self.x = x
}
# a method can have the name of a field, 'p.x(1)' calls the method and 'p.x'
# is the field

func methods() {
    var p = point{1, 2}
    p.move(10, 20)
    assert(p.x == 11 and p.y == 22)
    assert(p.sum() == 33)

    p.x(0)
    assert(p.x == 0)
}

#
# constructors
#

func point.at(x, y) self {
    self.x = x
    self.y = y
}
# a constructor has the result 'self' and must assign every field
# it is called on the type: 'point.at(1, 2)'

func constructors() {
    var p = point.at(-1, -2)
    assert(p.x == -1 and p.y == -2)
    # the variable gets the type of the constructor

    var pts = point[2]
    pts[1] = point.at(3, 4)
    assert(pts[1].y == 4)
    # the constructor builds its result in the destination
}

#
# arrays in user types
#

type stack {
    items[4],
    count,
}
# a field can be an array, its size is part of the type

func mut stack.push(v) {
    self.items[self.count] = v
    self.count = self.count + 1
}

func mut stack.pop() res {
    self.count = self.count - 1
    res = self.items[self.count]
}

func sum_all(arr[]) res {
    res = 0
    foo arr {
        res = res + e
    }
}

func arrays_in_types() {
    var s = stack{{7, 8}, 2}
    assert(s.items[1] == 8 and s.items[2] == 0 and s.count == 2)
    # a nested array literal initializes the field, missing elements are
    # zeroed

    s.push(9)
    assert(s.count == 3 and s.items[2] == 9)
    assert(s.pop() == 9)
    assert(s.count == 2)
    # methods index the field with run-time values

    assert(array_length(s.items) == 4)
    assert(sum_all(s.items) == 7 + 8 + 9)
    # the field works like any array with built-ins, 'foo' and array
    # arguments, 'pop' left 9 in the array

    var copy = s
    copy.items[0] = 0
    assert(s.items[0] == 7 and s != copy)
    # copying an instance copies its array fields
}

#
# data
#

dat powers = []{1, 2, 4, 8}
dat calls = 0
dat home = point{10, 20}
dat history = stack{{1, 2}, 2}
# data can have any type declared before it, including arrays and user types
# with array fields
# 'dat' is only allowed at the top level and the initializer is made of
# constants, 'dat twice = calls' is a compile error

func count_call() {
    calls = calls + 1
}
# data is global, any function can read and assign it

func data() {
    assert(powers[3] == 8)
    powers[0] = 3
    assert(powers[0] == 3)
    # data is indexed and assigned like variables

    count_call()
    count_call()
    assert(calls == 2)
    # the value is kept between calls, unlike variables of functions that are
    # initialized at every call

    home.move(1, 1)
    assert(home.x == 11 and home.y == 21)
    history.push(3)
    assert(history.items[2] == 3 and history.count == 3)
    # methods work on data of user types

    var local = powers
    local[1] = 0
    assert(powers[1] == 2)
    # initializing a variable from data copies it
}

#
# non-inlined functions
#

func noinline factorial(n) res {
    res = 1
    if n <= 1 return

    var m = n - 1
    var partial = factorial(m)
    res = n * partial
}
# 'noinline' emits the function once and calls it, which allows recursion
# a call follows the same typing and aliasing rules as an inlined call

func noinline add_all(a []) res {
    res = 0
    foo a {
        res = res + e
    }
}
# an array argument is allowed, a body is emitted for each array size that is
# called

func noinline sum(p point) res {
    res = p.x + p.y
}

func non_inlined() {
    var n = 5
    var f = factorial(n)
    assert(f == 120)

    var arr = []{ 1, 2, 3 }
    assert(add_all(arr) == 6)
    assert(factorial(n - 2) == 6)
    assert(sum(point{1, 2}) == 3)
    assert(sum({ 3, 4 }) == 7)
    # an argument can be an expression, a constant or a record literal, it is
    # evaluated into a temporary of the parameter's type before the call
    # a function that nothing calls is not emitted

    # '--checks=frame' checks at run time that the frames of non-inlined calls
    # fit in the variable storage
}

#
# generics
#

type buffer<capacity> {
    items i8[capacity],
    count,
}
# a generic type has compile-time parameters in '<...>', 'capacity' is a
# constant of the default type

type small = buffer<4>
type large = buffer<16>
# an alias names an instance, each list of arguments is one type, aliases are
# top level

func mut buffer.add(v) {
    self.items[self.count] = i8(v)
    self.count = self.count + 1
}

func buffer.is_full() res bool {
    res = self.count == capacity
}
# a method is made for every instance and sees its constants

func make<T type>(n) res T {
    res.items = {}
    res.count = n
}
# a generic function has parameters in '<...>' too, 'T type' is a type

func fill<T type>(b mut T) {
    loop {
        if b.is_full() break
        b.add(1)
    }
}

type pair<first type, second type> {
    a first,
    b second,
}
type small_large = pair<small, large>
# a parameter can also be a type, here the types of the fields

func generics() {
    var s = small
    var l = large
    assert(array_length(s.items) == 4 and array_length(l.items) == 16)
    # the capacity is part of the type

    s.add(7)
    assert(s.items[0] == 7 and s.count == 1 and not s.is_full())

    fill<small>(s)
    fill<large>(l)
    assert(s.is_full() and l.is_full() and l.count == 16)
    # a call names the type arguments, 'fill<small>' and 'fill<large>' are
    # two functions

    fill(s)
    assert(s.is_full())
    # the type arguments can be left out when a variable, a field or an
    # element is passed for a parameter declared with the type parameter,
    # 'fill(s)' is 'fill<small>(s)'. a literal, an expression or an array
    # does not tell the type

    var m = make<small>(2)
    assert(m.count == 2)
    # the result type can be a parameter

    m = make(3)
    assert(m.count == 3)
    # a call assigned to a variable of the result type needs no type arguments,
    # 'make(3)' is 'make<small>(3)' here

    var p = small_large
    p.a.add(1)
    p.b.add(2)
    assert(p.a.count == 1 and p.b.items[0] == 2)
    # fields of different instances, a generic type is used through an alias

    # an instance is the definition parsed again with the arguments bound, so
    # an error in a generic shows up at its first use
    # '<' after the name of a generic is the start of the arguments, anywhere
    # else it is a comparison
}

#
# undefined behavior and checks
#

func add_to_zero(v) res {
    res = 0
    res = res + v
}

func checks() {
    var arr = [4]
    var ix = 3
    arr[ix] = 1
    assert(arr[3] == 1)
    # the language has operations without a defined result: an index outside an
    # array, an overflow, a division by zero and more
    # none is checked by default, a check is turned on with '--checks=LIST'
    # and a failed check ends the program with a message and an exit code
    # '--checks=noub' turns on all of them, the list below names each one

    # 'upper' and 'lower': run-time indexes inside the array, 'lower' also
    # catches negative indexes
    # '--checks=upper,lower,line' also reports the source line of the failure
    # a constant index out of bounds is always a compile error

    # 'overflow': signed overflow of '+', '-', '*' and unary '-' at the width
    # of the destination, a constant expression that overflows is a compile
    # error and 'i8(a + b)' still wraps

    # 'division': division or remainder by zero and 'MIN / -1'
    # 'shift': a shift count below zero or not below the width of the type, a
    # constant count is a compile error

    # 'overlap': 'array_copy' whose destination starts inside the source, a
    # copy down the array is allowed

    # 'frame' and 'stack': the frames of 'noinline' calls fit in the variable
    # storage ('--vars') and in the stack of 'rv32i-qemu' and 'rv32i-fpga'
    # ('--stack'), the other targets have an operating system that stops a
    # program that overflows the stack

    var x = 5
    var y = add_to_zero(x)
    assert(y == 5)

#   x = add_to_zero(x)
#   gives 0 because the result 'res' and the argument 'v' refer to the same
#   variable 'x', so 'res = 0' also clears 'v'
#   calls where the result and the arguments may share storage with each
#   other are rejected, '--checks=-alias' turns that check off

    var p = point{1, 2}
    p = point{2, 1}
    assert(p.x == 2 and p.y == 1)

#   p = point{p.y, p.x}
#   compile error because 'p.x' is read after the first field overwrote it
}
# '--checks=noub' enables all checks against undefined behavior, aliasing is
# checked also without it

func main() {
    constants_and_variables()
    literals()
    arithmetic()
    sized_types()
    booleans()
    control_flow()
    scopes()
    arrays()
    strings()
    functions()
    user_types()
    methods()
    constructors()
    arrays_in_types()
    data()
    non_inlined()
    generics()
    checks()
}
# execution starts at 'main' and ends with exit code 0 at the end of it
