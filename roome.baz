dat   hello = "welcome to adventure #6\n    type 'help'\n\nu r in roome\nu c me\nexits: none\ntodo: find an exit\n"
dat prompt1 = "> "
dat prompt2 = "unknown command\n"
dat prompt3 = "hello "
dat     dot = "."
dat      nl = "\n"
dat   erase = "\b \b"
dat   colon = ": "

type str {
    len i8,
    data i8[127]
}

func str.out() {
    write(1, self.data, self.len)
}

func str.in() {
    # the uart does not echo, so each byte is written back as it is read
    var nbytes = 0
    loop {
        if nbytes == array_length(self.data) break
        if read(0, self.data, 1, nbytes) == 0 break
        if self.data[nbytes] == '\x7f' {
            if nbytes > 0 {
                nbytes = nbytes - 1
                write(1, erase)
            }
            continue
        }
        write(1, self.data, 1, nbytes)
        if self.data[nbytes] == '\n' break
        nbytes = nbytes + 1
    }
    self.len = i8(nbytes)
}

func noinline print_num(num) {
    # 19 digits of an i64 plus the sign
    const buf_count = 20

    var buf = i8[buf_count]{}
    var n = num
    var is_negative = false

    # digits are taken from the negative value because the most negative i64
    # has no positive counterpart
    if n < 0 {
        is_negative = true
    }
    if n > 0 {
        n = -n
    }
 
    var i = buf_count
    loop {
        i = i - 1
        buf[i] = i8('0' - n % 10)
        n = n / 10
        if n == 0 break
    }
 
    if is_negative {
        i = i - 1
        buf[i] = '-'
    }
 
    var write_pos = 0
    loop {
        buf[write_pos] = buf[i]
        write_pos = write_pos + 1
        i = i + 1
        if i == buf_count break
    }
 
    write(1, buf, write_pos)
}

func print(s i8[]) {
    write(1, s)
}

func main() {
    var counter = 0
    var nm = str{}
    print(hello)
    loop {
        counter = counter + 1
        print_num(counter)
        print(colon)
        print(prompt1)
        nm.in()
        if nm.len <= 4 {
            print(prompt2)
            continue
        } else {
            print(prompt3)
            nm.out()
            print(dot)
            print(nl)
        }
    }
}

