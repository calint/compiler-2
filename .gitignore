/.cache/
/build/
/baz
# written by make.sh for clangd
/compile_commands.json
*.o
# binaries built by run.sh are named after their source, also the first
# program of the README and its outputs
/prog
/hello
/hello.baz
/hello.s
/hello-without-comments.s
# the image of the last example of './baz --help' and the sd card image the
# README makes with 'truncate'
/image.bin
/sdcard.img
# the outputs of './run.sh etc/NAME.baz'; the codegen listings are tracked
/etc/tutorial
/etc/tutorial.s
/etc/tutorial-without-comments.s
/etc/codegen-inefficiencies
# rv32i images are named after their source and target
*-rv32i*.bin
/diff.baz
lcov.info
*.profraw
*.profdata
a.out
perf.data
perf.data.old
perf-report.txt
# python caches of the lint scripts
__pycache__/
*.py[cod]
# editor swap and backup files, and the backups of 'patch'
*.swp
*.swo
*~
*.orig
*.rej
# the logs of the lint runs, written on every run
/qa/lint/*.log
